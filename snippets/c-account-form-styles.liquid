{%- comment -%}
  Shared look for the account pages (activate account, reset password): same as the
  sign-in redesign (Figma "Log in", node 6746-1730). Classes: c-acct, c-acct__*.
{%- endcomment -%}
<style>
  .c-acct { padding: 24px 16px 40px; font-family: Raleway, sans-serif; color: #000; }
  .c-acct * { box-sizing: border-box; }
  .c-acct__inner { display: flex; flex-direction: column; gap: 12px; max-width: 504px; margin: 0 auto; }
  .c-acct__eyebrow { margin: 0; color: #002c41; font-size: 16px; font-style: italic; line-height: 1.2; }
  .c-acct__title { margin: 0; color: #002c41; font-size: 32px; font-weight: 600; line-height: 1.2; }
  .c-acct__text { margin: 0; font-size: 18px; line-height: 1.3; }
  .c-acct__form { display: flex; flex-direction: column; gap: 12px; }
  .c-acct__field { display: flex; flex-direction: column; gap: 4px; }
  .c-acct__field label { font-size: 14px; line-height: 1.2; }
  .c-acct__field input {
    width: 100%; height: 39px; padding: 0 24px;
    border: 1px solid #707170; border-radius: 44px; background: #fff;
    color: #000; font: 400 14px Raleway, sans-serif;
  }
  .c-acct__field input:focus-visible { outline: 2px solid #0862df; outline-offset: 1px; }
  .c-acct__submit {
    width: 100%; min-height: 39px; margin-top: 4px; padding: 8px 24px; border: 0; border-radius: 44px;
    background: #0862df; color: #f7f7f7;
    font: 700 14px/1.2 Raleway, sans-serif; text-transform: uppercase;
    box-shadow: 0 2px 6px rgba(0, 44, 65, .12); cursor: pointer;
  }
  .c-acct__decline {
    align-self: center; padding: 0; border: 0; background: none; color: #002c41;
    font: 700 12px/1.2 Raleway, sans-serif; text-decoration: underline; text-transform: uppercase; cursor: pointer;
  }
  .c-acct__error { padding: 12px; border-radius: 12px; background: #fdecea; color: #b3261e; font-size: 14px; line-height: 1.3; }
  .c-acct__error ul { margin: 0; padding-left: 18px; }
  @media (min-width: 990px) {
    .c-acct { padding: 64px 24px; }
    .c-acct__title { font-size: 40px; }
    .c-acct__text { font-size: 20px; }
  }
</style>
