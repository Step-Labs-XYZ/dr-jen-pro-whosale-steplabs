{% comment %}
  Snippet: Cart Gift Picker
  Replaces the cart drawer recommendations while the promo code is applied from the side cart.
  Counts qualifying full cases in the cart; below the minimum it shows how many are missing,
  at or above it lists the gift variants to choose from. The chosen gift is added with the
  hidden line property _promo_gift so it can be swapped or removed later.
  Usage: {% render 'c-cart-gift-picker', settings: section.settings, promo_code: promo_code %}
{% endcomment %}

{%- liquid
  assign qualifier_list = settings.promo_qualifier_variant_ids | newline_to_br | replace: '<br />', ',' | strip_newlines | remove: ' ' | prepend: ',' | append: ','
  assign gift_list = settings.promo_gift_variant_ids | newline_to_br | replace: '<br />', ',' | strip_newlines | remove: ' ' | prepend: ',' | append: ','
  assign min_qty = settings.promo_min_qty | default: 2

  assign qualifying_qty = 0
  assign gift_line = nil
  for item in cart.items
    if item.properties['_promo_gift'] != blank
      assign gift_line = item
      continue
    endif
    assign needle = ',' | append: item.variant_id | append: ','
    if qualifier_list contains needle
      assign qualifying_qty = qualifying_qty | plus: item.quantity
    endif
  endfor

  assign missing_qty = min_qty | minus: qualifying_qty
-%}

<div class="c-cart-gift mini-cart__recommendations-inner" data-sl-id="sl-snippet-cart-gift-picker-v1">
  <p class="c-cart-gift__eyebrow">{{ promo_code }} applied</p>

  {%- if missing_qty > 0 -%}
    <p class="c-cart-gift__title">
      {{- settings.promo_locked_title | default: 'Add [count] more full case(s) to unlock your free half case' | replace: '[count]', missing_qty -}}
    </p>

    {%- if gift_line != nil -%}
      <p class="c-cart-gift__warning">
        Your {{ gift_line.variant.title | escape }} half case is not free yet. Add {{ missing_qty }} more full case(s) or remove it before checkout.
      </p>
    {%- endif -%}

    {%- if settings.promo_shop_url != blank -%}
      <a href="{{ settings.promo_shop_url }}" class="c-cart-gift__link">Shop full cases</a>
    {%- endif -%}
  {%- else -%}
    <p class="c-cart-gift__title">{{ settings.promo_choose_title | default: 'Choose your free half case' }}</p>

    <ul class="c-cart-gift__list" role="list">
      {%- for gift_product in settings.promo_gift_products -%}
        {%- for variant in gift_product.variants -%}
          {%- assign needle = ',' | append: variant.id | append: ',' -%}
          {%- unless gift_list contains needle and variant.available -%}
            {%- continue -%}
          {%- endunless -%}

          {%- liquid
            assign is_selected = false
            if gift_line != nil and gift_line.variant_id == variant.id
              assign is_selected = true
            endif
            assign gift_image = variant.image | default: gift_product.featured_image
          -%}

          <li class="c-cart-gift__option{% if is_selected %} is-selected{% endif %}">
            <button
              type="button"
              class="c-cart-gift__button"
              data-promo-gift-variant="{{ variant.id }}"
              data-promo-code="{{ promo_code | escape }}"
              {% if gift_line != nil %}data-promo-gift-line="{{ gift_line.key }}"{% endif %}
              aria-pressed="{{ is_selected }}"
              {% if is_selected %}disabled{% endif %}
            >
              {%- if gift_image != blank -%}
                {{
                  gift_image
                  | image_url: width: 288
                  | image_tag: class: 'c-cart-gift__image', loading: 'lazy', widths: '176, 192, 288', sizes: '(min-width: 1000px) 96px, 88px', alt: ''
                }}
              {%- endif -%}

              <span class="c-cart-gift__info">
                <span class="c-cart-gift__name">{{ gift_product.title }}</span>
                <span class="c-cart-gift__variant">{{ variant.title }}</span>
                <span class="c-cart-gift__price">
                  <s>{{ variant.price | money }}</s>
                  {{ 'cart.general.free' | t }}
                </span>
              </span>

              <span class="c-cart-gift__cta">{% if is_selected %}Selected{% else %}Choose{% endif %}</span>
            </button>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .c-cart-gift {
    text-align: left;
    font-family: Raleway, sans-serif;
    color: #002c41;
  }

  .c-cart-gift__eyebrow {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    color: #0862df;
  }

  .c-cart-gift__title {
    margin: 0 0 12px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .c-cart-gift__warning {
    margin: 0 0 12px;
    padding: 8px 10px;
    border-radius: 6px;
    background: #fff4e5;
    font-size: 12px;
    line-height: 1.3;
  }

  .c-cart-gift__link {
    font-size: 13px;
    font-weight: 700;
    text-decoration: underline;
    color: #002c41;
  }

  .c-cart-gift__list {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .c-cart-gift__option {
    display: flex;
  }

  .c-cart-gift__button {
    display: grid;
    grid-template-columns: 72px 1fr;
    grid-template-areas: 'image info' 'image cta';
    column-gap: 10px;
    row-gap: 4px;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 8px;
    border: 1px solid #d6dde1;
    border-radius: 8px;
    background: #ffffff;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .c-cart-gift__button:hover,
  .c-cart-gift__button:focus-visible {
    border-color: #002c41;
  }

  .c-cart-gift__button[disabled] {
    cursor: default;
  }

  .c-cart-gift__button.is-loading {
    opacity: 0.5;
    pointer-events: none;
  }

  .c-cart-gift__option.is-selected .c-cart-gift__button {
    border: 2px solid #0862df;
  }

  .c-cart-gift__image {
    grid-area: image;
    width: 72px;
    height: 72px;
    object-fit: contain;
  }

  .c-cart-gift__info {
    grid-area: info;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .c-cart-gift__name {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow-wrap: anywhere;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
  }

  .c-cart-gift__variant,
  .c-cart-gift__price {
    font-size: 12px;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .c-cart-gift__price {
    font-weight: 700;
    color: #0862df;
  }

  .c-cart-gift__price s {
    margin-right: 4px;
    font-weight: 400;
    color: #6b7c85;
  }

  .c-cart-gift__cta {
    grid-area: cta;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: underline;
  }

  .c-cart-gift__option.is-selected .c-cart-gift__cta {
    text-decoration: none;
    color: #0862df;
  }

  /* Desktop: the theme panel is 240px with a 40px gutter each side, which left the card at 160px.
     Widen the panel and drop the gutters so the card uses the full width. */
  @media screen and (min-width: 1000px) {
    .mini-cart .mini-cart__recommendations {
      width: 300px;
    }

    .c-cart-gift.mini-cart__recommendations-inner {
      margin-left: 0;
      margin-right: 0;
      padding-left: 16px;
      padding-right: 16px;
    }

    .c-cart-gift__button {
      grid-template-columns: 96px 1fr;
      min-height: 112px;
      padding: 10px;
    }

    .c-cart-gift__image {
      width: 96px;
      height: 96px;
    }
  }

  @media screen and (max-width: 999px) {
    .c-cart-gift__list {
      flex-direction: row;
      align-items: stretch;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: 0;
      padding-bottom: 4px;
    }

    /* Fixed track so every card keeps the same width and height while swiping. */
    .c-cart-gift__option {
      flex: 0 0 240px;
      width: 240px;
      max-width: 240px;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .c-cart-gift__button {
      grid-template-columns: 88px 1fr;
      min-height: 104px;
    }

    .c-cart-gift__image {
      width: 88px;
      height: 88px;
    }
  }
{% endstylesheet %}
