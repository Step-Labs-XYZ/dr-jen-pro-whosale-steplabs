{% comment %}
  ╔══════════════════════════════════════════════════════════════╗
  ║  C - Comparison Cards (Commodity vs Premium Nano-HA)        ║
  ║  Desktop: 2 cards separadas, Card 2 con elevación/sombra.    ║
  ║  Mobile: Card unificada de 2 columnas que solapa arriba.     ║
  ╚══════════════════════════════════════════════════════════════╝
{% endcomment %}

{%- assign section_id = section.id -%}
{%- assign s = section.settings -%}

<div id="c-comparison-{{ section_id }}" class="c-comparison-section">
  <div class="c-comparison__container">
    
    {%- if s.section_title != blank or s.section_copy != blank -%}
      <div class="c-comparison__header-content">
        {%- if s.section_title != blank -%}
          <h2 class="c-comparison__main-title">{{ s.section_title }}</h2>
        {%- endif -%}
        {%- if s.section_copy != blank -%}
          <div class="c-comparison__main-copy">{{ s.section_copy }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="c-comparison__wrapper">
      
      <!-- TARJETA 1: COMMODITY (IZQUIERDA) -->
      <div class="c-comparison__card c-comparison__card--standard">
        <!-- Encabezado Tarjeta 1 -->
        <div class="c-comparison__card-header c-comparison__card-header--1">
          {%- if s.card1_title != blank -%}
            <h3 class="c-comparison__card-title">{{ s.card1_title }}</h3>
          {%- endif -%}
        </div>

        <!-- Imagen Tarjeta 1 -->
        <div class="c-comparison__card-media">
          {%- if s.card1_image != blank -%}
            {{ s.card1_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'c-comparison__img', alt: s.card1_title }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'c-comparison__placeholder' }}
          {%- endif -%}
        </div>

        <!-- Lista de Puntos Tarjeta 1 -->
        <div class="c-comparison__card-body c-comparison__card-body--1">
          <ul class="c-comparison__list">
            {%- if s.card1_item1_text != blank -%}
              <li class="c-comparison__item">
                {%- if s.card1_item1_svg != blank -%}
                  <span class="c-comparison__icon">
                    {{ s.card1_item1_svg }}
                  </span>
                {%- endif -%}
                <span class="c-comparison__item-text {% if s.card1_item1_bold %}c-comparison__item-text--bold{% endif %}">
                  {{ s.card1_item1_text }}
                </span>
              </li>
            {%- endif -%}

            {%- if s.card1_item2_text != blank -%}
              <li class="c-comparison__item">
                {%- if s.card1_item2_svg != blank -%}
                  <span class="c-comparison__icon">
                    {{ s.card1_item2_svg }}
                  </span>
                {%- endif -%}
                <span class="c-comparison__item-text {% if s.card1_item2_bold %}c-comparison__item-text--bold{% endif %}">
                  {{ s.card1_item2_text }}
                </span>
              </li>
            {%- endif -%}

            {%- if s.card1_item3_text != blank -%}
              <li class="c-comparison__item">
                {%- if s.card1_item3_svg != blank -%}
                  <span class="c-comparison__icon">
                    {{ s.card1_item3_svg }}
                  </span>
                {%- endif -%}
                <span class="c-comparison__item-text {% if s.card1_item3_bold %}c-comparison__item-text--bold{% endif %}">
                  {{ s.card1_item3_text }}
                </span>
              </li>
            {%- endif -%}
          </ul>
        </div>
      </div>

      <!-- TARJETA 2: DR. JEN'S PREMIUM (DERECHA - SHADOW DESTACADO) -->
      <div class="c-comparison__card c-comparison__card--highlight">
        <!-- Encabezado Tarjeta 2 -->
        <div class="c-comparison__card-header c-comparison__card-header--2">
          {%- if s.card2_title != blank -%}
            <h3 class="c-comparison__card-title">{{ s.card2_title }}</h3>
          {%- endif -%}
        </div>

        <!-- Imagen Tarjeta 2 -->
        <div class="c-comparison__card-media">
          {%- if s.card2_image != blank -%}
            {{ s.card2_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'c-comparison__img', alt: s.card2_title }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'c-comparison__placeholder' }}
          {%- endif -%}
        </div>

        <!-- Lista de Puntos Tarjeta 2 -->
        <div class="c-comparison__card-body c-comparison__card-body--2">
          <ul class="c-comparison__list">
            {%- if s.card2_item1_text != blank -%}
              <li class="c-comparison__item">
                {%- if s.card2_item1_svg != blank -%}
                  <span class="c-comparison__icon">
                    {{ s.card2_item1_svg }}
                  </span>
                {%- endif -%}
                <span class="c-comparison__item-text {% if s.card2_item1_bold %}c-comparison__item-text--bold{% endif %}">
                  {{ s.card2_item1_text }}
                </span>
              </li>
            {%- endif -%}

            {%- if s.card2_item2_text != blank -%}
              <li class="c-comparison__item">
                {%- if s.card2_item2_svg != blank -%}
                  <span class="c-comparison__icon">
                    {{ s.card2_item2_svg }}
                  </span>
                {%- endif -%}
                <span class="c-comparison__item-text {% if s.card2_item2_bold %}c-comparison__item-text--bold{% endif %}">
                  {{ s.card2_item2_text }}
                </span>
              </li>
            {%- endif -%}

            {%- if s.card2_item3_text != blank -%}
              <li class="c-comparison__item">
                {%- if s.card2_item3_svg != blank -%}
                  <span class="c-comparison__icon">
                    {{ s.card2_item3_svg }}
                  </span>
                {%- endif -%}
                <span class="c-comparison__item-text {% if s.card2_item3_bold %}c-comparison__item-text--bold{% endif %}">
                  {{ s.card2_item3_text }}
                </span>
              </li>
            {%- endif -%}
          </ul>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  #c-comparison-{{ section_id }} {
    background-color: {{ s.bg_color }};
    padding-top: {{ s.padding_top_desktop }}px;
    padding-bottom: {{ s.padding_bottom_desktop }}px;
    font-family: 'Raleway', sans-serif;
    position: relative;
    z-index: 2;
  }

  svg{
    fill:transparent !important;
  }

  #c-comparison-{{ section_id }} .c-comparison__container {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
    box-sizing: border-box;
  }

  /* Estilos del encabezado principal de la sección */
  #c-comparison-{{ section_id }} .c-comparison__header-content {
    text-align: {{ s.section_header_alignment }};
    margin-bottom: {{ s.section_header_margin_bottom }}px;
  }

  #c-comparison-{{ section_id }} .c-comparison__main-title {
    font-family: 'Raleway', sans-serif;
    margin: 0 0 12px 0;
    color: {{ s.section_title_color }};
    font-weight: 700;
    font-size: {{ s.section_title_size_desktop }}px;
    line-height: 1.2;
  }

  #c-comparison-{{ section_id }} .c-comparison__main-copy {
    font-family: 'Raleway', sans-serif;
    margin: 0;
    color: {{ s.section_copy_color }};
    font-weight: 400;
    font-size: {{ s.section_copy_size_desktop }}px;
    line-height: 1.5;
  }

  #c-comparison-{{ section_id }} .c-comparison__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: stretch;
  }

  /* --- Tarjeta Base (Desktop) --- */
  #c-comparison-{{ section_id }} .c-comparison__card {
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  /* Tarjeta 1 (Standard / Commodity) */
  #c-comparison-{{ section_id }} .c-comparison__card--standard {
    background-color: {{ s.card1_body_bg }};
  }

  /* Tarjeta 2 (Highlight / Dr. Jen's con SOMBRA DESTACADA) */
  #c-comparison-{{ section_id }} .c-comparison__card--highlight {
    background-color: {{ s.card2_body_bg }};
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.14);
    position: relative;
    z-index: 2;
  }

  /* Encabezados */
  #c-comparison-{{ section_id }} .c-comparison__card-header {
    padding: 18px 24px;
    min-height: 64px;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  #c-comparison-{{ section_id }} .c-comparison__card-header--1 {
    background-color: {{ s.card1_header_bg }};
  }

  #c-comparison-{{ section_id }} .c-comparison__card-header--2 {
    background-color: {{ s.card2_header_bg }};
  }

  #c-comparison-{{ section_id }} .c-comparison__card-title {
    font-family: 'Raleway', sans-serif;
    margin: 0;
    color: #ffffff;
    font-weight: 600;
    font-size: {{ s.header_title_size_desktop }}px;
    line-height: 1.25;
  }

  /* Multimedia / Imagen */
  #c-comparison-{{ section_id }} .c-comparison__card-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #eaeaea;
    overflow: hidden;
  }

  #c-comparison-{{ section_id }} .c-comparison__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #c-comparison-{{ section_id }} .c-comparison__placeholder {
    width: 100%;
    height: 100%;
    background-color: #e2e8f0;
  }

  /* Cuerpo / Lista */
  #c-comparison-{{ section_id }} .c-comparison__card-body {
    padding: 24px 24px 32px 24px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  #c-comparison-{{ section_id }} .c-comparison__card-body--1 {
    background-color: {{ s.card1_body_bg }};
  }

  #c-comparison-{{ section_id }} .c-comparison__card-body--2 {
    background-color: {{ s.card2_body_bg }};
  }

  #c-comparison-{{ section_id }} .c-comparison__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Alineación centrada entre el icono y el texto */
  #c-comparison-{{ section_id }} .c-comparison__item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #c-comparison-{{ section_id }} .c-comparison__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    margin: 0;
  }

  #c-comparison-{{ section_id }} .c-comparison__icon svg {
    display: block;
  }

  #c-comparison-{{ section_id }} .c-comparison__item-text {
    font-family: 'Raleway', sans-serif;
    font-size: {{ s.item_text_size_desktop }}px;
    line-height: 1.35;
    color: {{ s.text_color }};
    font-weight: 400;
    flex-grow: 1;
  }

  /* Estilo y tamaño de fuente para texto en negrita (Desktop) */
  #c-comparison-{{ section_id }} .c-comparison__item-text--bold {
    font-weight: 700;
    font-size: {{ s.item_bold_text_size_desktop }}px;
  }

  /* --- Responsive Mobile --- */
  @media screen and (max-width: 749px) {
    #c-comparison-{{ section_id }} {
      padding-top: {{ s.padding_top_mobile }}px;
      padding-bottom: {{ s.padding_bottom_mobile }}px;
      margin-top: -{{ s.mobile_overlap }}px;
      position: relative;
      z-index: 10;
    }

    #c-comparison-{{ section_id }} .c-comparison__container {
      padding-left: 16px;
      padding-right: 16px;
    }

    #c-comparison-{{ section_id }} .c-comparison__header-content {
      text-align: {{ s.section_header_alignment_mobile }};
    }

    #c-comparison-{{ section_id }} .c-comparison__main-title {
      font-size: {{ s.section_title_size_mobile }}px;
    }

    #c-comparison-{{ section_id }} .c-comparison__main-copy {
      font-size: {{ s.section_copy_size_mobile }}px;
    }

    #c-comparison-{{ section_id }} .c-comparison__wrapper {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.16);
      background-color: #ffffff;
    }

    #c-comparison-{{ section_id }} .c-comparison__card {
      border-radius: 0 !important;
      box-shadow: none !important;
      border: none !important;
    }

    #c-comparison-{{ section_id }} .c-comparison__card-header {
      padding: 14px 12px;
      min-height: 58px;
      align-items: flex-start;
    }

    #c-comparison-{{ section_id }} .c-comparison__card-title {
      font-size: {{ s.header_title_size_mobile }}px;
      line-height: 1.2;
    }

    #c-comparison-{{ section_id }} .c-comparison__card-media {
      aspect-ratio: 1 / 1;
    }

    #c-comparison-{{ section_id }} .c-comparison__card-body {
      padding: 16px 12px 20px 12px;
    }

    #c-comparison-{{ section_id }} .c-comparison__list {
      gap: 14px;
    }

    #c-comparison-{{ section_id }} .c-comparison__item {
      gap: 8px;
      align-items: center;
    }

    #c-comparison-{{ section_id }} .c-comparison__icon {
      margin: 0;
    }

    #c-comparison-{{ section_id }} .c-comparison__item-text {
      font-size: {{ s.item_text_size_mobile }}px;
      line-height: 1.3;
    }

    /* Tamaño de fuente para texto en negrita (Mobile) */
    #c-comparison-{{ section_id }} .c-comparison__item-text--bold {
      font-size: {{ s.item_bold_text_size_mobile }}px;
    }
  }
</style>

{% schema %}
{
  "name": "C - Comparison Cards",
  "tag": "section",
  "class": "c-comparison-cards-section",
  "settings": [
    { "type": "header", "content": "Título y Copy de la Sección" },
    { 
      "type": "text", 
      "id": "section_title", 
      "label": "Título de la Sección", 
      "default": "The Difference is Clear" 
    },
    { 
      "type": "textarea", 
      "id": "section_copy", 
      "label": "Copy / Descripción de la Sección", 
      "default": "Compare standard nano-hydroxyapatite with Dr. Jen's advanced formulation." 
    },
    {
      "type": "select",
      "id": "section_header_alignment",
      "label": "Alineación del Encabezado (Desktop)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "section_header_alignment_mobile",
      "label": "Alineación del Encabezado (Mobile)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    { 
      "type": "range", 
      "id": "section_header_margin_bottom", 
      "label": "Espacio debajo del Encabezado", 
      "min": 10, 
      "max": 80, 
      "step": 2, 
      "default": 32, 
      "unit": "px"
    },
    { "type": "color", "id": "section_title_color", "label": "Color Título Sección", "default": "#1e293b" },
    { "type": "color", "id": "section_copy_color", "label": "Color Copy Sección", "default": "#475569" },
    { "type": "range", "id": "section_title_size_desktop", "label": "Tamaño Título Sección (Desktop)", "min": 20, "max": 48, "step": 1, "default": 32, "unit": "px" },
    { "type": "range", "id": "section_title_size_mobile", "label": "Tamaño Título Sección (Mobile)", "min": 16, "max": 32, "step": 1, "default": 24, "unit": "px" },
    { "type": "range", "id": "section_copy_size_desktop", "label": "Tamaño Copy Sección (Desktop)", "min": 14, "max": 24, "step": 1, "default": 16, "unit": "px" },
    { "type": "range", "id": "section_copy_size_mobile", "label": "Tamaño Copy Sección (Mobile)", "min": 12, "max": 18, "step": 1, "default": 14, "unit": "px" },

    { "type": "header", "content": "Solapamiento Mobile (Superposición)" },
    { 
      "type": "range", 
      "id": "mobile_overlap", 
      "label": "Solapamiento hacia arriba en Mobile", 
      "min": 0, 
      "max": 100, 
      "step": 5, 
      "default": 45, 
      "unit": "px"
    },

    { "type": "header", "content": "Tarjeta 1 — Izquierda (Commodity)" },
    { 
      "type": "text", 
      "id": "card1_title", 
      "label": "Título Tarjeta 1", 
      "default": "Commodity nano-hydroxyapatite" 
    },
    { 
      "type": "color", 
      "id": "card1_header_bg", 
      "label": "Fondo Encabezado Tarjeta 1", 
      "default": "#C05C4D" 
    },
    { 
      "type": "color", 
      "id": "card1_body_bg", 
      "label": "Fondo Cuerpo Tarjeta 1", 
      "default": "#F8F8F8" 
    },
    { 
      "type": "image_picker", 
      "id": "card1_image", 
      "label": "Imagen Tarjeta 1" 
    },
    { "type": "html", "id": "card1_item1_svg", "label": "Punto 1 - SVG Icono" },
    { "type": "text", "id": "card1_item1_text", "label": "Punto 1 - Texto", "default": "Lumpy, rough, and not very clean" },
    { "type": "checkbox", "id": "card1_item1_bold", "label": "Punto 1 - Texto en Negrita", "default": true },
    { "type": "html", "id": "card1_item2_svg", "label": "Punto 2 - SVG Icono" },
    { "type": "text", "id": "card1_item2_text", "label": "Punto 2 - Texto", "default": "Random lumps, bigger particles, and the size jumps around" },
    { "type": "checkbox", "id": "card1_item2_bold", "label": "Punto 2 - Texto en Negrita", "default": false },
    { "type": "html", "id": "card1_item3_svg", "label": "Punto 3 - SVG Icono" },
    { "type": "text", "id": "card1_item3_text", "label": "Punto 3 - Texto", "default": "Rough, chipped surfaces, carries leftovers from how it was made" },
    { "type": "checkbox", "id": "card1_item3_bold", "label": "Punto 3 - Texto en Negrita", "default": false },

    { "type": "header", "content": "Tarjeta 2 — Derecha (Dr. Jen's / Destacada)" },
    { 
      "type": "text", 
      "id": "card2_title", 
      "label": "Título Tarjeta 2", 
      "default": "Dr. Jen’s premium nano-hydroxyapatite" 
    },
    { 
      "type": "color", 
      "id": "card2_header_bg", 
      "label": "Fondo Encabezado Tarjeta 2", 
      "default": "#35BAA4" 
    },
    { 
      "type": "color", 
      "id": "card2_body_bg", 
      "label": "Fondo Cuerpo Tarjeta 2", 
      "default": "#FFFFFF" 
    },
    { 
      "type": "image_picker", 
      "id": "card2_image", 
      "label": "Imagen Tarjeta 2" 
    },
    { "type": "html", "id": "card2_item1_svg", "label": "Punto 1 - SVG Icono" },
    { "type": "text", "id": "card2_item1_text", "label": "Punto 1 - Texto", "default": "Even, smooth, and clean" },
    { "type": "checkbox", "id": "card2_item1_bold", "label": "Punto 1 - Texto en Negrita", "default": true },
    { "type": "html", "id": "card2_item2_svg", "label": "Punto 2 - SVG Icono" },
    { "type": "text", "id": "card2_item2_text", "label": "Punto 2 - Texto", "default": "Uniform rod-shaped crystals, nano-sized for optimal absorption" },
    { "type": "checkbox", "id": "card2_item2_bold", "label": "Punto 2 - Texto en Negrita", "default": false },
    { "type": "html", "id": "card2_item3_svg", "label": "Punto 3 - SVG Icono" },
    { "type": "text", "id": "card2_item3_text", "label": "Punto 3 - Texto", "default": "High biocompatibility. Ultra-high purity" },
    { "type": "checkbox", "id": "card2_item3_bold", "label": "Punto 3 - Texto en Negrita", "default": false },

    { "type": "header", "content": "Tipografía y Colores" },
    { "type": "color", "id": "text_color", "label": "Color del Texto", "default": "#1e293b" },
    { "type": "range", "id": "header_title_size_desktop", "label": "Tamaño Título Header (Desktop)", "min": 14, "max": 24, "step": 1, "default": 17, "unit": "px" },
    { "type": "range", "id": "header_title_size_mobile", "label": "Tamaño Título Header (Mobile)", "min": 11, "max": 18, "step": 1, "default": 13, "unit": "px" },
    { "type": "range", "id": "item_text_size_desktop", "label": "Tamaño Texto Normal (Desktop)", "min": 12, "max": 18, "step": 1, "default": 14, "unit": "px" },
    { "type": "range", "id": "item_bold_text_size_desktop", "label": "Tamaño Texto Negrita (Desktop)", "min": 12, "max": 24, "step": 1, "default": 16, "unit": "px" },
    { "type": "range", "id": "item_text_size_mobile", "label": "Tamaño Texto Normal (Mobile)", "min": 9, "max": 15, "step": 1, "default": 11, "unit": "px" },
    { "type": "range", "id": "item_bold_text_size_mobile", "label": "Tamaño Texto Negrita (Mobile)", "min": 9, "max": 18, "step": 1, "default": 13, "unit": "px" },

    { "type": "header", "content": "Diseño General" },
    { "type": "range", "id": "max_width", "label": "Ancho Máximo Sección", "min": 800, "max": 1400, "step": 20, "default": 1100, "unit": "px" },
    { "type": "color", "id": "bg_color", "label": "Fondo de Sección", "default": "transparent" },
    { "type": "range", "id": "padding_top_desktop", "label": "Padding Superior (Desktop)", "min": 0, "max": 100, "step": 2, "default": 40, "unit": "px" },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Padding Inferior (Desktop)", "min": 0, "max": 100, "step": 2, "default": 64, "unit": "px" },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding Superior (Mobile)", "min": 0, "max": 80, "step": 2, "default": 10, "unit": "px" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding Inferior (Mobile)", "min": 0, "max": 80, "step": 2, "default": 40, "unit": "px" }
  ],
  "presets": [
    {
      "name": "C - Comparison Cards"
    }
  ]
}
{% endschema %}