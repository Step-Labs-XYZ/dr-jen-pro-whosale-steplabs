{% comment %}
  Product Features Section - Figma Design Implementation
  10% Premium nHAp from eggshell features
{% endcomment %}

<div id="c-product-features-{{ section.id }}" class="Cproduct-features-section" data-section-id="{{ section.id }}">
  <div class="Cproduct-features__wrapper">

    <!-- Left Column -->
    <div class="Cproduct-features__left">
      {%- comment -%} Small heading desktop {%- endcomment -%}
      {% if section.settings.small_heading != blank %}
        <p class="Cproduct-features__small-heading Cproduct-features__small-heading--desktop">
          {{ section.settings.small_heading }}
        </p>
      {% endif %}

      {%- comment -%} Small heading mobile (fallback al desktop) {%- endcomment -%}
      {% assign small_heading_mobile_clean = section.settings.small_heading_mobile | strip %}
      {% if section.settings.small_heading != blank or small_heading_mobile_clean != blank %}
        <p class="Cproduct-features__small-heading Cproduct-features__small-heading--mobile">
          {{ small_heading_mobile_clean | default: section.settings.small_heading }}
        </p>
      {% endif %}

      {%- comment -%} Main heading desktop {%- endcomment -%}
      {% if section.settings.main_heading != blank %}
        <h2 class="Cproduct-features__main-heading Cproduct-features__main-heading--desktop">
          {{ section.settings.main_heading }}
        </h2>
      {% endif %}

      {%- comment -%} Main heading mobile (fallback al desktop) {%- endcomment -%}
      {% assign main_heading_mobile_clean = section.settings.main_heading_mobile | strip %}
      {% if section.settings.main_heading != blank or main_heading_mobile_clean != blank %}
        <h2 class="Cproduct-features__main-heading Cproduct-features__main-heading--mobile">
          {{ main_heading_mobile_clean | default: section.settings.main_heading }}
        </h2>
      {% endif %}

      <div class="Cproduct-features__list">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="Cproduct-features__card" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <div class="Cproduct-features__card-icon">
                  <img
                    src="{{ block.settings.icon | img_url: '96x96' }}"
                    alt="{{ block.settings.title }}"
                    loading="lazy"
                  >
                </div>
              {% endif %}
              <div class="Cproduct-features__card-content">
                {% if block.settings.title != blank %}
                  <h3 class="Cproduct-features__card-title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p class="Cproduct-features__card-description">{{ block.settings.description }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {%- comment -%}
        CTA en desktop: se queda aquí (debajo de las cajas de texto).
        En mobile: lo “sacamos” visualmente al final (debajo de ambas columnas) con CSS (order)
        sin duplicar markup ni JS.
      {%- endcomment -%}
      {% if section.settings.button_text != blank and section.settings.button_url != blank %}
        <div class="Cproduct-features__cta">
          <a href="{{ section.settings.button_url }}" class="Cproduct-features__button">
            {{ section.settings.button_text }}
          </a>
        </div>
      {% endif %}
    </div>

    <!-- Right Column -->
    <div class="Cproduct-features__right">
      {% if section.settings.show_badge %}
        <div class="Cproduct-features__badge">
          <span>{{ section.settings.badge_text | default: "NEW!" }}</span>
        </div>
      {% endif %}

      {% if section.settings.product_image != blank %}
        <div class="Cproduct-features__product-image">
          <img
            src="{{ section.settings.product_image | img_url: 'master' }}"
            alt="{{ section.settings.main_heading }}"
            loading="lazy"
          >
        </div>
      {% endif %}

      {% if section.settings.bottom_text != blank %}
        <div class="Cproduct-features__bottom-text">
          <p>{{ section.settings.bottom_text }}</p>
        </div>
      {% endif %}
    </div>

  </div>
</div>

<style>
/* Import Fonts */
@import url('https://fonts.googleapis.com/css2?family=Raleway:wght@500;600&display=swap');

#c-product-features-{{ section.id }} {
  background-color: transparent;
  padding: 0;
  position: relative;
}

#c-product-features-{{ section.id }} .Cproduct-features__wrapper {
  width:100%;
  margin: 0;
  padding: 0;
  background-color: #f7f7f7;
  border-radius: 0px;
  display: grid;
  grid-template-columns: 700px 1fr;
  gap: 80px;
  align-items: stretch;
  position: relative;
  min-height: 650px;
}

/* Left Column */
#c-product-features-{{ section.id }} .Cproduct-features__left {
  position: relative;
  width: 100%;
  padding: 40px 0px 40px 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

#c-product-features-{{ section.id }} .Cproduct-features__small-heading {
  font-family: 'EightiesComeback VAR';
  font-size: 20px;
  line-height: 39.6px;
  letter-spacing: 0.72px;
  color: #003e52;
  text-transform: capitalize;
  margin: 0 0 16px 0;
  font-weight: 400;
}

#c-product-features-{{ section.id }} .Cproduct-features__main-heading {
  font-family: 'Raleway', sans-serif;
  font-size: 40px;
  font-weight: 600;
  line-height: 1.3;
  color: #002c41;
  text-transform: capitalize;
  margin: 0 0 40px 0;
  max-width: 776px;
}

/* Por defecto: mostrar desktop, ocultar mobile */
#c-product-features-{{ section.id }} .Cproduct-features__small-heading--mobile { display: none; }
#c-product-features-{{ section.id }} .Cproduct-features__main-heading--mobile  { display: none; }

#c-product-features-{{ section.id }} .Cproduct-features__list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 32px;
}

#c-product-features-{{ section.id }} .Cproduct-features__card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(27.5px);
  -webkit-backdrop-filter: blur(27.5px);
  border-radius: 500px;
  padding: 8px 20px 8px 8px;
  display: flex;
  align-items: center;
  gap: 16px;
  min-height: 112px;
}

#c-product-features-{{ section.id }} .Cproduct-features__card-icon {
  flex-shrink: 0;
  width: 96px;
  height: 96px;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

#c-product-features-{{ section.id }} .Cproduct-features__card-icon img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#c-product-features-{{ section.id }} .Cproduct-features__card-content {
  flex: 1;
  padding-right: 20px;
}

#c-product-features-{{ section.id }} .Cproduct-features__card-title {
  font-family: 'Raleway', sans-serif;
  font-size: 19px;
  font-weight: 600;
  line-height: 27px;
  color: #002c41;
  margin: 0 0 6px 0;
}

#c-product-features-{{ section.id }} .Cproduct-features__card-description {
  font-family: 'Raleway', sans-serif;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
  color: #002c41;
  margin: 0;
}

/* CTA (desktop default: debajo de cards dentro de la columna izquierda) */
#c-product-features-{{ section.id }} .Cproduct-features__cta {
  margin-top: 24px;
}

#c-product-features-{{ section.id }} .Cproduct-features__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: #3d6aff;
  color: #d6ece6;
  font-family: 'Raleway', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.26px;
  text-transform: uppercase;
  text-decoration: none;
  padding: 14px 70px;
  border-radius: 100px;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
}

#c-product-features-{{ section.id }} .Cproduct-features__button:hover {
  background-color: #2a55e6;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(61, 106, 255, 0.3);
}

/* Right Column */
#c-product-features-{{ section.id }} .Cproduct-features__right {
  position: relative;
  height: 100%;
  min-height: 650px;
  overflow: hidden;
}

#c-product-features-{{ section.id }} .Cproduct-features__badge {
  position: absolute;
  top: 20px;
  right: 40px;
  background: #d6ece6;
  border: 1px solid #003e52;
  border-radius: 40px;
  padding: 10px 28px;
  z-index: 10;
}

#c-product-features-{{ section.id }} .Cproduct-features__badge span {
  font-family: 'Inter', sans-serif;
  font-size: 18px;
  font-weight: 600;
  color: #003e52;
  text-transform: uppercase;
}

#c-product-features-{{ section.id }} .Cproduct-features__product-image {
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

#c-product-features-{{ section.id }} .Cproduct-features__product-image img {
  width: 100%;
  height: 100%;
  max-width: 100%;
  object-fit: cover;
  display: block;
}

#c-product-features-{{ section.id }} .Cproduct-features__bottom-text {
  background: #ffffff;
  border: 1px solid rgba(0, 62, 82, 0.1);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  border-radius: 99px;
  padding: 14px 50px;
  text-align: center;
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  max-width: 544px;
  width: auto;
  z-index: 5;
}

#c-product-features-{{ section.id }} .Cproduct-features__bottom-text p {
  font-family: 'EightiesComeback VAR';
  font-size: 19px;
  line-height: 26px;
  color: #3e5565;
  text-transform: capitalize;
  margin: 0;
  white-space: nowrap;
}

/* Responsive Styles */
@media (max-width: 1200px) {
  #c-product-features-{{ section.id }} .Cproduct-features__wrapper {
    max-width: 100%;
    padding: 60px 20px;
    grid-template-columns: 1fr;
    gap: 60px;
    min-height: auto;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__right {
    min-height: 500px;
    border-radius: 16px;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__product-image {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__badge {
    right: 20px;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__bottom-text {
    bottom: 30px;
  }
}

/*
  MOBILE:
  - Necesitamos que el botón quede por fuera (debajo de ambas “columnas”).
  - Sin mover el HTML: usamos CSS Grid + "display: contents" en el contenedor left SOLO en mobile
    para que el CTA sea un item del grid (hereda el order al final).
*/
@media (max-width: 768px) {
  #c-product-features-{{ section.id }} {
    padding: 0;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 28px 16px;
    min-height: auto;
    border-radius: 0;
    margin: 0;
  }

  /* Swap headings (desktop off, mobile on) */
  #c-product-features-{{ section.id }} .Cproduct-features__small-heading--desktop { display: none; }
  #c-product-features-{{ section.id }} .Cproduct-features__small-heading--mobile  { display: block; }
  #c-product-features-{{ section.id }} .Cproduct-features__main-heading--desktop  { display: none; }
  #c-product-features-{{ section.id }} .Cproduct-features__main-heading--mobile   { display: block; }

  /* “Saca” los hijos del left al nivel del grid (solo mobile) */
  #c-product-features-{{ section.id }} .Cproduct-features__left {
    display: contents;
    padding: 0;
  }

  /* Orden explícito: heading + list -> imagen -> botón */
  #c-product-features-{{ section.id }} .Cproduct-features__small-heading { order: 1; }
  #c-product-features-{{ section.id }} .Cproduct-features__main-heading  { order: 2; }
  #c-product-features-{{ section.id }} .Cproduct-features__list          { order: 3; }
  #c-product-features-{{ section.id }} .Cproduct-features__right         { order: 4; }
  #c-product-features-{{ section.id }} .Cproduct-features__cta           { order: 5; }

  #c-product-features-{{ section.id }} .Cproduct-features__small-heading {
    text-align: center;
    margin: 0 0 10px 0;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.3px;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__main-heading {
    text-align: center;
    margin: 0 0 18px 0;
    font-size: 26px;
    line-height: 1.15;
    max-width: 100%;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
  }

  /* Cards horizontales como la captura */
  #c-product-features-{{ section.id }} .Cproduct-features__card {
    flex-direction: row;
    align-items: center;
    text-align: left;
    border-radius: 999px;
    padding: 10px 14px 10px 10px;
    min-height: 88px;
    gap: 12px;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__card-icon {
    width: 56px;
    height: 56px;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__card-content {
    padding-right: 0;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__card-title {
    font-size: 13px;
    line-height: 18px;
    margin: 0 0 4px 0;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__card-description {
    font-size: 11px;
    line-height: 16px;
  }

  /* Bloque imagen */
  #c-product-features-{{ section.id }} .Cproduct-features__right {
    min-height: 460px;
    border-radius: 18px;
    position: relative;
    overflow: hidden;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__product-image {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0; /* espacio para pill */
  }

  #c-product-features-{{ section.id }} .Cproduct-features__product-image img {
    height: 100%;
    max-height: 100%;
    width: 100%;
    max-width: 100%;
    object-fit: cover;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__badge {
    top: 18px;
    right: 18px;
    padding: 8px 18px;
    border-radius: 999px;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__badge span {
    font-size: 12px;
    letter-spacing: 0.2px;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__bottom-text {
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 32px);
    max-width: 360px;
    padding: 10px 14px;
    border-radius: 999px;
    z-index: 6;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__bottom-text p {
    font-size: 11px;
    line-height: 14px;
    white-space: nowrap;
  }

  /* CTA ahora ya es “item del grid” => queda por fuera debajo */
  #c-product-features-{{ section.id }} .Cproduct-features__cta {
    margin-top: 12px;
    width: 100%;
    text-align:center;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__button {
    width: 70%;
    padding: 14px 22px;
    border-radius: 999px;
  }
}

@media (max-width: 480px) {
  #c-product-features-{{ section.id }} .Cproduct-features__wrapper {
    padding: 24px 14px;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__right {
    min-height: 440px;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__product-image {
    padding: 0;
  }

  #c-product-features-{{ section.id }} .Cproduct-features__bottom-text {
    max-width: 340px;
  }
}
</style>

{% schema %}
{
  "name": "C Product Features",
  "settings": [
    {
      "type": "text",
      "id": "small_heading",
      "label": "Small Heading (Desktop)",
      "default": "Fluoride-Free",
      "info": "Displayed above main heading"
    },
    {
      "type": "text",
      "id": "small_heading_mobile",
      "label": "Small Heading (Mobile)",
      "default": "10%"
    },
    {
      "type": "textarea",
      "id": "main_heading",
      "label": "Main Heading (Desktop)",
      "default": "10% Premium nHAp from eggshell"
    },
    {
      "type": "textarea",
      "id": "main_heading_mobile",
      "label": "Main Heading (Mobile)",
      "default": "Main Mobile"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "NEW!"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Text",
      "default": "Low-abrasion silica system – enamel-safe polishing"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon/Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Nano-Hydroxyapatite"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Highest quality clinically effective nHAp at 10% concentration. Low-abrasion & enamel-safe cleaning"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "C Product Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Premium Nano-Hydroxyapatite",
            "description": "Highest quality clinically effective nHAp at 10% concentration. Low-abrasion & enamel-safe cleaning"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Naturally derived nHAp",
            "description": "First and only naturally derived nano-hydroxyapatite (from eggshells)"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Xylitol",
            "description": "supports oral microbiome balance"
          }
        }
      ]
    }
  ]
}
{% endschema %}