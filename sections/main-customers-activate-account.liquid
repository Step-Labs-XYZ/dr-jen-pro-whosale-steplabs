{%- comment -%}
  Account activation (the link in Shopify's account invite email). Same look as the
  sign-in redesign (Figma "Log in", node 6746-1730): eyebrow + title, pill fields with
  the label above, blue button. Copy is editable; blank falls back to the theme's
  translations.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  comment
    Each text: the editor value, else the theme translation.
  endcomment
  assign title = s.title
  if title == blank
    assign title = 'customer.activate_account.title' | t
  endif
  assign text = s.text
  if text == blank
    assign text = 'customer.activate_account.instructions' | t
  endif
  assign password_label = s.password_label
  if password_label == blank
    assign password_label = 'customer.activate_account.password' | t
  endif
  assign confirm_label = s.confirm_label
  if confirm_label == blank
    assign confirm_label = 'customer.activate_account.password_confirmation' | t
  endif
  assign submit_label = s.submit_label
  if submit_label == blank
    assign submit_label = 'customer.activate_account.submit' | t
  endif
  assign decline_label = s.decline_label
  if decline_label == blank
    assign decline_label = 'customer.activate_account.cancel' | t
  endif
-%}

{%- render 'c-account-form-styles' -%}

<section class="c-acct">
  <div class="c-acct__inner">
    {%- if s.eyebrow != blank -%}<p class="c-acct__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h1 class="c-acct__title">{{ title }}</h1>
    {%- if text != blank -%}<p class="c-acct__text">{{ text }}</p>{%- endif -%}

    {%- form 'activate_customer_password', name: 'activate', class: 'c-acct__form', id: 'activate-customer-password' -%}
      {%- if form.errors -%}
        <div class="c-acct__error" id="activate-form-error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="c-acct__field">
        <label for="activate-password">{{ password_label }}</label>
        <input type="password" id="activate-password" name="customer[password]" required autocomplete="new-password" {% if form.errors %}aria-invalid="true" aria-describedby="activate-form-error"{% endif %}>
      </div>

      <div class="c-acct__field">
        <label for="activate-password-confirmation">{{ confirm_label }}</label>
        <input type="password" id="activate-password-confirmation" name="customer[password_confirmation]" required autocomplete="new-password">
      </div>

      <button type="submit" class="c-acct__submit">{{ submit_label }}</button>
      <button type="submit" name="decline" class="c-acct__decline">{{ decline_label }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Customer activate account",
  "class": "shopify-section--main-customers-activate-account",
  "settings": [
    { "type": "paragraph", "content": "Page opened from the account invite email. Leave a field empty to use the theme's default text." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dr. Jen · Dental professionals" },
    { "type": "text", "id": "title", "label": "Title", "default": "Activate your account" },
    { "type": "text", "id": "text", "label": "Text", "default": "Create a password to sign in and reorder for your practice." },
    { "type": "text", "id": "password_label", "label": "Password label", "default": "Password" },
    { "type": "text", "id": "confirm_label", "label": "Confirm password label", "default": "Confirm password" },
    { "type": "text", "id": "submit_label", "label": "Button", "default": "Activate account" },
    { "type": "text", "id": "decline_label", "label": "Decline link", "default": "Decline invitation" }
  ]
}
{% endschema %}
