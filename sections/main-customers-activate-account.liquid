{%- comment -%}
  Account activation (the link in Shopify's account invite email). Same look as the
  sign-in redesign (Figma "Log in", node 6746-1730): eyebrow + title, pill fields with
  the label above, blue button. Copy is editable; blank falls back to the theme's
  translations.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  comment
    Each text: the editor value, else the theme translation.
  endcomment
  assign title = s.title
  if title == blank
    assign title = 'customer.activate_account.title' | t
  endif
  assign text = s.text
  if text == blank
    assign text = 'customer.activate_account.instructions' | t
  endif
  assign password_label = s.password_label
  if password_label == blank
    assign password_label = 'customer.activate_account.password' | t
  endif
  assign confirm_label = s.confirm_label
  if confirm_label == blank
    assign confirm_label = 'customer.activate_account.password_confirmation' | t
  endif
  assign submit_label = s.submit_label
  if submit_label == blank
    assign submit_label = 'customer.activate_account.submit' | t
  endif
  assign decline_label = s.decline_label
  if decline_label == blank
    assign decline_label = 'customer.activate_account.cancel' | t
  endif
-%}

<style>
  .c-activate { padding: 24px 16px 40px; font-family: Raleway, sans-serif; color: #000; }
  .c-activate * { box-sizing: border-box; }
  .c-activate__inner { display: flex; flex-direction: column; gap: 12px; max-width: 504px; margin: 0 auto; }
  .c-activate__eyebrow { margin: 0; color: #002c41; font-size: 16px; font-style: italic; line-height: 1.2; }
  .c-activate__title { margin: 0; color: #002c41; font-size: 32px; font-weight: 600; line-height: 1.2; }
  .c-activate__text { margin: 0; font-size: 18px; line-height: 1.3; }
  .c-activate__form { display: flex; flex-direction: column; gap: 12px; }
  .c-activate__field { display: flex; flex-direction: column; gap: 4px; }
  .c-activate__field label { font-size: 14px; line-height: 1.2; }
  .c-activate__field input {
    width: 100%; height: 39px; padding: 0 24px;
    border: 1px solid #707170; border-radius: 44px; background: #fff;
    color: #000; font: 400 14px Raleway, sans-serif;
  }
  .c-activate__field input:focus-visible { outline: 2px solid #0862df; outline-offset: 1px; }
  .c-activate__submit {
    width: 100%; min-height: 39px; margin-top: 4px; padding: 8px 24px; border: 0; border-radius: 44px;
    background: #0862df; color: #f7f7f7;
    font: 700 14px/1.2 Raleway, sans-serif; text-transform: uppercase;
    box-shadow: 0 2px 6px rgba(0, 44, 65, .12); cursor: pointer;
  }
  .c-activate__decline {
    align-self: center; padding: 0; border: 0; background: none; color: #002c41;
    font: 700 12px/1.2 Raleway, sans-serif; text-decoration: underline; text-transform: uppercase; cursor: pointer;
  }
  .c-activate__error { padding: 12px; border-radius: 12px; background: #fdecea; color: #b3261e; font-size: 14px; line-height: 1.3; }
  .c-activate__error ul { margin: 0; padding-left: 18px; }
  @media (min-width: 990px) {
    .c-activate { padding: 64px 24px; }
    .c-activate__title { font-size: 40px; }
    .c-activate__text { font-size: 20px; }
  }
</style>

<section class="c-activate">
  <div class="c-activate__inner">
    {%- if s.eyebrow != blank -%}<p class="c-activate__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h1 class="c-activate__title">{{ title }}</h1>
    {%- if text != blank -%}<p class="c-activate__text">{{ text }}</p>{%- endif -%}

    {%- form 'activate_customer_password', name: 'activate', class: 'c-activate__form', id: 'activate-customer-password' -%}
      {%- if form.errors -%}
        <div class="c-activate__error" id="activate-form-error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="c-activate__field">
        <label for="activate-password">{{ password_label }}</label>
        <input type="password" id="activate-password" name="customer[password]" required autocomplete="new-password" {% if form.errors %}aria-invalid="true" aria-describedby="activate-form-error"{% endif %}>
      </div>

      <div class="c-activate__field">
        <label for="activate-password-confirmation">{{ confirm_label }}</label>
        <input type="password" id="activate-password-confirmation" name="customer[password_confirmation]" required autocomplete="new-password">
      </div>

      <button type="submit" class="c-activate__submit">{{ submit_label }}</button>
      <button type="submit" name="decline" class="c-activate__decline">{{ decline_label }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Customer activate account",
  "class": "shopify-section--main-customers-activate-account",
  "settings": [
    { "type": "paragraph", "content": "Page opened from the account invite email. Leave a field empty to use the theme's default text." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dr. Jen · Dental professionals" },
    { "type": "text", "id": "title", "label": "Title", "default": "Activate your account" },
    { "type": "text", "id": "text", "label": "Text", "default": "Create a password to sign in and reorder for your practice." },
    { "type": "text", "id": "password_label", "label": "Password label", "default": "Password" },
    { "type": "text", "id": "confirm_label", "label": "Confirm password label", "default": "Confirm password" },
    { "type": "text", "id": "submit_label", "label": "Button", "default": "Activate account" },
    { "type": "text", "id": "decline_label", "label": "Decline link", "default": "Decline invitation" }
  ]
}
{% endschema %}
