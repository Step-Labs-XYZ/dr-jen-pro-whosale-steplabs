{%- comment -%}
  Section: C Sample Request
  "Request Practice Samples and Free CE" (Figma section "Request", node 6396-6959).
  The form itself is Powerful Form Builder's "Dr Jen Form Free Samples" (form 68619):
  the app keeps the submissions, sends its emails, runs its own steps and redirects
  after submit. This section only adds the page heading and restyles the app's
  markup to the design (pill fields, blue buttons, navy headings).
  sl-id: sl-section-sample-request-v2
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign form_id = s.form_id | default: '68619' | strip
-%}

{% style %}
  #c-sreq-{{ sid }} {
    padding: 24px 16px 40px;
    color: #000;
    font-family: Raleway, sans-serif;
  }
  #c-sreq-{{ sid }} .c-sreq__inner { display: flex; flex-direction: column; gap: 12px; max-width: 640px; margin: 0 auto; }
  #c-sreq-{{ sid }} .c-sreq__eyebrow { margin: 0; color: #002c41; font-size: 16px; font-style: italic; line-height: 1.2; }
  #c-sreq-{{ sid }} .c-sreq__title { margin: 0; color: #002c41; font-size: 32px; font-weight: 600; line-height: 1.2; }
  #c-sreq-{{ sid }} .c-sreq__text { margin: 0; font-size: 16px; line-height: 1.3; }
  #c-sreq-{{ sid }} .c-sreq__form { margin-top: 8px; min-height: 200px; }

  /* Powerful Form Builder markup, scoped to this section */
  #c-sreq-{{ sid }} .globo-form-app {
    max-width: none !important; margin: 0 !important; padding: 0 !important;
    background: transparent !important; box-shadow: none !important; border: 0 !important;
    font-family: Raleway, sans-serif !important;
    /* the app's colour tokens: orange accents -> design blue / navy */
    --gfb-color-solidButton: 8,98,223 !important;
    --gfb-color-solidButtonColor: rgb(8,98,223) !important;
    --gfb-color-solidButtonLabel: 247,247,247 !important;
    --gfb-color-solidButtonLabelColor: rgb(247,247,247) !important;
    --gfb-color-outlineButton: 8,98,223 !important;
    --gfb-color-outlineButtonColor: rgb(8,98,223) !important;
    --gfb-primary-color: rgb(8,98,223) !important;
    --gfb-primary-text-color: rgb(247,247,247) !important;
    --gfb-color-text: 0,0,0 !important;
    --gfb-color-textColor: rgb(0,0,0) !important;
    --gfb-main-color: #002c41 !important;
  }
  /* fields keep a 5px side padding for the column gap; pull the rows back in line with the title */
  #c-sreq-{{ sid }} .globo-form-app .panels { margin-left: -5px !important; margin-right: -5px !important; }
  #c-sreq-{{ sid }} .globo-form-app .globo-form-icon { display: none !important; }
  #c-sreq-{{ sid }} .globo-form-app .g-container,
  #c-sreq-{{ sid }} .globo-form-app .content { padding-left: 0 !important; padding-right: 0 !important; }
  {%- if s.hide_app_title -%}
  #c-sreq-{{ sid }} .globo-form-app .header .title { display: none !important; }
  {%- endif -%}
  #c-sreq-{{ sid }} .globo-form-app .header { padding: 0 !important; text-align: left !important; }
  #c-sreq-{{ sid }} .globo-form-app .header .description,
  #c-sreq-{{ sid }} .globo-form-app .header .description * { color: #002c41 !important; font-size: 14px !important; }
  #c-sreq-{{ sid }} .globo-form-app .globo-heading,
  #c-sreq-{{ sid }} .globo-form-app h3 { color: #002c41 !important; font: 600 20px/1.2 Raleway, sans-serif !important; }
  #c-sreq-{{ sid }} .globo-form-app .globo-label,
  #c-sreq-{{ sid }} .globo-form-app label { color: #000 !important; font-family: Raleway, sans-serif !important; font-size: 14px !important; }
  #c-sreq-{{ sid }} .globo-form-app input[type="text"],
  #c-sreq-{{ sid }} .globo-form-app input[type="email"],
  #c-sreq-{{ sid }} .globo-form-app input[type="tel"],
  #c-sreq-{{ sid }} .globo-form-app input[type="url"],
  #c-sreq-{{ sid }} .globo-form-app input[type="number"],
  #c-sreq-{{ sid }} .globo-form-app select {
    height: 39px !important; padding: 0 24px !important;
    border: 1px solid #707170 !important; border-radius: 44px !important; background: #fff !important;
    color: #000 !important; font: 400 14px Raleway, sans-serif !important; box-shadow: none !important;
  }
  #c-sreq-{{ sid }} .globo-form-app textarea {
    padding: 12px 24px !important; border: 1px solid #707170 !important; border-radius: 20px !important;
    font: 400 14px Raleway, sans-serif !important;
  }
  #c-sreq-{{ sid }} .globo-form-app input::placeholder,
  #c-sreq-{{ sid }} .globo-form-app textarea::placeholder { color: #707170 !important; }
  #c-sreq-{{ sid }} .globo-form-app input:focus-visible,
  #c-sreq-{{ sid }} .globo-form-app select:focus-visible,
  #c-sreq-{{ sid }} .globo-form-app textarea:focus-visible { outline: 2px solid #0862df !important; outline-offset: 1px; }
  #c-sreq-{{ sid }} .globo-form-app input[type="radio"],
  #c-sreq-{{ sid }} .globo-form-app input[type="checkbox"] { accent-color: #0862df; }

  /* step tabs */
  #c-sreq-{{ sid }} .globo-form-app .gf-step,
  #c-sreq-{{ sid }} .globo-form-app .gf-step * { color: #707170 !important; font-family: Raleway, sans-serif !important; }
  #c-sreq-{{ sid }} .globo-form-app .gf-step.active,
  #c-sreq-{{ sid }} .globo-form-app .gf-step.active *,
  #c-sreq-{{ sid }} .globo-form-app .gf-step.finished,
  #c-sreq-{{ sid }} .globo-form-app .gf-step.finished * { color: #002c41 !important; }
  #c-sreq-{{ sid }} .globo-form-app .gf-step::before,
  #c-sreq-{{ sid }} .globo-form-app .gf-step .step-number { background: #707170 !important; border-color: #707170 !important; color: #fff !important; }
  #c-sreq-{{ sid }} .globo-form-app .gf-step.active::before,
  #c-sreq-{{ sid }} .globo-form-app .gf-step.active .step-number,
  #c-sreq-{{ sid }} .globo-form-app .gf-step.finished::before,
  #c-sreq-{{ sid }} .globo-form-app .gf-step.finished .step-number { background: #002c41 !important; border-color: #002c41 !important; }

  /* buttons */
  #c-sreq-{{ sid }} .globo-form-app .gfb__footer { padding-left: 0 !important; padding-right: 0 !important; text-align: left !important; }
  #c-sreq-{{ sid }} .globo-form-app .gfb__footer button,
  #c-sreq-{{ sid }} .globo-form-app button.action {
    min-height: 39px !important; padding: 8px 24px !important; border: 0 !important; border-radius: 44px !important;
    background: #0862df !important; color: #f7f7f7 !important;
    font: 700 14px/1.2 Raleway, sans-serif !important; text-transform: uppercase;
    box-shadow: 0 2px 6px rgba(0, 44, 65, .12) !important;
  }
  #c-sreq-{{ sid }} .globo-form-app .gfb__footer button.previous {
    background: none !important; box-shadow: none !important; color: #002c41 !important;
    font-size: 12px !important; text-decoration: underline;
  }
  #c-sreq-{{ sid }} .globo-form-app .messages,
  #c-sreq-{{ sid }} .globo-form-app .message.success { border-radius: 12px; font-family: Raleway, sans-serif !important; }

  @media (min-width: 990px) {
    #c-sreq-{{ sid }} { padding: 64px 24px; }
    #c-sreq-{{ sid }} .c-sreq__title { font-size: 40px; }
    #c-sreq-{{ sid }} .c-sreq__text { font-size: 20px; }
  }
{% endstyle %}

<section id="c-sreq-{{ sid }}" class="c-sreq" data-sl-id="sl-section-sample-request-v2">
  <div class="c-sreq__inner">
    {%- if s.eyebrow != blank -%}<p class="c-sreq__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.title != blank -%}<h1 class="c-sreq__title">{{ s.title }}</h1>{%- endif -%}
    {%- if s.text != blank -%}<p class="c-sreq__text">{{ s.text }}</p>{%- endif -%}
    <div class="c-sreq__form">
      <div class="globo-formbuilder" data-id="{{ form_id | base64_encode }}"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "C Sample Request",
  "tag": "div",
  "class": "c-sample-request-wrapper",
  "settings": [
    { "type": "paragraph", "content": "The form is Powerful Form Builder's: fields, steps, emails, submissions and the after-submit redirect are edited in the app." },
    { "type": "text", "id": "form_id", "label": "Powerful Form Builder form ID", "default": "68619", "info": "Number in the app's form URL. 68619 = Dr Jen Form Free Samples." },
    { "type": "checkbox", "id": "hide_app_title", "label": "Hide the form's own title", "default": true, "info": "The page title below replaces it." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dr. Jen · Dental professionals" },
    { "type": "text", "id": "title", "label": "Title", "default": "Request Practice Samples and Free CE" },
    { "type": "text", "id": "text", "label": "Text", "default": "For dental offices · eligibility checked" }
  ],
  "presets": [{ "name": "C Sample Request" }]
}
{% endschema %}
