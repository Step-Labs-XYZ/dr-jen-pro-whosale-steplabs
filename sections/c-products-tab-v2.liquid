<script>
  (function () {
    var root = document.getElementById('Cptabs2-{{ section.id }}');
    if (!root || root.dataset.cptabs2Ready) return;
    root.dataset.cptabs2Ready = 'true';

    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-cptabs2-tab]'));

    // Sticky column titles sit below the header while it is on screen
    var header = document.querySelector('.c-header');
    var ticking = false;
    function setStickyTop() {
      ticking = false;
      var bottom = header ? Math.max(0, Math.round(header.getBoundingClientRect().bottom)) : 0;
      root.style.setProperty('--cptabs2-sticky-top', bottom + 'px');
    }
    setStickyTop();
    if (header) {
      window.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; requestAnimationFrame(setStickyTop); }
      }, { passive: true });
      window.addEventListener('resize', setStickyTop);
    }

    function activate(tab) {
      var id = tab.getAttribute('data-cptabs2-tab');
      tabs.forEach(function (t) {
        var on = t === tab;
        t.classList.toggle('Cptabs2__tab--active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      root.querySelectorAll('[data-cptabs2-panel]').forEach(function (panel) {
        var on = panel.getAttribute('data-cptabs2-panel') === id;
        panel.classList.toggle('Cptabs2__panel--active', on);
        panel.hidden = !on;
      });
    }

    tabs.forEach(function (tab, i) {
      tab.tabIndex = i === 0 ? 0 : -1;
      tab.addEventListener('click', function () { activate(tab); });
      tab.addEventListener('keydown', function (e) {
        var next = null;
        if (e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
        if (e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
        if (next) { e.preventDefault(); next.focus(); activate(next); }
      });
    });

    // Theme editor: show the tab of the selected block
    document.addEventListener('shopify:block:select', function (e) {
      if (!root.contains(e.target)) return;
      var tab = e.target.closest('[data-cptabs2-tab]');
      if (!tab) {
        var panel = e.target.closest('[data-cptabs2-panel]');
        if (panel) tab = root.querySelector('[data-cptabs2-tab="' + panel.getAttribute('data-cptabs2-panel') + '"]');
      }
      if (tab) activate(tab);
    });
  })();
</script>

