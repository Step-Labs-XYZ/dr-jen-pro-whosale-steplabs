{{ 'https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

<div class="silk-comparison-section-{{ section.id }}{% if section.settings.design_v2 %} silk--v2{% endif %}">
  <div class="silk-comparison-container">
    
    <!-- COLUMNA IZQUIERDA: Textos fijos e Ingredientes -->
    <div class="silk-left-column">
      {%- if section.settings.main_title != blank -%}
        <h2 class="silk-main-title">{{ section.settings.main_title }}</h2>
      {%- endif -%}

      {%- if section.settings.main_description != blank -%}
        <div class="silk-main-description">
          {{ section.settings.main_description }}
        </div>
      {%- endif -%}

      {%- if section.settings.ingredients_text != blank -%}
        <button type="button" class="silk-ingredients-link js-open-ingredients-modal">
          {{ section.settings.ingredients_text }} <span>→</span>
        </button>
      {%- endif -%}

      <!-- Caja de Ingredientes / Características Izquierda -->
      <div class="silk-ingredients-box">
        {%- if section.settings.box_tag != blank -%}
          <div class="silk-box-tag">{{ section.settings.box_tag }}</div>
        {%- endif -%}

        <div class="silk-ingredient-items">
          <div class="silk-ingredient-row">
            <div class="silk-ing-number">{{ section.settings.item_1_num }}</div>
            <div class="silk-ing-content">
              <h4>{{ section.settings.item_1_title }}</h4>
              <p>{{ section.settings.item_1_desc }}</p>
            </div>
          </div>
          <div class="silk-ingredient-row">
            <div class="silk-ing-number">{{ section.settings.item_2_num }}</div>
            <div class="silk-ing-content">
              <h4>{{ section.settings.item_2_title }}</h4>
              <p>{{ section.settings.item_2_desc }}</p>
            </div>
          </div>
          <div class="silk-ingredient-row">
            <div class="silk-ing-number">{{ section.settings.item_3_num }}</div>
            <div class="silk-ing-content">
              <h4>{{ section.settings.item_3_title }}</h4>
              <p>{{ section.settings.item_3_desc }}</p>
            </div>
          </div>
          <div class="silk-ingredient-row">
            <div class="silk-ing-number">{{ section.settings.item_4_num }}</div>
            <div class="silk-ing-content">
              <h4>{{ section.settings.item_4_title }}</h4>
              <p>{{ section.settings.item_4_desc }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- COLUMNA DERECHA: Pestañas + Imagen con Hotspots -->
    <div class="silk-right-column">
      {%- if section.blocks.size > 0 -%}
        
        <!-- Paso 1: Recopilar todos los bloques de tipo tab_item para numerarlos -->
        {%- assign tabs_array = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab_item' -%}
            {%- assign tabs_array = tabs_array | append: block.id | append: ',' -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign tabs_list = tabs_array | split: ',' -%}

        <!-- Botones de Pestañas Principales -->
        <div class="silk-tabs-nav">
          {%- for tab_id in tabs_list -%}
            {%- if tab_id != '' -%}
              {%- assign current_tab_index = forloop.index0 -%}
              {%- for block in section.blocks -%}
                {%- if block.id == tab_id -%}
                  <button class="silk-tab-btn {% if current_tab_index == 0 %}active{% endif %}" data-tab="tab-{{ section.id }}-{{ tab_id }}" {{ block.shopify_attributes }}>
                    {{ block.settings.tab_title }}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Contenedor de las Pestañas -->
        <div class="silk-tabs-content-wrapper">
          {%- for tab_id in tabs_list -%}
            {%- if tab_id != '' -%}
              {%- assign current_tab_index = forloop.index0 -%}
              {%- assign tab_block = nil -%}
              {%- for block in section.blocks -%}
                {%- if block.id == tab_id -%}
                  {%- assign tab_block = block -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if tab_block != nil -%}
                <div class="silk-tab-pane {% if current_tab_index == 0 %}active{% endif %}" id="tab-{{ section.id }}-{{ tab_id }}">
                  
                  <!-- Contenedor de Imagen con sus Hotspots -->
                  <div class="silk-hotspot-image-container">
                    {%- if tab_block.settings.tab_image != blank -%}
                      <img src="{{ tab_block.settings.tab_image | image_url: width: 1000 }}" alt="{{ tab_block.settings.tab_title | escape }}" loading="lazy" class="silk-tab-image">
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'silk-tab-image placeholder-svg' }}
                    {%- endif -%}

                    {%- if tab_block.settings.image_caption != blank -%}
                      <span class="silk-image-caption" style="left: {{ tab_block.settings.caption_x | default: 33 }}%; top: {{ tab_block.settings.caption_y | default: 73 }}%;">{{ tab_block.settings.image_caption }}</span>
                    {%- endif -%}

                    <!-- Renderizar Hotspots que pertenecen a este Tab -->
                    {%- assign target_tab_value = current_tab_index | plus: 1 | append: '' -%}
                    {%- assign hotspot_counter = 0 -%}
                    {%- for hotspot_block in section.blocks -%}
                      {%- if hotspot_block.type == 'hotspot_point' and hotspot_block.settings.parent_tab_num == target_tab_value -%}
                        <div class="silk-hotspot-point {% if hotspot_counter == 0 %}active{% endif %}" 
                             style="--desktop-x: {{ hotspot_block.settings.pos_x_desktop }}%; --desktop-y: {{ hotspot_block.settings.pos_y_desktop }}%; --mobile-x: {{ hotspot_block.settings.pos_x_mobile }}%; --mobile-y: {{ hotspot_block.settings.pos_y_mobile }}%;"
                             data-target="info-{{ section.id }}-{{ hotspot_block.id }}"
                             {{ hotspot_block.shopify_attributes }}>
                          <span class="silk-hotspot-dot" style="background-color: {{ hotspot_block.settings.dot_color }};"></span>
                        </div>
                        {%- assign hotspot_counter = hotspot_counter | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>

                  <!-- Contenedores de Información que cambian al hacer clic en los Hotspots -->
                  {%- assign info_counter = 0 -%}
                  {%- for hotspot_block in section.blocks -%}
                    {%- if hotspot_block.type == 'hotspot_point' and hotspot_block.settings.parent_tab_num == target_tab_value -%}
                      <div class="silk-hotspot-content-box {% if info_counter == 0 %}active{% endif %}" id="info-{{ section.id }}-{{ hotspot_block.id }}">
                        <!-- Tarjeta de Texto -->
                        <div class="silk-tab-text-card">
                          <div class="silk-card-header">
                            <span class="silk-bullet-dot" style="background-color: {{ hotspot_block.settings.dot_color }};"></span>
                            <h3>{{ hotspot_block.settings.card_title }}</h3>
                          </div>
                          <p>{{ hotspot_block.settings.card_desc }}</p>
                        </div>

                        <!-- Lista de Checks / Cruces -->
                        <div class="silk-checklist">
                          {{ hotspot_block.settings.checklist_html }}
                        </div>
                      </div>
                      {%- assign info_counter = info_counter | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}

                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>

  <!-- POPUP DE INGREDIENTES (Estructura idéntica a la solicitada) -->
  <div class="c-prod__ingredients-modal" data-ingredients-modal="" aria-hidden="true" style="display: none;">
    <div class="c-prod__ingredients-modal-backdrop" data-ingredients-close=""></div>
    <div class="c-prod__ingredients-modal-card" role="dialog" aria-modal="true" aria-label="Ingredient facts">
      <button type="button" class="c-prod__ingredients-modal-close" data-ingredients-close="" aria-label="Close">×</button>
      <p class="c-prod__ingredients-modal-subtitle">INGREDIENT FACTS</p>
      <h3 class="c-prod__ingredients-modal-title">100% Italian Silk Floss</h3>

      <div class="c-prod__ingredients-modal-content">
        <div class="c-prod__ingredients-flavors">
          <button type="button" class="c-prod__ing-tab-btn is-active js-ing-tab-btn-template" data-target="flavor-1" style="--flavor-border-color: #002c41; --flavor-bg-color: #f4f8fb;">
            <span class="c-prod__ing-tab-dot" style="background-color: #002c41"></span>
            Cool Mint
          </button>
          <button type="button" class="c-prod__ing-tab-btn js-ing-tab-btn-template" data-target="flavor-2" style="--flavor-border-color: #ffb783; --flavor-bg-color: #f5d9c5;">
            <span class="c-prod__ing-tab-dot" style="background-color: #ffb783"></span>
            Papaya
          </button>
          <button type="button" class="c-prod__ing-tab-btn js-ing-tab-btn-template" data-target="flavor-3" style="--flavor-border-color: #b50859; --flavor-bg-color: #c689a5;">
            <span class="c-prod__ing-tab-dot" style="background-color: #b50859"></span>
            Black Cherry
          </button>
        </div>

        <div class="c-prod__ingredients-table">
          <div class="c-prod__ing-tab-content is-active js-ing-tab-content-template" id="flavor-1">
            <div class="c-prod__ingredients-section-title">BASE &amp; TEXTURE</div>
            <div class="c-prod__ing-item-wrap"><div class="c-prod__ing-item-header"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>Premium Italian Silk</span><span class="c-prod__ingredients-tag">Fiber Base</span></div></div>
            <div class="c-prod__ing-item-wrap"><div class="c-prod__ing-item-header"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>Avocado Oil</span><span class="c-prod__ingredients-tag">Coating</span></div></div>
            <div class="c-prod__ingredients-section-title">FLAVOR &amp; FRESHNESS</div>
            <div class="c-prod__ing-item-wrap"><div class="c-prod__ing-item-header"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>Mint</span><span class="c-prod__ingredients-tag">Flavor</span></div></div>
          </div>

          <div class="c-prod__ing-tab-content js-ing-tab-content-template" id="flavor-2">
            <div class="c-prod__ingredients-section-title">BASE &amp; TEXTURE</div>
            <div class="c-prod__ing-item-wrap"><div class="c-prod__ing-item-header"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>Premium Italian Silk</span><span class="c-prod__ingredients-tag">Fiber Base</span></div></div>
            <div class="c-prod__ing-item-wrap"><div class="c-prod__ing-item-header"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>Avocado Oil</span><span class="c-prod__ingredients-tag">Coating</span></div></div>
            <div class="c-prod__ingredients-section-title">FLAVOR &amp; FRESHNESS</div>
            <div class="c-prod__ing-item-wrap"><div class="c-prod__ing-item-header"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>Papaya</span><span class="c-prod__ingredients-tag">Flavor</span></div></div>
          </div>

          <div class="c-prod__ing-tab-content js-ing-tab-content-template" id="flavor-3">
            <div class="c-prod__ingredients-section-title">BASE &amp; TEXTURE</div>
            <div class="c-prod__ing-item-wrap"><div class="c-prod__ing-item-header"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>Premium Italian Silk</span><span class="c-prod__ingredients-tag">Fiber Base</span></div></div>
            <div class="c-prod__ing-item-wrap"><div class="c-prod__ing-item-header"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>Avocado Oil</span><span class="c-prod__ingredients-tag">Coating</span></div></div>
            <div class="c-prod__ingredients-section-title">FLAVOR &amp; FRESHNESS</div>
            <div class="c-prod__ing-item-wrap"><div class="c-prod__ing-item-header"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>Black Cherry</span><span class="c-prod__ingredients-tag">Flavor</span></div></div>
          </div>

          <div class="c-prod__ingredients-negative">
            <p class="c-prod__ingredients-negative-title">WHAT'S NOT IN IT</p>
            <div class="c-prod__ingredients-negative-grid">
              <span class="c-prod__ingredients-negative-item">No Plastic</span>
              <span class="c-prod__ingredients-negative-item">No Fillers</span>
              <span class="c-prod__ingredients-negative-item">No Synthetic Coatings</span>
              <span class="c-prod__ingredients-negative-item">No Artificial Dyes</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const sectionContainer = document.querySelector(".silk-comparison-section-{{ section.id }}");
    if (!sectionContainer) return;

    // Control de Pestañas Principales
    const tabButtons = sectionContainer.querySelectorAll(".silk-tab-btn");
    const tabPanes = sectionContainer.querySelectorAll(".silk-tab-pane");

    tabButtons.forEach(button => {
      button.addEventListener("click", () => {
        const targetId = button.getAttribute("data-tab");
        tabButtons.forEach(btn => btn.classList.remove("active"));
        tabPanes.forEach(pane => pane.classList.remove("active"));
        button.classList.add("active");
        const targetPane = sectionContainer.querySelector("#" + targetId);
        if (targetPane) targetPane.classList.add("active");
      });
    });

    // Control de Hotspots
    tabPanes.forEach(pane => {
      const hotspots = pane.querySelectorAll(".silk-hotspot-point");
      const contentBoxes = pane.querySelectorAll(".silk-hotspot-content-box");

      hotspots.forEach(hotspot => {
        hotspot.addEventListener("click", () => {
          const targetInfoId = hotspot.getAttribute("data-target");
          hotspots.forEach(h => h.classList.remove("active"));
          contentBoxes.forEach(box => box.classList.remove("active"));
          hotspot.classList.add("active");
          const targetBox = pane.querySelector("#" + targetInfoId);
          if (targetBox) targetBox.classList.add("active");
        });
      });
    });

    // Control del Modal de Ingredientes
    const modal = sectionContainer.querySelector("[data-ingredients-modal]");
    const openBtn = sectionContainer.querySelector(".js-open-ingredients-modal");
    const closeElements = sectionContainer.querySelectorAll("[data-ingredients-close]");

    if (openBtn && modal) {
      openBtn.addEventListener("click", () => {
        modal.style.display = "flex";
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      });
    }

    closeElements.forEach(el => {
      el.addEventListener("click", () => {
        if (modal) {
          modal.style.display = "none";
          modal.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }
      });
    });

    // Pestañas de Sabores dentro del Modal
    const flavorBtns = sectionContainer.querySelectorAll(".c-prod__ing-tab-btn");
    const flavorContents = sectionContainer.querySelectorAll(".c-prod__ing-tab-content");

    flavorBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const targetFlavor = btn.getAttribute("data-target");
        flavorBtns.forEach(b => b.classList.remove("is-active"));
        flavorContents.forEach(c => c.classList.remove("is-active"));

        btn.classList.add("is-active");
        const targetContent = sectionContainer.querySelector("#" + targetFlavor);
        if (targetContent) targetContent.classList.add("is-active");
      });
    });
  });
</script>

<style>
  .silk-comparison-section-{{ section.id }} {
    width: 100%;
    padding: {{ section.settings.section_padding_desktop }}px 20px;
    background-color: {{ section.settings.background_color }};
    font-family: 'Raleway', sans-serif;
  }

  .silk-comparison-container {
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    gap: 60px;
    align-items: flex-start;
    justify-content: space-between;
  }

  /* Columna Izquierda */
  .silk-left-column {
    flex: 1;
    max-width: 520px;
    text-align: left;
  }

  .silk-main-title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_desktop }}px;
    font-weight: 400;
    line-height: 120%;
    margin-bottom: 20px;
    text-align: left;
  }

  .silk-main-title strong, .silk-main-title b {
    font-weight: 700;
  }

  .silk-main-description {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.desc_size_desktop }}px;
    font-weight: 400;
    line-height: 140%;
    margin-bottom: 16px;
    text-align: left;
  }

  .silk-ingredients-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ section.settings.title_color }};
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    margin-bottom: 30px;
    letter-spacing: 0.5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  /* Caja Blanca de Ingredientes con Etiqueta Centrada */
  .silk-ingredients-box {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 30px;
    position: relative;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    text-align: left;
    margin-top: 20px;
  }

  .silk-box-tag {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: #002C41;
    color: #FFF;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 20px;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .silk-ingredient-row {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid #EBF0F3;
    text-align: left;
  }

  .silk-ingredient-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .silk-ingredient-row:first-child {
    padding-top: 10px;
  }

  .silk-ing-number {
    font-size: {{ section.settings.box_num_size_desktop }}px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    min-width: 80px;
    line-height: 110%;
  }

  .silk-ing-content h4 {
    font-size: {{ section.settings.box_title_size_desktop }}px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0 0 4px 0;
    text-align: left;
  }

  .silk-ing-content p {
    font-size: {{ section.settings.box_desc_size_desktop }}px;
    font-weight: 400;
    color: {{ section.settings.text_color }};
    margin: 0;
    line-height: 130%;
    text-align: left;
  }

  /* Columna Derecha (Tabs y Hotspots) */
  .silk-right-column {
    flex: 1;
    background: #FFFFFF;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
    max-width: 580px;
  }

  .silk-tabs-nav {
    display: flex;
    background: #F4F6F8;
    padding: 6px;
    border-radius: 40px;
    margin-bottom: 30px;
    gap: 6px;
  }

  .silk-tab-btn {
    flex: 1;
    background: transparent;
    border: none;
    padding: 14px 20px;
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    text-transform:uppercase;
    font-weight: 700;
    color: #555;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
  }

  .silk-tab-btn.active {
    background: #002C41;
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(0,44,65,0.2);
  }

  .silk-tab-pane {
    display: none;
  }

  .silk-tab-pane.active {
    display: block;
    animation: fadeInSilk 0.4s ease;
  }

  @keyframes fadeInSilk {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .silk-hotspot-image-container {
    position: relative;
    width: 100%;
    margin-bottom: 24px;
    border-radius: 12px;
    overflow: hidden;
  }

  .silk-tab-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }

  .silk-hotspot-point {
    position: absolute;
    left: var(--desktop-x);
    top: var(--desktop-y);
    transform: translate(-50%, -50%);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: transform 0.2s ease;
  }

  .silk-hotspot-point:hover {
    transform: translate(-50%, -50%) scale(1.15);
  }

  .silk-hotspot-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 3px solid #FFFFFF;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    display: block;
    transition: all 0.3s ease;
  }

  .silk-hotspot-point.active .silk-hotspot-dot {
    width: 18px;
    height: 18px;
    box-shadow: 0 0 0 4px rgba(255,255,255,0.4), 0 4px 12px rgba(0,0,0,0.4);
  }

  .silk-hotspot-content-box {
    display: none;
  }

  .silk-hotspot-content-box.active {
    display: block;
    animation: fadeInSilk 0.3s ease;
  }

  .silk-tab-text-card {
    background: #F0F5F7;
    border-radius: 12px;
    padding: 22px;
    margin-bottom: 24px;
    text-align: left;
  }

  .silk-card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .silk-bullet-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .silk-tab-text-card h3 {
    font-size: {{ section.settings.card_title_size_desktop }}px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0;
    text-align: left;
  }

  .silk-tab-text-card p {
    font-size: {{ section.settings.card_desc_size_desktop }}px;
    font-weight: 400;
    color: {{ section.settings.text_color }};
    margin: 0;
    line-height: 140%;
    text-align: left;
  }

  .silk-checklist {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }

  .silk-checklist p, .silk-checklist ul {
    margin: 0;
    font-size: {{ section.settings.checklist_size_desktop }}px;
    color: {{ section.settings.text_color }};
    line-height: 140%;
    text-align: left;
  }

  .silk-checklist ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .silk-checklist li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    text-align: left;
  }

  /* ESTILOS EXACTOS DEL POPUP DE INGREDIENTES */
  .c-prod__ingredients-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .c-prod__ingredients-modal[aria-hidden="true"] {
    display: none !important;
  }

  .c-prod__ingredients-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1;
  }

  .c-prod__ingredients-modal-card {
    position: relative;
    background: #FFFFFF;
    width: 90%;
    max-width: 520px;
    max-height: 85vh;
    overflow-y: auto;
    border-radius: 16px;
    padding: 32px;
    z-index: 2;
    box-shadow: 0 15px 50px rgba(0,0,0,0.25);
    text-align: left;
    box-sizing: border-box;
  }

  .c-prod__ingredients-modal-close {
    position: absolute;
    top: 18px;
    right: 20px;
    background: none;
    border: none;
    font-size: 26px;
    cursor: pointer;
    color: #333;
    line-height: 1;
    padding: 0;
  }

  .c-prod__ingredients-modal-subtitle {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #777;
    margin: 0 0 6px 0;
    letter-spacing: 0.5px;
    text-align: left;
  }

  .c-prod__ingredients-modal-title {
    font-size: 22px;
    font-weight: 700;
    color: #002C41;
    margin: 0 0 20px 0;
    text-align: left;
  }

  .c-prod__ingredients-flavors {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }

  .c-prod__ing-tab-btn {
    flex: 1;
    padding: 10px 8px;
    border-radius: 10px;
    border: 1px solid var(--flavor-border-color);
    background: transparent;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: all 0.2s ease;
    color: #333;
  }

  .c-prod__ing-tab-btn.is-active {
    background: var(--flavor-bg-color);
  }

  .c-prod__ing-tab-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .c-prod__ing-tab-content {
    display: none;
  }

  .c-prod__ing-tab-content.is-active {
    display: block;
  }

  .c-prod__ingredients-section-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #888;
    margin: 16px 0 10px 0;
    letter-spacing: 0.5px;
    text-align: left;
  }

  .c-prod__ing-item-wrap {
    padding: 10px 0;
    border-bottom: 1px solid #f2f2f2;
  }

  .c-prod__ing-item-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    color: #222;
    text-align: left;
  }

  .c-prod__ingredients-name {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: left;
  }

  .c-prod__ingredients-bullet {
    width: 6px;
    height: 6px;
    background: #002C41;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .c-prod__ingredients-tag {
    font-size: 12px;
    color: #666;
    font-weight: 400;
  }

  .c-prod__ingredients-negative {
    margin-top: 24px;
    background: #F8F9FA;
    padding: 16px;
    border-radius: 12px;
    text-align: left;
  }

  .c-prod__ingredients-negative-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #666;
    margin: 0 0 10px 0;
    letter-spacing: 0.5px;
    text-align: left;
  }

  .c-prod__ingredients-negative-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .c-prod__ingredients-negative-item {
    background: #FFFFFF;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #444;
    border: 1px solid #E5E9EC;
  }

  /* Responsive Mobile: Forzar alineación a la izquierda */
  @media screen and (max-width: 992px) {
    .silk-comparison-container {
      flex-direction: column;
      gap: 40px;
    }

    .silk-left-column, .silk-right-column {
      max-width: 100%;
      width: 100%;
      text-align: left !important;
    }

    .silk-right-column {
      padding: 20px;
    }

    .silk-main-title {
      font-size: {{ section.settings.title_size_mobile }}px;
      text-align: left !important;
    }

    .silk-main-description {
      font-size: {{ section.settings.desc_size_mobile }}px;
      text-align: left !important;
    }

    .silk-ing-number {
      font-size: {{ section.settings.box_num_size_mobile }}px;
      text-align: left !important;
    }

    .silk-ing-content h4 {
      font-size: {{ section.settings.box_title_size_mobile }}px;
      text-align: left !important;
    }

    .silk-ing-content p {
      font-size: {{ section.settings.box_desc_size_mobile }}px;
      text-align: left !important;
    }

    .silk-tab-text-card h3 {
      font-size: {{ section.settings.card_title_size_mobile }}px;
      text-align: left !important;
    }

    .silk-tab-text-card p {
      font-size: {{ section.settings.card_desc_size_mobile }}px;
      text-align: left !important;
    }

    .silk-checklist p, .silk-checklist ul, .silk-checklist li {
      font-size: {{ section.settings.checklist_size_mobile }}px;
      text-align: left !important;
    }

    .silk-ingredients-link {
      display: inline-flex;
      justify-content: flex-start;
      text-align: left !important;
    }

    .silk-hotspot-point {
      left: var(--mobile-x);
      top: var(--mobile-y);
    }

    .c-prod__ingredients-modal-card {
      width: 95%;
      padding: 24px 20px;
    }
