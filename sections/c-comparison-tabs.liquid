/* =========================================
   DISEÑO V2 — valores del nodo de Figma
   ========================================= */
{%- if section.settings.design_v2 -%}
.silk-comparison-section-{{ section.id }}.silk--v2 { padding: 64px 0; background: #F7F7F7; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-comparison-container { max-width: 1440px; padding: 0 64px; gap: 0; justify-content: space-between; align-items: center; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-left-column { width: auto; max-width: none; flex: 0 1 47.6372%; display: flex; flex-direction: column; gap: 16px; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-right-column { box-shadow: none; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-main-title { font-size: 32px; font-weight: 600; line-height: 1.2; color: #002C41; margin: 0; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-main-description { font-size: 16px; font-weight: 400; line-height: 1.2; color: #231F20; margin: 0; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-main-description p { margin: 0; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-ingredients-link {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  padding: 12px 0; border: 0; border-radius: 0;
  font-size: 12px; font-weight: 700; text-transform: uppercase; text-decoration: underline; color: #002C41;
  align-self: flex-start;
}
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-ingredients-box { padding: 24px; border-radius: 8px; background: #FFFFFF; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-ingredient-items { display: flex; flex-direction: column; gap: 16px; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-ingredient-row { gap: 10px; padding: 0; align-items: center; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-ingredient-row + .silk-ingredient-row { border-top: 1px solid #D6ECE6; padding-top: 16px; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-ing-number { font-size: 32px; font-weight: 600; line-height: 1.2; color: #002C41; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-ing-content h4 { font-size: 16px; font-weight: 700; line-height: 1.2; color: #002C41; margin: 0; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-ing-content p { font-size: 16px; font-weight: 400; line-height: 1.2; color: #002C41; margin: 0; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-box-tag {
  padding: 4px 24px; border-radius: 99px; background: #002C41; color: #FFFFFF;
  font-size: 14px; font-weight: 700; text-transform: uppercase;
}
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-right-column { width: auto; max-width: none; flex: 0 1 45.2744%; padding: 24px; border-radius: 12px; background: #FFFFFF; display: flex; flex-direction: column; gap: 12px; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-tabs-nav { background: #F7F7F7; border-radius: 54px; padding: 0; gap: 0; justify-content: space-between; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-tab-btn {
  flex: 1 1 0; height: 52px; padding: 16px 24px; border-radius: 54px;
  font-size: 14px; font-weight: 700; text-transform: uppercase; background: #F7F7F7; color: #002C41;
}
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-tab-btn.active { background: #002C41; color: #D6ECE6; box-shadow: none; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-hotspot-image-container,
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-tab-image { height: 167px; border-radius: 12px; }
.silk-comparison-section-{{ section.id }} .silk-image-caption {
  position: absolute; transform: translate(-50%, -50%); max-width: 174px;
  font-size: 14px; line-height: 1.2; color: #002C41; text-align: center; pointer-events: none; z-index: 2;
}
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-image-caption { font-size: 14px; }
@media (max-width: 899px) {
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-image-caption { font-size: 12px; max-width: 174px; }
}
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-hotspot-dot { width: 12px; height: 12px; border-width: 6px; border-color: rgba(255,255,255,0.66); }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-tab-text-card { padding: 12px 24px; border-radius: 8px; background: rgba(214, 236, 230, 0.44); }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-card-header { gap: 8px; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-bullet-dot { width: 12px; height: 12px; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-card-header h3 { font-size: 18px; font-weight: 400; line-height: 1.2; color: #000000; margin: 0; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-tab-text-card p { font-size: 14px; font-weight: 400; line-height: 1.2; color: #000000; margin: 8px 0 0; }
.silk-comparison-section-{{ section.id }}.silk--v2 .silk-checklist { gap: 8px; font-size: 16px; line-height: 1.2; color: #000000; }

/* el CSS base apila las columnas a <=992; el v2 mantiene el layout del nodo desde 900
   para que las 7 secciones de la PDP cambien a mobile en el mismo ancho */
@media (min-width: 900px) {
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-comparison-container { flex-direction: row; gap: 0; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-left-column { width: auto; max-width: none; flex: 0 1 47.6372%; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-right-column { width: auto; max-width: none; flex: 0 1 45.2744%; padding: 24px; }
}

@media (max-width: 899px) {
  .silk-comparison-section-{{ section.id }}.silk--v2 { padding: 32px 0; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-comparison-container { padding: 0 32px; gap: 44px; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-left-column { width: auto; flex: 1 1 auto; gap: 12px; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-main-title { font-size: 20px; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-main-description { font-size: 14px; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-right-column { width: auto; flex: 1 1 auto; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-tab-btn { height: auto; padding: 8px 24px; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-card-header h3 { font-size: 16px; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-tab-text-card p { font-size: 12px; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-checklist { font-size: 12px; }

  /* valores del nodo mobile 4454:16753 */
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-main-description p + p { margin-top: 12px; }
  /* en mobile el link es texto subrayado, sin pill */
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-ingredients-link {
    border: 0; border-radius: 0; padding: 12px 0; justify-content: flex-start; margin-bottom: 0;
  }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-ingredients-box { margin-top: 0; }
  /* el tab del nodo es una sola linea de 28px de alto */
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-tab-btn {
    display: flex; align-items: center; justify-content: center; height: 28px; padding: 0 8px;
  }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-tabs-nav { margin-bottom: 0; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-right-column { min-width: 0; }
  /* en el nodo la caja del checklist mide 310 y desborda los 300 de la tarjeta,
     que es lo que la deja en 4 lineas en vez de 5 */
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-checklist { gap: 0; width: 310px; max-width: none; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-box-tag { display: none; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-ing-number { font-size: 20px; min-width: 0; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-ing-content h4 { font-size: 14px; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-ing-content p { font-size: 14px; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-tab-btn { font-size: 10px; line-height: 1.2; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-bullet-dot { flex-shrink: 0; }
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-checklist p,
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-checklist li { font-size: 12px; line-height: 1.2; color: #000000; }
  /* el caption se ancla arriba a la izquierda de la imagen, no centrado */
  .silk-comparison-section-{{ section.id }}.silk--v2 .silk-image-caption {
    left: 15px !important; top: 2px !important; transform: none !important; text-align: left;
  }
}
{%- endif -%}
</style>

