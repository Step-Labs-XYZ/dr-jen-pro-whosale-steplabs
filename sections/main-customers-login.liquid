{%- capture status -%}
  {%- form 'recover_customer_password' -%}
    {%- if form.posted_successfully? -%}
      {%- assign is_recover_posted_successfully = true -%}
    {%- else -%}
      {%- assign is_recover_posted_successfully = false -%}
    {%- endif -%}
  {%- endform -%}
{%- endcapture -%}

{%- comment -%}
  Reorder sign-in (Figma node 6396-6026): when the URL carries a return_url to the
  reorder page, the page switches to the reorder copy and look before it paints, and
  the login form sends the customer back there. Any other sign-in is unchanged.
{%- endcomment -%}
<script>
  (function () {
    var ret = new URLSearchParams(window.location.search).get('return_url') || '';
    if (ret.charAt(0) === '/' && ret.indexOf('reorder') !== -1) {
      document.documentElement.classList.add('c-login-reorder');
      window.cLoginReturnUrl = ret;
    }
  })();
</script>
<style>
  .c-login__reorder-head,
  .c-login__apply { display: none; }
  .c-login-reorder #login-form-container > .page-header:not(.c-login__reorder-head),
  .c-login-reorder .c-login__new-customer { display: none; }
  .c-login-reorder .c-login__reorder-head { display: block; }
  .c-login-reorder .c-login__apply { display: inline-block; }
  .c-login-reorder .shopify-section--main-customers-login .container { max-width: 552px; }
  .c-login-reorder .c-login__reorder-head .page-header__text-wrapper { margin: 0; text-align: left; }
  .c-login__eyebrow { margin: 0 0 4px; color: #002c41; font: italic 400 16px/1.2 Raleway, sans-serif; }
  .c-login-reorder .c-login__reorder-head h1 { margin: 0 0 4px; color: #002c41; font: 600 32px/1.2 Raleway, sans-serif; }
  .c-login-reorder .c-login__reorder-head p { margin: 0; color: #000; font: 400 18px/1.2 Raleway, sans-serif; }
  .c-login-reorder .page-content--small { max-width: 504px; margin-left: 0; }
  /* label above a pill field, "Forgot password?" on the label row */
  .c-login-reorder .shopify-section--main-customers-login .input { position: relative; display: flex; flex-direction: column-reverse; gap: 4px; margin-bottom: 12px; }
  .c-login-reorder .shopify-section--main-customers-login .input__label {
    position: static;
    padding: 0;
    background: none;
    color: #000;
    font: 400 14px/1.2 Raleway, sans-serif;
    transform: none;
    pointer-events: auto;
  }
  .c-login-reorder .shopify-section--main-customers-login .input__field {
    height: 39px;
    padding: 0 24px;
    border: 1px solid #707170;
    border-radius: 44px;
    background: #fff;
    font: 400 14px Raleway, sans-serif;
  }
  .c-login-reorder .shopify-section--main-customers-login .input__field-link {
    position: absolute;
    top: 0;
    right: 0;
    color: #0862df;
    font: 400 14px/1.2 Raleway, sans-serif;
    transform: none;
  }
  .c-login-reorder .shopify-section--main-customers-login .form__submit {
    min-height: 39px;
    border-radius: 44px;
    background: #0862df;
    color: #f7f7f7;
    font: 700 14px/1.2 Raleway, sans-serif;
    text-transform: uppercase;
    box-shadow: 0 2px 6px rgba(0, 44, 65, .12);
  }
  .c-login-reorder .c-login__apply {
    margin-top: 12px;
    color: #0862df;
    font: 700 12px/1.2 Raleway, sans-serif;
    text-decoration: underline;
    text-transform: uppercase;
  }
  @media (min-width: 990px) {
    .c-login-reorder .c-login__reorder-head h1 { font-size: 40px; }
    .c-login-reorder .c-login__reorder-head p { font-size: 20px; }
  }
  /* theme.css styles #login-form-container with ids and !important (white card,
     grey fields, orange button): same weight here, reorder mode only */
  html.c-login-reorder #login-form-container .account__block-list { padding: 0; border-radius: 0; background: none; box-shadow: none; }
  html.c-login-reorder #login-form-container .page-header__text-wrapper.text-container { margin-bottom: 12px !important; }
  html.c-login-reorder #login-form-container .c-login__reorder-head .c-login__eyebrow { margin: 0 0 4px; font-size: 16px; font-style: italic; }
  html.c-login-reorder #login-form-container .c-login__reorder-head p:not(.c-login__eyebrow) { margin: 4px 0 0; font-size: 18px; }
  html.c-login-reorder #login-form-container .input input { border: 1px solid #707170; background: #fff; }
  html.c-login-reorder #login-form-container .input .input__label { color: #000; background: transparent !important; background-color: transparent !important; }
  html.c-login-reorder #login-form-container .form__submit { background-color: #0862df !important; color: #f7f7f7; letter-spacing: 0; text-transform: uppercase; }
  html.c-login-reorder .shopify-section--main-customers-login > section { padding-top: 24px; padding-bottom: 40px; }
  @media (min-width: 990px) {
    html.c-login-reorder .shopify-section--main-customers-login > section { padding-top: 64px; padding-bottom: 64px; }
  }
  @media (min-width: 990px) {
    html.c-login-reorder #login-form-container .c-login__reorder-head p:not(.c-login__eyebrow) { font-size: 20px; }
  }
</style>

<section>
  <div class="container">
    {%- comment -%}
    --------------------------------------------------------------------------------------------------------------------
    CUSTOMER LOGIN FORM
    --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    <div id="login-form-container">
      <div class="page-header c-login__reorder-head">
        <div class="page-header__text-wrapper text-container">
          {%- if section.settings.reorder_eyebrow != blank -%}<p class="c-login__eyebrow">{{ section.settings.reorder_eyebrow }}</p>{%- endif -%}
          <h1>{{ section.settings.reorder_title }}</h1>
          <p>{{ section.settings.reorder_text }}</p>
        </div>
      </div>
      <div class="page-header">
        <div class="page-header__text-wrapper text-container">
          <h1 class="heading h2">{{ 'customer.login.title' | t }}</h1>
          <p>{{ 'customer.login.instructions' | t }}</p>
        </div>
      </div>

      <div class="page-content page-content--small">
        <div class="account__block-list">
          {%- for block in section.blocks -%}
            <div class="account__block-item" {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when '@app' -%}
                  {%- render block -%}

                {%- when 'liquid' -%}
                  {{- block.settings.liquid -}}

                {%- when 'login' -%}
                  {%- form 'customer_login', name: 'login', class: 'form' -%}
                    {%- if form.errors -%}
                      <div class="banner banner--error form__banner" id="login-form-error">
                        <span class="banner__ribbon">{% render 'icon' with 'form-error' %}</span>
                        <p class="banner__content">{{ form.errors.messages['form'] }}</p>
                      </div>
                    {%- endif -%}

                    <div class="input">
                      <input type="email" id="customer[email]" autocomplete="email" class="input__field" name="customer[email]" required="required" {% if form.errors %}aria-invalid="true" aria-describedby="login-form-error"{% endif %}>
                      <label for="customer[email]" class="input__label">{{ 'customer.login.email' | t }}</label>
                    </div>

                    <div class="input">
                      <input type="password" id="customer[password]" class="input__field" name="customer[password]" required="required" autocomplete="current-password" {% if form.errors %}aria-invalid="true" aria-describedby="login-form-error"{% endif %}>
                      <label for="customer[password]" class="input__label">{{ 'customer.login.password' | t }}</label>

                      <button type="button" class="input__field-link link text--xsmall text--subdued" data-action="switch-login-form">{{ 'customer.login.forgot_password' | t }}</button>
                    </div>

                    <input type="hidden" name="return_url" value="" data-c-login-return>
                    <script>
                      (function () {
                        var input = document.currentScript.previousElementSibling;
                        if (window.cLoginReturnUrl) input.value = window.cLoginReturnUrl;
                        else input.remove();
                      })();
                    </script>

                    <button type="submit" class="form__submit button button--primary button--full">{{ 'customer.login.submit' | t }}</button>

                    {%- if section.settings.apply_label != blank -%}
                      <a class="c-login__apply" href="{{ section.settings.apply_url | default: '/pages/wholesale-registration' }}">{{ section.settings.apply_label }}</a>
                    {%- endif -%}

                    <span class="form__secondary-action text--subdued c-login__new-customer">
                      {{- 'customer.login.new_customer' | t -}}
                      <a href="{{ routes.account_register_url }}" class="link">{{ 'customer.login.create_account' | t }}</a>
                    </span>
                  {%- endform -%}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%}
    --------------------------------------------------------------------------------------------------------------------
    CUSTOMER RECOVERY FORM
    --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    <div id="recover-form-container" style="display: none">
      <div class="page-header">
        <div class="page-header__text-wrapper text-container">
          <h1 class="heading h2">{{ 'customer.recover_password.title' | t }}</h1>

          {%- unless is_recover_posted_successfully -%}
            <p>{{ 'customer.recover_password.instructions' | t }}</p>
          {%- endunless -%}
        </div>
      </div>

      <div class="page-content page-content--small">
        {%- form 'recover_customer_password', name: 'recover', class: 'form' -%}
          {%- if form.errors -%}
            <div class="banner banner--error form__banner" id="recovery-form-error">
              <span class="banner__ribbon">{% render 'icon' with 'form-error' %}</span>
              <p class="banner__content">{{ form.errors.messages['form'] }}</p>
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <div class="banner banner--success form__banner">
              <span class="banner__ribbon">{% render 'icon' with 'form-success' %}</span>
              <p class="banner__content">{{ 'customer.recover_password.success' | t }}</p>
            </div>
          {%- else -%}
            <div class="input">
              <input type="email" id="customer[recover_email]" class="input__field" name="email" required="required" {% if form.errors %}aria-invalid="true" aria-describedby="recovery-form-error"{% endif %}>
              <label for="customer[recover_email]" class="input__label">{{ 'customer.recover_password.email' | t }}</label>
            </div>

            <button type="submit" is="loader-button" class="form__submit button button--primary button--full">{{ 'customer.recover_password.submit' | t }}</button>
          {%- endif -%}

          {%- unless form.posted_successfully? -%}
            <span class="form__secondary-action text--subdued">
              {{- 'customer.recover_password.remember_password' | t -}}
              <button type="button" class="link" data-action="switch-login-form">{{ 'customer.recover_password.back_to_login' | t }}</button>
            </span>
          {%- endunless -%}
        {%- endform -%}
      </div>
    </div>
  </div>




  <script>
    // The script for this is very minimal so we just embed it here
    window.addEventListener('DOMContentLoaded', () => {
      const loginFormElement = document.getElementById('login-form-container'),
        recoverFormElement = document.getElementById('recover-form-container');

      const switchForms = () => {
        loginFormElement.style.display = (window.getComputedStyle(loginFormElement).display) === 'block' ? 'none' : 'block';
        recoverFormElement.style.display = (window.getComputedStyle(recoverFormElement).display) === 'block' ? 'none' : 'block';
      }

      {% if is_recover_posted_successfully %}
        switchForms();
      {% else %}
        if (window.location.hash === '#recover') {
          switchForms();
        }
      {% endif %}

      Array.from(document.querySelectorAll('[data-action="switch-login-form"]')).forEach((button) => {
        button.addEventListener('click', () => switchForms());
      });
    });
  </script>


<script>
  function setCookie(cname, cvalue, exdays) {
        var d = new Date();
        d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
        var expires = "expires=" + d.toUTCString();
        document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
      }
      function getCookie(cname) {
        var name = cname + "=";
        var decodedCookie = decodeURIComponent(document.cookie);
        var ca = decodedCookie.split(';');
        for (var i = 0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) == ' ') {
            c = c.substring(1);
            }
            if (c.indexOf(name) == 0) {
            return c.substring(name.length, c.length);
            }
        }
        return "";
      }
      {% unless customer %}
      
          setCookie('_firstlogin','false', 0.02);

      {% endunless %}

</script>
</section>



{% schema %}
{
  "name": "Customer login",
  "class": "shopify-section--main-customers-login",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reorder sign-in: used when the URL has a return_url to the reorder page (Reorder links, C Reorder section)."
    },
    { "type": "text", "id": "reorder_eyebrow", "label": "Reorder eyebrow", "default": "Dr. Jen · Dental professionals" },
    { "type": "text", "id": "reorder_title", "label": "Reorder title", "default": "Sign in to reorder" },
    { "type": "text", "id": "reorder_text", "label": "Reorder text", "default": "Access your practice's previous orders." },
    { "type": "text", "id": "apply_label", "label": "Apply link label", "default": "New practice? Apply for wholesale access" },
    { "type": "url", "id": "apply_url", "label": "Apply link" }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "liquid",
      "name": "Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "liquid",
          "label": "Liquid",
          "info": "Add app snippets or other Liquid code to create advanced customizations."
        }
      ]
    },
    {
      "type": "login",
      "name": "Login form",
      "limit": 1
    }
  ]
}
{% endschema %}