{%- comment -%}
  Section: Dr.Jen Difference Premium NHAp
  Description: Comparison layout with left tooth comparison and right material images.
  sl-id: sl-section-drjen-difference-premium-nhap-v1
{%- endcomment -%}

{%- style -%}
  #c-drjen-diff-{{ section.id }} {
    --c-bg: {{ section.settings.bg_color }};
    --c-title: {{ section.settings.title_color }};
    --c-subtitle: {{ section.settings.subtitle_color }};
    --c-text: {{ section.settings.text_color }};
    --c-label-bg: {{ section.settings.label_bg_color }};
    --c-label-text: {{ section.settings.label_text_color }};

    background: var(--c-bg);
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 16px;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__title {
    margin: 0 0 22px;
    color: var(--c-title);
    text-align: center;
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: {{ section.settings.title_weight }};
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.mobile_gap }}px;
    align-items: stretch;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__left {
    padding: 4px 0;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__subtitle {
    margin: 0 0 16px;
    color: var(--c-subtitle);
    font-size: {{ section.settings.subtitle_size_mobile }}px;
    font-weight: {{ section.settings.subtitle_weight }};
    line-height: 1.25;
    text-align: center;
    max-width: {{ section.settings.subtitle_max_width_mobile }}px;
    margin-left: auto;
    margin-right: auto;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__teeth {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 16px;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__tooth-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__tooth-media {
    width: 100%;
    max-width: 130px;
    aspect-ratio: 0.9;
    min-height: 120px;
    overflow: hidden;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__tooth-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__tooth-label {
    margin: 0;
    color: var(--c-title);
    text-align: center;
    font-size: {{ section.settings.tooth_label_size_mobile }}px;
    font-weight: {{ section.settings.tooth_label_weight }};
    line-height: 1.25;
    max-width: {{ section.settings.tooth_label_max_width_mobile }}px;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__desc {
    color: var(--c-text);
    line-height: 1.45;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__desc p {
    font-size: {{ section.settings.body_size_mobile }}px;
    font-weight: {{ section.settings.body_weight }};
    margin: 0 0 10px;
    max-width: {{ section.settings.body_primary_max_width_mobile }}px;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__desc p:last-child {
    font-size: {{ section.settings.body_secondary_size_mobile }}px;
    font-weight: {{ section.settings.body_secondary_weight }};
    max-width: {{ section.settings.body_secondary_max_width_mobile }}px;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__desc p:last-child {
    margin-bottom: 0;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__desc strong {
    font-weight: inherit;
    color: var(--c-title);
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__right-group {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__right {
    min-width: 0;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__image-card {
    position: relative;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    background: #f5f5f5;
    min-height: {{ section.settings.image_height_mobile }}px;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__image {
    width: 100%;
    height: {{ section.settings.image_height_mobile }}px;
    object-fit: cover;
    display: block;
  }

  #c-drjen-diff-{{ section.id }} .c-drjen-diff__badge {
    position: absolute;
    left: 50%;
    bottom: 12px;
    transform: translateX(-50%);
    background: var(--c-label-bg);
    color: var(--c-label-text);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: {{ section.settings.badge_size_mobile }}px;
    font-weight: {{ section.settings.badge_weight }};
    line-height: 1.2;
    text-align: center;
    min-width: 130px;
    max-width: {{ section.settings.badge_max_width_mobile }}px;
  }

  @media (min-width: 768px) {
    #c-drjen-diff-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__container {
      padding: 0 24px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__title {
      margin-bottom: 30px;
      font-size: {{ section.settings.title_size_tablet }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: {{ section.settings.desktop_gap }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__left {
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100%;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__subtitle {
      font-size: {{ section.settings.subtitle_size_tablet }}px;
      margin-bottom: 20px;
      max-width: {{ section.settings.subtitle_max_width_desktop }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__tooth-media {
      max-width: 150px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__tooth-label {
      font-size: {{ section.settings.tooth_label_size_tablet }}px;
      max-width: {{ section.settings.tooth_label_max_width_desktop }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__desc {
      line-height: 1.5;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__desc p {
      font-size: {{ section.settings.body_size_tablet }}px;
      font-weight: {{ section.settings.body_weight }};
      max-width: {{ section.settings.body_primary_max_width_desktop }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__desc p:last-child {
      font-size: {{ section.settings.body_secondary_size_tablet }}px;
      font-weight: {{ section.settings.body_secondary_weight }};
      max-width: {{ section.settings.body_secondary_max_width_desktop }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__right-group {
      grid-template-columns: 1fr;
      align-self: stretch;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__image {
      height: {{ section.settings.image_height_tablet }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__image-card {
      min-height: {{ section.settings.image_height_tablet }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__badge {
      bottom: 14px;
      padding: 10px 18px;
      font-size: {{ section.settings.badge_size_tablet }}px;
      min-width: 160px;
      max-width: {{ section.settings.badge_max_width_desktop }}px;
    }
  }

  @media (min-width: 1024px) {
    #c-drjen-diff-{{ section.id }} .c-drjen-diff__right-group {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__title {
      font-size: {{ section.settings.title_size_desktop }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__subtitle {
      font-size: {{ section.settings.subtitle_size_desktop }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__tooth-label {
      font-size: {{ section.settings.tooth_label_size_desktop }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__desc p {
      font-size: {{ section.settings.body_size_desktop }}px;
      font-weight: {{ section.settings.body_weight }};
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__desc p:last-child {
      font-size: {{ section.settings.body_secondary_size_desktop }}px;
      font-weight: {{ section.settings.body_secondary_weight }};
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__image {
      height: {{ section.settings.image_height_desktop }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__image-card {
      min-height: {{ section.settings.image_height_desktop }}px;
    }

    #c-drjen-diff-{{ section.id }} .c-drjen-diff__badge {
      font-size: {{ section.settings.badge_size_desktop }}px;
    }
  }
{%- endstyle -%}

<section
  {% if section.settings.sl_anchor_id != blank %}id="{{ section.settings.sl_anchor_id }}"{% endif %}
  class="c-section c-drjen-difference-premium-nhap"
  data-sl-id="sl-section-drjen-difference-premium-nhap-v1"
  data-section-id="{{ section.id }}"
>
  <div id="c-drjen-diff-{{ section.id }}">
    <div class="c-drjen-diff__container">
      {%- if section.settings.title != blank -%}
        <h2 class="c-drjen-diff__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      <div class="c-drjen-diff__grid">
        <div class="c-drjen-diff__left">
          {%- if section.settings.left_subtitle != blank -%}
            <p class="c-drjen-diff__subtitle">{{ section.settings.left_subtitle | escape | newline_to_br }}</p>
          {%- endif -%}

          <div class="c-drjen-diff__teeth">
            <div class="c-drjen-diff__tooth-item">
              <div class="c-drjen-diff__tooth-media">
                {%- if section.settings.tooth_low_image != blank -%}
                  <img
                    class="c-drjen-diff__tooth-image"
                    src="{{ section.settings.tooth_low_image | image_url: width: 900 }}"
                    srcset="{{ section.settings.tooth_low_image | image_url: width: 300 }} 300w, {{ section.settings.tooth_low_image | image_url: width: 500 }} 500w, {{ section.settings.tooth_low_image | image_url: width: 900 }} 900w"
                    sizes="(min-width: 1024px) 150px, 130px"
                    alt="{{ section.settings.tooth_low_label | strip_html | escape }}"
                    loading="lazy"
                    width="{{ section.settings.tooth_low_image.width }}"
                    height="{{ section.settings.tooth_low_image.height }}"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'c-drjen-diff__tooth-image' }}
                {%- endif -%}
              </div>
              {%- if section.settings.tooth_low_label != blank -%}
                {%- assign tooth_low_label_text = section.settings.tooth_low_label | escape | newline_to_br -%}
                {%- unless tooth_low_label_text contains '<br' -%}
                  {%- assign tooth_low_label_text = tooth_low_label_text | replace: 'Low-Grade ', 'Low-Grade<br>' -%}
                {%- endunless -%}
                <p class="c-drjen-diff__tooth-label">{{ tooth_low_label_text }}</p>
              {%- endif -%}
            </div>

            <div class="c-drjen-diff__tooth-item">
              <div class="c-drjen-diff__tooth-media">
                {%- if section.settings.tooth_premium_image != blank -%}
                  <img
                    class="c-drjen-diff__tooth-image"
                    src="{{ section.settings.tooth_premium_image | image_url: width: 900 }}"
                    srcset="{{ section.settings.tooth_premium_image | image_url: width: 300 }} 300w, {{ section.settings.tooth_premium_image | image_url: width: 500 }} 500w, {{ section.settings.tooth_premium_image | image_url: width: 900 }} 900w"
                    sizes="(min-width: 1024px) 150px, 130px"
                    alt="{{ section.settings.tooth_premium_label | strip_html | escape }}"
                    loading="lazy"
                    width="{{ section.settings.tooth_premium_image.width }}"
                    height="{{ section.settings.tooth_premium_image.height }}"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'c-drjen-diff__tooth-image' }}
                {%- endif -%}
              </div>
              {%- if section.settings.tooth_premium_label != blank -%}
                <p class="c-drjen-diff__tooth-label">{{ section.settings.tooth_premium_label | escape | newline_to_br }}</p>
              {%- endif -%}
            </div>
          </div>

          {%- if section.settings.description != blank -%}
            <div class="c-drjen-diff__desc">{{ section.settings.description }}</div>
          {%- endif -%}
        </div>

        <div class="c-drjen-diff__right-group">
          <div class="c-drjen-diff__right">
            <div class="c-drjen-diff__image-card">
              {%- if section.settings.right_image_1 != blank -%}
                <img
                  class="c-drjen-diff__image"
                  src="{{ section.settings.right_image_1 | image_url: width: 1600 }}"
                  srcset="{{ section.settings.right_image_1 | image_url: width: 500 }} 500w, {{ section.settings.right_image_1 | image_url: width: 900 }} 900w, {{ section.settings.right_image_1 | image_url: width: 1200 }} 1200w, {{ section.settings.right_image_1 | image_url: width: 1600 }} 1600w"
                  sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
                  alt="{{ section.settings.right_label_1 | strip_html | escape }}"
                  loading="lazy"
                  width="{{ section.settings.right_image_1.width }}"
                  height="{{ section.settings.right_image_1.height }}"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'c-drjen-diff__image' }}
              {%- endif -%}
              {%- if section.settings.right_label_1 != blank -%}
                {%- assign right_low_label_text = section.settings.right_label_1 | escape | newline_to_br -%}
                {%- unless right_low_label_text contains '<br' -%}
                  {%- assign right_low_label_text = right_low_label_text | replace: 'Low-Grade ', 'Low-Grade<br>' | replace: 'Low- ', 'Low-<br>' -%}
                {%- endunless -%}
                <span class="c-drjen-diff__badge">{{ right_low_label_text }}</span>
              {%- endif -%}
            </div>
          </div>

          <div class="c-drjen-diff__right">
            <div class="c-drjen-diff__image-card">
              {%- if section.settings.right_image_2 != blank -%}
                <img
                  class="c-drjen-diff__image"
                  src="{{ section.settings.right_image_2 | image_url: width: 1600 }}"
                  srcset="{{ section.settings.right_image_2 | image_url: width: 500 }} 500w, {{ section.settings.right_image_2 | image_url: width: 900 }} 900w, {{ section.settings.right_image_2 | image_url: width: 1200 }} 1200w, {{ section.settings.right_image_2 | image_url: width: 1600 }} 1600w"
                  sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
                  alt="{{ section.settings.right_label_2 | strip_html | escape }}"
                  loading="lazy"
                  width="{{ section.settings.right_image_2.width }}"
                  height="{{ section.settings.right_image_2.height }}"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'c-drjen-diff__image' }}
              {%- endif -%}
              {%- if section.settings.right_label_2 != blank -%}
                <span class="c-drjen-diff__badge">{{ section.settings.right_label_2 | escape | newline_to_br }}</span>
              {%- endif -%}
            </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "C - Dr.Jen Premium NHAp",
  "tag": "section",
  "class": "c-drjen-difference-premium-nhap-wrapper",
  "settings": [
