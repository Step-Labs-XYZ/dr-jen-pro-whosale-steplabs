{%- comment -%}
  Section: C Reorder
  Wholesale reorder module (homepage + /pages/reorder). One section, four states:
    guest   - not signed in: "Reorder for my practice" goes to the reorder login with
              return_url = the reorder page.
    pending - signed in without the wholesale tag: approval message, never prices.
    empty   - approved, no orders yet.
    reorder - approved: the last order prefilled with editable pack steppers, live totals,
              then a review step (price changes, unavailable items, address) and checkout.
  Prices and stock always come from the current Shopify variant, never from the old order.
  Reorders are always one-time: no selling plan is ever sent.
  Checkout goes through /cart so the WPD wholesale app keeps handling it.
  Approval = customer tag from the theme setting (default "wholesale-customer"); this
  section only reads it, it never changes pricing, tags or approval.
  sl-id: sl-section-reorder-v1
  Figma: https://www.figma.com/design/KKzN3aGPr2Uzohtt77IFDj/Dr.-Jen?node-id=6380-17321
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign pro_tag = settings.reorder_pro_tag | default: 'wholesale-customer' | strip
  assign reorder_url = settings.reorder_page_url | default: '/pages/reorder'
  assign login_url = routes.account_login_url | append: '?return_url=' | append: reorder_url

  assign state = 'guest'
  if customer
    if customer.tags contains pro_tag
      assign last_order = customer.orders.first
      if last_order
        assign state = 'reorder'
      else
        assign state = 'empty'
      endif
    else
      assign state = 'pending'
    endif
  endif
-%}

{% style %}
  #c-reorder-{{ sid }} {
    --ro-dark: #002c41;
    --ro-blue: #0862df;
    --ro-green: #d6ece6;
    --ro-grey: #f7f7f7;
    --ro-dark-grey: #707170;
    --ro-line: #d8d8d8;
    --ro-red: #b3261e;
    padding: {{ s.pad_top_m }}px 16px {{ s.pad_bottom_m }}px;
    background: {{ s.bg_color }};
    color: #000;
    font-family: Raleway, sans-serif;
  }
  #c-reorder-{{ sid }} * { box-sizing: border-box; }
  #c-reorder-{{ sid }} .c-reorder__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 640px;
    margin: 0 auto;
  }
  #c-reorder-{{ sid }} .c-reorder__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }
  #c-reorder-{{ sid }} .c-reorder__eyebrow { margin: 0; color: var(--ro-dark); font-size: 16px; font-style: italic; line-height: 1.2; }
  #c-reorder-{{ sid }} .c-reorder__title {
    margin: 0;
    color: var(--ro-dark);
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
  }
  #c-reorder-{{ sid }} .c-reorder__title span { display: block; color: var(--ro-blue); }
  #c-reorder-{{ sid }} .c-reorder__text { margin: 0; font-size: 18px; line-height: 1.2; }
  #c-reorder-{{ sid }} .c-reorder__note { margin: 0; font-size: 14px; line-height: 1.2; text-align: center; }

  /* Buttons */
  #c-reorder-{{ sid }} .c-reorder__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 39px;
    padding: 8px 24px;
    border: 1px solid var(--ro-dark);
    border-radius: 44px;
    background: #fff;
    color: var(--ro-dark);
    font: 700 14px/1.2 Raleway, sans-serif;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 2px 12px rgba(0, 44, 65, .12);
    cursor: pointer;
  }
  #c-reorder-{{ sid }} .c-reorder__btn--primary {
    width: 100%;
    border-color: var(--ro-blue);
    background: var(--ro-blue);
    color: var(--ro-grey);
    box-shadow: 0 2px 6px rgba(0, 44, 65, .12);
  }
  #c-reorder-{{ sid }} .c-reorder__btn[disabled] { opacity: .5; cursor: not-allowed; }
  #c-reorder-{{ sid }} .c-reorder__btn:focus-visible,
  #c-reorder-{{ sid }} .c-reorder__qty button:focus-visible { outline: 2px solid var(--ro-dark); outline-offset: 2px; }
  #c-reorder-{{ sid }} .c-reorder__cta { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 100%; max-width: 504px; }
  #c-reorder-{{ sid }} .c-reorder__secondary { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  #c-reorder-{{ sid }} .c-reorder__apply {
    color: var(--ro-blue);
    font: 700 12px/1.2 Raleway, sans-serif;
    text-transform: uppercase;
    text-decoration: underline;
  }

  /* Card */
  #c-reorder-{{ sid }} .c-reorder__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    padding: 24px;
    border-radius: 12px;
    background: var(--ro-grey);
  }
  #c-reorder-{{ sid }} .c-reorder__card-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
  #c-reorder-{{ sid }} .c-reorder__card-title { margin: 0; font-size: 20px; font-weight: 400; line-height: 1.2; }
  #c-reorder-{{ sid }} .c-reorder__pill {
    padding: 4px 12px;
    border-radius: 99px;
    background: var(--ro-green);
    font-size: 14px;
    line-height: 1.2;
    white-space: nowrap;
  }
  #c-reorder-{{ sid }} .c-reorder__meta { margin: 0; color: var(--ro-dark-grey); font-size: 12px; line-height: 1.2; }
  #c-reorder-{{ sid }} .c-reorder__lines { display: grid; grid-template-columns: 1fr; gap: 12px; }
  #c-reorder-{{ sid }} .c-reorder__line {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--ro-dark-grey);
    border-radius: 12px;
    background: #fff;
  }
  #c-reorder-{{ sid }} .c-reorder__line-name {
    margin: 0;
    padding: 8px 12px;
    background: var(--ro-green);
    color: var(--ro-dark);
    font-size: 16px;
    line-height: 1.2;
  }
  #c-reorder-{{ sid }} .c-reorder__line-name strong { font-weight: 700; }
  #c-reorder-{{ sid }} .c-reorder__line-body { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px; }
  #c-reorder-{{ sid }} .c-reorder__line-info { margin: 0; font-size: 14px; line-height: 1.2; }
  #c-reorder-{{ sid }} .c-reorder__line-alert { margin: 0; padding: 0 12px 12px; color: var(--ro-red); font-size: 12px; line-height: 1.3; }
  #c-reorder-{{ sid }} .c-reorder__line.is-unavailable { opacity: .75; }
  #c-reorder-{{ sid }} .c-reorder__line.is-unavailable .c-reorder__qty { display: none; }

  /* Pack stepper */
  #c-reorder-{{ sid }} .c-reorder__qty {
    display: flex;
    flex: 0 0 auto;
    overflow: hidden;
    border: 1px solid var(--ro-line);
    border-radius: 4px;
  }
  #c-reorder-{{ sid }} .c-reorder__qty button,
  #c-reorder-{{ sid }} .c-reorder__qty input {
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    background: #fff;
    color: #000;
    font: 400 14px Raleway, sans-serif;
    text-align: center;
  }
  #c-reorder-{{ sid }} .c-reorder__qty button { cursor: pointer; font-size: 18px; line-height: 1; }
  #c-reorder-{{ sid }} .c-reorder__qty button:first-child { border-right: 1px solid var(--ro-line); }
  #c-reorder-{{ sid }} .c-reorder__qty button:last-child { border-left: 1px solid var(--ro-line); }
  #c-reorder-{{ sid }} .c-reorder__qty input { -moz-appearance: textfield; }
  #c-reorder-{{ sid }} .c-reorder__qty input::-webkit-outer-spin-button,
  #c-reorder-{{ sid }} .c-reorder__qty input::-webkit-inner-spin-button { margin: 0; -webkit-appearance: none; }

  #c-reorder-{{ sid }} .c-reorder__total {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
    border-top: 1px dashed rgba(0, 44, 65, .44);
    font-size: 14px;
    line-height: 1.2;
  }
  #c-reorder-{{ sid }} .c-reorder__total strong { font-weight: 700; }
  #c-reorder-{{ sid }} .c-reorder__device { margin: 0; font-size: 12px; line-height: 1.2; text-align: center; }
  #c-reorder-{{ sid }} .c-reorder__device a { color: inherit; }

  /* Edit + review steps: 12px between blocks, as in the design */
  #c-reorder-{{ sid }} [data-reorder-step="edit"],
  #c-reorder-{{ sid }} .c-reorder__review { display: flex; flex-direction: column; gap: 12px; }
  #c-reorder-{{ sid }} .c-reorder__meta { margin-top: -8px; }
  #c-reorder-{{ sid }} .c-reorder__review[hidden],
  #c-reorder-{{ sid }} [data-reorder-step][hidden] { display: none; }
  #c-reorder-{{ sid }} .c-reorder__rows { display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0; list-style: none; }
  #c-reorder-{{ sid }} .c-reorder__row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px;
    border-radius: 12px;
    background: #fff;
    font-size: 14px;
    line-height: 1.3;
  }
  #c-reorder-{{ sid }} .c-reorder__row small { display: block; color: var(--ro-dark-grey); font-size: 12px; }
  #c-reorder-{{ sid }} .c-reorder__row s { color: var(--ro-dark-grey); }
  #c-reorder-{{ sid }} .c-reorder__box {
    padding: 12px;
    border-radius: 12px;
    background: #fff;
    font-size: 14px;
    line-height: 1.3;
  }
  #c-reorder-{{ sid }} .c-reorder__box--warn { border: 1px solid #f0b429; background: #fff8e6; }
  #c-reorder-{{ sid }} .c-reorder__box h3 { margin: 0 0 6px; font-size: 14px; font-weight: 700; }
  #c-reorder-{{ sid }} .c-reorder__box p { margin: 0 0 6px; }
  #c-reorder-{{ sid }} .c-reorder__box p:last-child { margin: 0; }
  #c-reorder-{{ sid }} .c-reorder__box a,
  #c-reorder-{{ sid }} .c-reorder__link { color: var(--ro-blue); }
  #c-reorder-{{ sid }} .c-reorder__link { padding: 0; border: 0; background: none; font: inherit; text-decoration: underline; cursor: pointer; }
  #c-reorder-{{ sid }} .c-reorder__confirm { display: flex; align-items: flex-start; gap: 8px; margin-top: 6px; }
  #c-reorder-{{ sid }} .c-reorder__error { margin: 0; color: var(--ro-red); font-size: 14px; }
  #c-reorder-{{ sid }} .c-reorder__error:empty { display: none; }

  /* mobile: the last-order pill sits on the card's top edge, as in the design */
  @media (max-width: 989px) {
    #c-reorder-{{ sid }} .c-reorder__card { position: relative; }
    #c-reorder-{{ sid }} [data-reorder-step="edit"] .c-reorder__pill { position: absolute; top: -12px; right: 16px; }
  }

  @media (min-width: 990px) {
    #c-reorder-{{ sid }} { padding: {{ s.pad_top_d }}px 24px {{ s.pad_bottom_d }}px; }
    #c-reorder-{{ sid }} .c-reorder__title { font-size: 48px; }
    #c-reorder-{{ sid }} .c-reorder__text { font-size: 20px; }
    #c-reorder-{{ sid }} .c-reorder__card-title { font-size: 24px; }
    #c-reorder-{{ sid }} .c-reorder__lines { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #c-reorder-{{ sid }} .c-reorder__btn--primary { min-height: 33px; }
  }
{% endstyle %}

<section
  id="c-reorder-{{ sid }}"
  class="c-reorder"
  data-sl-id="sl-section-reorder-v1"
  data-section-id="{{ sid }}"
  data-reorder
  data-state="{{ state }}"
>
  {%- if s.anchor_id != blank -%}<span id="{{ s.anchor_id | escape }}"></span>{%- endif -%}
  <div class="c-reorder__inner">
    <div class="c-reorder__head">
      {%- if s.eyebrow != blank -%}<p class="c-reorder__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="c-reorder__title">{{ s.title }}<span>{{ s.title_accent }}</span></h2>
      <p class="c-reorder__text">
        {%- case state -%}
          {%- when 'reorder' -%}{{ s.text_reorder }}
          {%- when 'empty' -%}{{ s.text_empty }}
          {%- when 'pending' -%}{{ s.text_pending }}
          {%- else -%}{{ s.text_guest }}
        {%- endcase -%}
      </p>
    </div>

    {%- case state -%}
      {%- when 'guest' -%}
        {%- comment -%} Reorder flow: login first. Not in the theme editor, so the page stays editable. {%- endcomment -%}
        {%- if s.guest_redirect and request.page_type == 'page' and request.design_mode == false -%}
          <script>window.location.replace({{ login_url | json }});</script>
        {%- endif -%}
        <div class="c-reorder__cta">
          <a class="c-reorder__btn c-reorder__btn--primary" href="{{ login_url }}" data-reorder-start="module">{{ s.guest_button }}</a>
          {%- if s.guest_note != blank -%}<p class="c-reorder__note">{{ s.guest_note }}</p>{%- endif -%}
        </div>

      {%- when 'pending' -%}
        <div class="c-reorder__card">
          <h3 class="c-reorder__card-title">{{ s.pending_title }}</h3>
          <div class="c-reorder__note" style="text-align:left">{{ s.pending_body }}</div>
          <p class="c-reorder__device">{{ s.signed_in_as | replace: '[email]', customer.email }} <a href="{{ routes.account_logout_url }}?return_url={{ login_url | url_encode }}">{{ s.sign_out_label }}</a></p>
        </div>

      {%- when 'empty' -%}
        <div class="c-reorder__card">
          <h3 class="c-reorder__card-title">{{ s.empty_title }}</h3>
          <div class="c-reorder__note" style="text-align:left">{{ s.empty_body }}</div>
          <a class="c-reorder__btn c-reorder__btn--primary" href="{{ s.empty_button_url | default: '/collections/wholesale' }}">{{ s.empty_button }}</a>
        </div>

      {%- when 'reorder' -%}
        {%- liquid
          assign order_date = last_order.created_at | date: '%b %-d'
          assign ship = last_order.shipping_address | default: customer.default_address
          assign practice = ship.company | default: customer.default_address.company
        -%}
        <div class="c-reorder__card" data-reorder-card>
          {%- comment -%} Step 1: the last order, editable {%- endcomment -%}
          <div data-reorder-step="edit">
            <div class="c-reorder__card-head">
              <h3 class="c-reorder__card-title">{{ s.reorder_title }}</h3>
              <span class="c-reorder__pill">{{ s.last_order_label }} · {{ order_date }}</span>
            </div>
            <p class="c-reorder__meta">
              {{ s.order_label }} {{ last_order.name }}
              {%- if practice != blank %} · {{ practice }}{% endif -%}
              {%- if ship.city != blank %} · {{ ship.city }}{% if ship.province_code != blank %}, {{ ship.province_code }}{% endif %}{% endif -%}
            </p>

            <div class="c-reorder__lines" data-reorder-lines>
              {%- for item in last_order.line_items -%}
                {%- liquid
                  if item.original_price == 0
                    continue
                  endif
                  assign v = item.variant
                  assign units = ''
                  assign flavor = ''
                  if v
                    for value in v.options
                      if value contains 'pack' or value contains 'Case'
                        assign units = value | split: '(' | last | remove: ')' | remove: 'pack' | strip
                      else
                        unless value == 'Default Title'
                          assign flavor = value
                        endunless
                      endif
                    endfor
                  endif
                  comment
                    Short name as in the design ("Super Paste"): the product's custom.short_title
                    metafield, else the title without the brand prefix, the ™ and the "with ..." / "- 12/24" tail.
                  endcomment
                  assign name = item.product.metafields.custom.short_title.value
                  if name == blank
                    assign full_title = item.product.title | default: item.title
                    assign name = full_title | remove: 'NEW ' | remove: "Dr. Jen's " | remove: 'Dr. Jen’s ' | remove: "Dr Jen's " | remove: '™' | split: ' with ' | first | split: ' - ' | first | split: ' 12/24' | first | strip
                  endif
                  assign current_price = v.price | default: 0
                  assign available = false
                  if v and v.available and item.product.available
                    assign available = true
                  endif
                -%}
                <div
                  class="c-reorder__line{% unless available %} is-unavailable{% endunless %}"
                  data-reorder-line
                  data-variant="{{ v.id }}"
                  data-name="{{ name | escape }}"
                  data-flavor="{{ flavor | escape }}"
                  data-units="{{ units }}"
                  data-price="{{ current_price }}"
                  data-old-price="{{ item.original_price }}"
                  data-available="{{ available }}"
                  data-url="{{ item.product.url | default: item.url }}"
                  data-was-sub="{% if item.selling_plan_allocation %}true{% else %}false{% endif %}"
                >
                  <p class="c-reorder__line-name"><strong>{{ name }}</strong>{% if flavor != blank %} · {{ flavor }}{% endif %}</p>
                  <div class="c-reorder__line-body">
                    <p class="c-reorder__line-info">
                      <span data-reorder-packs>{{ item.quantity }}</span>x {% if units != blank %}{{ units }} {{ s.units_per_pack }}{% else %}{{ v.title | default: item.variant_title }}{% endif %}
                      · {{ s.one_time_label }}
                    </p>
                    <div class="c-reorder__qty">
                      <button type="button" data-reorder-minus aria-label="{{ s.decrease_label | escape }} {{ name | escape }}">−</button>
                      <input type="number" min="0" max="999" inputmode="numeric" value="{{ item.quantity }}" data-reorder-input aria-label="{{ s.packs_label | escape }} {{ name | escape }}">
                      <button type="button" data-reorder-plus aria-label="{{ s.increase_label | escape }} {{ name | escape }}">+</button>
                    </div>
                  </div>
                  {%- unless available -%}
                    <p class="c-reorder__line-alert">{{ s.unavailable_text }}</p>
                  {%- endunless -%}
                </div>
              {%- endfor -%}
            </div>

            <div class="c-reorder__total">
              <strong>{{ s.subtotal_label }}</strong>
              <span data-reorder-subtotal></span>
            </div>
            <button type="button" class="c-reorder__btn c-reorder__btn--primary" data-reorder-review>
              <span>{{ s.buy_again_label }} ·&nbsp;<span data-reorder-subtotal></span></span>
            </button>
            <p class="c-reorder__device">{{ s.signed_in_as | replace: '[email]', customer.email }} <a href="{{ routes.account_logout_url }}?return_url={{ login_url | url_encode }}">{{ s.sign_out_label }}</a></p>
          </div>

          {%- comment -%} Step 2: review {%- endcomment -%}
          <div class="c-reorder__review" data-reorder-step="review" hidden>
            <div class="c-reorder__card-head">
              <h3 class="c-reorder__card-title">{{ s.review_title }}</h3>
              <button type="button" class="c-reorder__link" data-reorder-back>{{ s.edit_label }}</button>
            </div>
            <ul class="c-reorder__rows" data-reorder-rows></ul>
            <div class="c-reorder__box c-reorder__box--warn" data-reorder-prices hidden>
              <h3>{{ s.price_change_title }}</h3>
              <p>{{ s.price_change_text }}</p>
              <label class="c-reorder__confirm">
                <input type="checkbox" data-reorder-price-ok>
                <span>{{ s.price_change_confirm }}</span>
              </label>
            </div>
            <div class="c-reorder__box c-reorder__box--warn" data-reorder-missing hidden>
              <h3>{{ s.unavailable_title }}</h3>
              <div data-reorder-missing-list></div>
            </div>
            <div class="c-reorder__box">
              <h3>{{ s.purchase_type_title }}</h3>
              <p>{{ s.purchase_type_text }}</p>
            </div>
            <div class="c-reorder__box">
              <h3>{{ s.ship_to_title }}</h3>
              {%- assign address = customer.default_address -%}
              {%- if address -%}
                <p>
                  {%- if address.company != blank -%}{{ address.company }}<br>{%- endif -%}
                  {{ address.address1 }}{% if address.address2 != blank %}, {{ address.address2 }}{% endif %}<br>
                  {{ address.city }}{% if address.province_code != blank %}, {{ address.province_code }}{% endif %} {{ address.zip }}
                </p>
              {%- else -%}
                <p>{{ s.no_address_text }}</p>
              {%- endif -%}
              <p><a href="{{ routes.account_addresses_url }}" data-reorder-keep>{{ s.change_address_label }}</a></p>
            </div>
            <p class="c-reorder__note" data-reorder-cart-note hidden></p>
            <div class="c-reorder__total">
              <strong>{{ s.subtotal_label }}</strong>
              <span data-reorder-subtotal></span>
            </div>
            <p class="c-reorder__error" data-reorder-error role="alert"></p>
            <button type="button" class="c-reorder__btn c-reorder__btn--primary" data-reorder-checkout>{{ s.checkout_label }}</button>
          </div>
        </div>

        <script type="application/json" data-reorder-config>
          {
            "orderId": {{ last_order.id | json }},
            "currency": {{ cart.currency.iso_code | json }},
            "unitsLabel": {{ s.units_per_pack | json }},
            "oneTime": {{ s.one_time_label | json }},
            "removed": {{ s.removed_label | json }},
            "viewAlternatives": {{ s.view_alternatives_label | json }},
            "alternativesUrl": {{ s.alternatives_url | default: '/collections/wholesale' | json }},
            "wasNow": {{ s.was_now_label | json }},
            "cartNote": {{ s.cart_note | json }},
            "error": {{ s.error_text | json }},
            "emptyError": {{ s.empty_error_text | json }}
          }
        </script>
    {%- endcase -%}

    {%- if s.show_secondary -%}
      <div class="c-reorder__secondary">
        {%- if s.myself_label != blank -%}<a class="c-reorder__btn" href="{{ s.myself_url | default: 'https://drjennatural.com' }}">{{ s.myself_label }}</a>{%- endif -%}
        {%- if s.samples_label != blank -%}<a class="c-reorder__btn" href="{{ s.samples_url | default: '/pages/request-samples' }}" data-reorder-samples>{{ s.samples_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if state == 'guest' and s.apply_label != blank -%}
      <a class="c-reorder__apply" href="{{ s.apply_url | default: '/pages/wholesale-registration' }}">{{ s.apply_label }}</a>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'c-reorder.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "C Reorder",
  "tag": "div",
  "class": "c-reorder-wrapper",
  "settings": [
    { "type": "paragraph", "content": "Shows the guest, pending, empty or reorder state depending on who is signed in. Prices and stock come from Shopify at page load." },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "reorder" },
