{%- if section.settings.design_v2 -%}
/* ============================================================
   DISEÑO V2 — valores tomados del nodo de Figma de la PDP.
   Solo se aplica en las plantillas que encienden "Diseño v2",
   para no mover las PDPs que siguen con el diseño anterior.
   ============================================================ */
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__main-view { border-radius: 14px; }
/* callout del nodo: gap 10 y lh 22.8 sobre 16 */
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__img-caption { gap: 10px; line-height: 1.425; }
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__desc-block { font-size: 14px; line-height: 1.2; max-width: 488px; }
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__pills { gap: 12px; }
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__pill-label {
  padding: 8px; border-radius: 4px; gap: 6px; min-height: 42px;
  border: 1px solid #002C41; color: #002C41; font-size: 12px; font-weight: 400; line-height: 1.2;
}
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__price { font-weight: 600; line-height: 1.2; }
/* wholesale: precio por unidad junto al precio en desktop, debajo en mobile */
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__per-unit { margin-left: 12px; font-size: 16px; font-weight: 400; }
@media (max-width: 899px) {
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__per-unit { display: block; margin-left: 0; }
}
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__stock,
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__reviews,
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__option-name,
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__btn-submit,
#c-prod-{{ section.id }}.c-prod--v2 .c-sub-box__title,
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__ingredients-trigger { line-height: 1.2; }
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__price-wrap { gap: 10px; }
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__stock { opacity: 0.6; }
/* el nodo dibuja dos elipses concentricas y sin animacion */
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__stock-dot {
  position: relative; width: 22px; height: 22px; animation: none;
  background-color: rgba(205, 255, 241, 0.4);
}
#c-prod-{{ section.id }}.c-prod--v2 .c-prod__stock-dot::after {
  content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 9.8px; height: 9.8px; border-radius: 50%; background-color: #CDFFF1;
