                                <svg class="htu-chevron--close" xmlns="http://www.w3.org/2000/svg" width="13" height="8" viewBox="0 0 13 8" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M5.89967 0.164719C6.11934 -0.054956 6.47544 -0.054956 6.69512 0.164719L12.43 5.89959C12.6496 6.11927 12.6496 6.47537 12.43 6.69504L12.1648 6.96024C11.9451 7.17992 11.589 7.17992 11.3693 6.96024L6.29739 1.88829L1.22544 6.96024C1.00577 7.17992 0.649665 7.17992 0.429991 6.96024L0.164791 6.69504C-0.054884 6.47537 -0.054884 6.11927 0.164791 5.89959L5.89967 0.164719Z" fill="black"/></svg>
                              </span>
                            </button>
                            <div class="htu-sub-body">
                              <p class="htu-sub-text">{{ block.settings.step_5_text }}</p>
                            </div>
                          </div>
                        </div>
                        {% endif %}

                        {% if step_6_has_content %}
                        <div class="htu-step" {% if tab_5_steps_count == 1 %}data-single-step="true"{% endif %}>
                          <div class="htu-step-left">
                            <div class="htu-num">6</div>
                            <div class="htu-line htu-line--last"></div>
                          </div>
                          <div class="htu-step-right">
                            <button class="htu-trigger" aria-expanded="{% if tab_5_steps_count == 1 %}true{% else %}false{% endif %}" type="button">
                              <div class="htu-trigger-text">
                                <span class="htu-eye">{{ block.settings.step_6_eye }}</span>
                                <span class="htu-title">{{ block.settings.step_6_title }}</span>
                              </div>
                              <span class="htu-chevron" aria-hidden="true">
                                <svg class="htu-chevron--open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.3982 15.1322C12.1785 15.3518 11.8224 15.3518 11.6027 15.1322L5.86788 9.39728C5.64821 9.17761 5.64821 8.82151 5.86788 8.60183L6.13305 8.33663C6.35271 8.11696 6.70887 8.11696 6.92854 8.33663L12.0005 13.4086L17.0724 8.33663C17.2921 8.11696 17.6482 8.11696 17.8679 8.33663L18.1331 8.60183C18.3527 8.82151 18.3527 9.17761 18.1331 9.39728L12.3982 15.1322Z" fill="black"/></svg>
                                <svg class="htu-chevron--close" xmlns="http://www.w3.org/2000/svg" width="13" height="8" viewBox="0 0 13 8" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M5.89967 0.164719C6.11934 -0.054956 6.47544 -0.054956 6.69512 0.164719L12.43 5.89959C12.6496 6.11927 12.6496 6.47537 12.43 6.69504L12.1648 6.96024C11.9451 7.17992 11.589 7.17992 11.3693 6.96024L6.29739 1.88829L1.22544 6.96024C1.00577 7.17992 0.649665 7.17992 0.429991 6.96024L0.164791 6.69504C-0.054884 6.47537 -0.054884 6.11927 0.164791 5.89959L5.89967 0.164719Z" fill="black"/></svg>
                              </span>
                            </button>
                            <div class="htu-sub-body">
                              <p class="htu-sub-text">{{ block.settings.step_6_text }}</p>
                            </div>
                          </div>
                        </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
                {%- endif -%}
              </div>

            {% when 'variant_cards' %}
              {%- assign target_option = block.settings.option_name | downcase | strip -%}
              {%- assign cards_option = nil -%}
              {%- for option in product.options_with_values -%}
                {%- assign current_option = option.name | downcase | strip -%}
                {%- if current_option == target_option -%}
                  {%- assign cards_option = option -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if cards_option == nil -%}
                {%- if product.options_with_values.size > 1 -%}
                  {%- assign cards_option = product.options_with_values[1] -%}
                {%- else -%}
                  {%- assign cards_option = product.options_with_values[0] -%}
                {%- endif -%}
              {%- endif -%}
              {%- if cards_option != nil and cards_option.values.size > 0 -%}
                <div class="c-prod__variant-group c-prod__variant-group--cards" data-cards-option-position="{{ cards_option.position }}"
                  data-desktop-columns="{{ block.settings.desktop_columns | default: '3' }}"
                  data-card-count="{{ cards_option.values.size }}"
                  {{ block.shopify_attributes }}>
                  <div class="c-prod__option-name">{{ cards_option.name }}</div>
                  <div class="c-prod__cards">
                    {%- for value in cards_option.values -%}
                      {%- assign _card_pos_idx = cards_option.position | minus: 1 -%}
                      {%- assign _card_variant = nil -%}
                      {%- for v in product.variants -%}
                        {%- if v.options[_card_pos_idx] == value -%}
                          {%- assign _card_variant = v -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- assign _card_pack_part = value | split: ' pack' | first | split: '(' | last | strip -%}
                      {%- assign _card_uc = _card_pack_part | plus: 0 -%}
                      {%- assign card_img = product.featured_image -%}
                      {%- for variant in product.variants -%}
                        {%- if variant.options contains value and variant.image -%}
                          {%- assign card_img = variant.image -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}

                      <input type="radio" class="c-prod__radio js-variant-radio-{{ section.id }}" 
                             name="option-{{ cards_option.position }}" 
                             id="card-{{ section.id }}-{{ cards_option.position }}-{{ forloop.index }}" 
                             value="{{ value | escape }}" data-position="{{ cards_option.position }}"
                             {% if cards_option.selected_value == value %}checked{% endif %}>
                      
                      <label class="c-prod__card-label" for="card-{{ section.id }}-{{ cards_option.position }}-{{ forloop.index }}">
                        {% if forloop.index == 2 and block.settings.badge_2 != blank %}
                          <div
                            class="c-prod__card-badge"
                            data-badge-default="{{ block.settings.badge_2 | escape }}"
                            data-badge-orange="{{ block.settings.badge_2_orange_mango | escape }}"
                            data-badge-tpl-default="{{ block.settings.badge_2 | escape }}"
                            data-badge-tpl-orange="{{ block.settings.badge_2_orange_mango | escape }}"
                          >{{ block.settings.badge_2 }}</div>
                        {% endif %}
                        {% if forloop.index == 3 and block.settings.badge_3 != blank %}
                          <div
                            class="c-prod__card-badge"
                            {% unless section.settings.design_v2 %}style="background:#002C41; color:#fff;"{% endunless %}
                            data-badge-default="{{ block.settings.badge_3 | escape }}"
                            data-badge-orange="{{ block.settings.badge_3_orange_mango | escape }}"
                            data-badge-tpl-default="{{ block.settings.badge_3 | escape }}"
                            data-badge-tpl-orange="{{ block.settings.badge_3_orange_mango | escape }}"
                          >{{ block.settings.badge_3 }}</div>
                        {% endif %}
                        {% if forloop.index == 4 and block.settings.badge_4 != blank %}
                          <div
                            class="c-prod__card-badge"
                            data-badge-default="{{ block.settings.badge_4 | escape }}"
                            data-badge-orange="{{ block.settings.badge_4_orange_mango | escape }}"
                            data-badge-tpl-default="{{ block.settings.badge_4 | escape }}"
                            data-badge-tpl-orange="{{ block.settings.badge_4_orange_mango | escape }}"
                          >{{ block.settings.badge_4 }}</div>
                        {% endif %}
                        {%- if _card_variant and _card_uc > 1 -%}
                          <span class="c-prod__card-per-unit js-card-per-unit-{{ section.id }}" data-card-value="{{ value | escape }}" data-cards-opt-pos="{{ cards_option.position }}" data-unit-count="{{ _card_uc }}" data-unit-label="{{ block.settings.unit_label | escape }}">{{ _card_variant.price | times: 1.0 | divided_by: _card_uc | round | money }}/{{ block.settings.unit_label }}</span>
                        {%- endif -%}
                        {%- if section.settings.design_v2 -%}
                          {%- assign _card_imgs = _card_uc -%}{%- if _card_imgs > 4 -%}{%- assign _card_imgs = 4 -%}{%- endif -%}{%- if _card_imgs < 1 -%}{%- assign _card_imgs = 1 -%}{%- endif -%}
                          <span class="c-prod__card-imgs" data-count="{{ _card_imgs }}">
                            {%- for _ci in (1.._card_imgs) -%}
                              <img src="{{ card_img | image_url: width: 150 }}" class="c-prod__card-img" alt="{{ value }}" data-default-src="{{ card_img | image_url: width: 150 }}">
                            {%- endfor -%}
                          </span>
                        {%- else -%}
                          <img src="{{ card_img | image_url: width: 150 }}" class="c-prod__card-img" alt="{{ value }}" data-default-src="{{ card_img | image_url: width: 150 }}">
                        {%- endif -%}
                        <span class="c-prod__card-name">{{ value }}</span>
                        {%- if _card_variant -%}
                          <span class="c-prod__card-price js-card-price-{{ section.id }}" data-card-value="{{ value | escape }}" data-cards-opt-pos="{{ cards_option.position }}">{{ _card_variant.price | money }}</span>
                        {%- endif -%}
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

            {% when 'product_upsell_card' %}
              {%- assign upsell_product = block.settings.product -%}
              {%- assign upsell_product_id = upsell_product.id -%}
              {%- assign upsell_variant = upsell_product.selected_or_first_available_variant -%}
              {%- assign upsell_selling_plan_allocation = upsell_variant.selling_plan_allocations | first -%}
              {%- assign upsell_selling_plan_id = '' -%}
              {%- if upsell_selling_plan_allocation != blank and upsell_selling_plan_allocation.selling_plan != blank -%}
                {%- assign upsell_selling_plan_id = upsell_selling_plan_allocation.selling_plan.id -%}
              {%- endif -%}
              <div class="c-prod__sub-offer c-prod__sub-offer--upsell" {{ block.shopify_attributes }}>
                <div class="c-prod__sub-offer-media">
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 500 }}"
                      alt="{{ block.settings.title | default: upsell_product.title | escape }}"
                      loading="lazy"
                    >
                  {%- endif -%}
                </div>
                <div class="c-prod__sub-offer-content">
                  <p class="c-prod__sub-offer-title">{{ block.settings.title }}</p>
                  <div class="c-prod__upsell-footer">
                    <div class="c-prod__upsell-meta">
                      {%- if block.settings.save_text != blank -%}
                        <p class="c-prod__sub-offer-save">{{ block.settings.save_text }}</p>
                      {%- endif -%}
                      <div class="c-prod__sub-offer-price-row">
                        <span class="c-prod__sub-offer-price">{{ block.settings.price_text }}</span>
                        {%- if block.settings.compare_price_text != blank -%}
                          <span class="c-prod__sub-offer-compare">{{ block.settings.compare_price_text }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                    {%- if upsell_variant != blank -%}
                      <div class="c-prod__upsell-action">
                        <div class="c-prod__sub-offer-cta-wrap">
                          <div
                            class="c-prod__upsell-form"
                            data-product-id="{{ upsell_product.id }}"
                            data-variant-id="{{ upsell_variant.id }}"
                            data-selling-plan-id="{{ upsell_selling_plan_id }}"
                          >
                            <button type="button" class="c-prod__sub-offer-cta c-prod__sub-offer-cta--btn js-upsell-atc-{{ section.id }}">
                              {{ block.settings.btn_text | default: 'ADD TO CART' }}
                              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
                                <path d="M0.75 6.75H16.75M16.75 6.75L10.75 0.75M16.75 6.75L10.75 12.75" stroke="#002C41" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </button>
                          </div>
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>


 {% when 'product_upsell_carousel' %}
  <div class="c-prod__upsell-carousel" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <div class="c-prod__upsell-carousel__header">
        <h2 class="c-prod__upsell-carousel__heading">{{ block.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="c-prod__upsell-carousel__track-outer">
      <button class="c-prod__upsell-carousel__arrow c-prod__upsell-carousel__arrow--prev" type="button" aria-label="Previous">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

      <div class="c-prod__upsell-carousel__track">

        {%- comment -%}——— CARD 1 ———{%- endcomment -%}
        {%- if block.settings.p1_title != blank or block.settings.p1_image != blank -%}
          {%- assign _uc_variant_id = '' -%}
          {%- assign _uc_sp_id = '' -%}
          {%- assign _uc_product_id = '' -%}
          {%- if block.settings.p1_product != blank -%}
            {%- assign _uc_product_id = block.settings.p1_product.id -%}
            {%- assign _uc_v = block.settings.p1_product.selected_or_first_available_variant -%}
            {%- assign _uc_variant_id = _uc_v.id -%}
            {%- assign _uc_spa = _uc_v.selling_plan_allocations | first -%}
            {%- if _uc_spa != blank -%}{%- assign _uc_sp_id = _uc_spa.selling_plan.id -%}{%- endif -%}
          {%- endif -%}
          <div class="c-prod__upsell-card">
            <div class="c-prod__upsell-card__image-box">
              {%- if block.settings.p1_badge_1 != blank or block.settings.p1_badge_2 != blank or block.settings.p1_badge_3 != blank or block.settings.p1_badge_4 != blank -%}
                <div class="c-prod__upsell-card__badges-top">
                  {%- if block.settings.p1_badge_1 != blank -%}<span>{{ block.settings.p1_badge_1 }}</span>{%- endif -%}
                  {%- if block.settings.p1_badge_2 != blank -%}<span>{{ block.settings.p1_badge_2 }}</span>{%- endif -%}
                  {%- if block.settings.p1_badge_3 != blank -%}<span>{{ block.settings.p1_badge_3 }}</span>{%- endif -%}
                  {%- if block.settings.p1_badge_4 != blank -%}<span class="special">{{ block.settings.p1_badge_4 }}</span>{%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.p1_image != blank -%}
                <a href="{{ block.settings.p1_learn_url | default: '#' }}" class="c-prod__upsell-card__image-link">
                  <img src="{{ block.settings.p1_image | image_url: width: 600 }}" alt="{{ block.settings.p1_title | escape }}" width="300" height="300" loading="lazy">
                </a>
              {%- endif -%}
              <div class="c-prod__upsell-card__subscribe-pill">Subscribe & Save</div>
            </div>
            <div class="c-prod__upsell-card__info">
              {%- if block.settings.p1_title != blank -%}
                <a href="{{ block.settings.p1_learn_url | default: '#' }}" class="c-prod__upsell-card__title-link">
                  <h3 class="c-prod__upsell-card__title">{{ block.settings.p1_title }}</h3>
                </a>
              {%- endif -%}
              {%- if block.settings.p1_description != blank -%}
                {%- assign _uc_lines = block.settings.p1_description | replace: '<br />', '|' | replace: '<br/>', '|' | replace: '<br>', '|' | split: '|' -%}
                <ul class="c-prod__upsell-card__desc">
                  {%- for _uc_line in _uc_lines limit: 4 -%}
                    {%- assign _uc_l = _uc_line | strip -%}
                    {%- if _uc_l != blank -%}<li>{{ _uc_l }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <div class="c-prod__upsell-card__recharge-wrap">
                {%- if _uc_product_id != blank -%}
                  <recharge-subscription-widget product-id="{{ _uc_product_id }}" default-variant-id="{{ _uc_variant_id }}"></recharge-subscription-widget>
                {%- else -%}
                  <div class="c-prod__upsell-card__price-wrap">
                    {%- if block.settings.p1_sub_price != blank -%}
                      <span class="c-prod__upsell-card__price">{{ block.settings.p1_sub_price }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              <div class="c-prod__upsell-card__actions">
                <button class="c-prod__upsell-card__atc-btn js-upsell-carousel-atc" type="button"
                  data-product-id="{{ _uc_product_id }}"
                  data-variant-id="{{ _uc_variant_id }}"
                  data-selling-plan-id="{{ _uc_sp_id }}"
                  data-card-index="1"
                  data-block-id="{{ block.id }}"
                  data-learn-url="{{ block.settings.p1_learn_url | default: '#' }}">
                  {{ block.settings.p1_btn_text | default: 'ADD TO CART' }}
                </button>
                {%- if block.settings.p1_learn_url != blank -%}
                  <a href="{{ block.settings.p1_learn_url }}" class="c-prod__upsell-card__learn-more">
                    LEARN MORE
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%}——— CARD 2 ———{%- endcomment -%}
        {%- if block.settings.p2_title != blank or block.settings.p2_image != blank -%}
          {%- assign _uc_variant_id = '' -%}
          {%- assign _uc_sp_id = '' -%}
          {%- assign _uc_product_id = '' -%}
          {%- if block.settings.p2_product != blank -%}
            {%- assign _uc_product_id = block.settings.p2_product.id -%}
            {%- assign _uc_v = block.settings.p2_product.selected_or_first_available_variant -%}
            {%- assign _uc_variant_id = _uc_v.id -%}
            {%- assign _uc_spa = _uc_v.selling_plan_allocations | first -%}
            {%- if _uc_spa != blank -%}{%- assign _uc_sp_id = _uc_spa.selling_plan.id -%}{%- endif -%}
          {%- endif -%}
          <div class="c-prod__upsell-card">
            <div class="c-prod__upsell-card__image-box">
              {%- if block.settings.p2_badge_1 != blank or block.settings.p2_badge_2 != blank or block.settings.p2_badge_3 != blank or block.settings.p2_badge_4 != blank -%}
                <div class="c-prod__upsell-card__badges-top">
                  {%- if block.settings.p2_badge_1 != blank -%}<span>{{ block.settings.p2_badge_1 }}</span>{%- endif -%}
                  {%- if block.settings.p2_badge_2 != blank -%}<span>{{ block.settings.p2_badge_2 }}</span>{%- endif -%}
                  {%- if block.settings.p2_badge_3 != blank -%}<span>{{ block.settings.p2_badge_3 }}</span>{%- endif -%}
                  {%- if block.settings.p2_badge_4 != blank -%}<span class="special">{{ block.settings.p2_badge_4 }}</span>{%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.p2_image != blank -%}
                <a href="{{ block.settings.p2_learn_url | default: '#' }}" class="c-prod__upsell-card__image-link">
                  <img src="{{ block.settings.p2_image | image_url: width: 600 }}" alt="{{ block.settings.p2_title | escape }}" width="300" height="300" loading="lazy">
                </a>
              {%- endif -%}
              <div class="c-prod__upsell-card__subscribe-pill">Subscribe & Save up to 5% OFF</div>
            </div>
            <div class="c-prod__upsell-card__info">
              {%- if block.settings.p2_title != blank -%}
                <a href="{{ block.settings.p2_learn_url | default: '#' }}" class="c-prod__upsell-card__title-link">
                  <h3 class="c-prod__upsell-card__title">{{ block.settings.p2_title }}</h3>
                </a>
              {%- endif -%}
              {%- if block.settings.p2_description != blank -%}
                {%- assign _uc_lines = block.settings.p2_description | replace: '<br />', '|' | replace: '<br/>', '|' | replace: '<br>', '|' | split: '|' -%}
                <ul class="c-prod__upsell-card__desc">
                  {%- for _uc_line in _uc_lines limit: 4 -%}
                    {%- assign _uc_l = _uc_line | strip -%}
                    {%- if _uc_l != blank -%}<li>{{ _uc_l }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <div class="c-prod__upsell-card__recharge-wrap">
                {%- if _uc_product_id != blank -%}
                  <recharge-subscription-widget product-id="{{ _uc_product_id }}" default-variant-id="{{ _uc_variant_id }}"></recharge-subscription-widget>
                {%- else -%}
                  <div class="c-prod__upsell-card__price-wrap">
                    {%- if block.settings.p2_sub_price != blank -%}
                      <span class="c-prod__upsell-card__price">{{ block.settings.p2_sub_price }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              <div class="c-prod__upsell-card__actions">
                <button class="c-prod__upsell-card__atc-btn js-upsell-carousel-atc" type="button"
                  data-product-id="{{ _uc_product_id }}"
                  data-variant-id="{{ _uc_variant_id }}"
                  data-selling-plan-id="{{ _uc_sp_id }}"
                  data-card-index="2"
                  data-block-id="{{ block.id }}"
                  data-learn-url="{{ block.settings.p2_learn_url | default: '#' }}">
                  {{ block.settings.p2_btn_text | default: 'ADD TO CART' }}
                </button>
                {%- if block.settings.p2_learn_url != blank -%}
                  <a href="{{ block.settings.p2_learn_url }}" class="c-prod__upsell-card__learn-more">
                    LEARN MORE
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}

