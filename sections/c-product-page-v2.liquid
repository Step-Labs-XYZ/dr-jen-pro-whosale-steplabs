}
/* Upsell carousel progress bar */
.c-prod__upsell-carousel__progress {
  width: 100%; height: 4px; background: rgba(0,0,0,0.06);
  border-radius: 4px; overflow: hidden; cursor: pointer; touch-action: pan-x;
}
.c-prod__upsell-carousel__progress-fill {
  width: 0%; height: 100%; background: var(--cp-accent, #0b63ce);
  transition: width 220ms linear;
}
/* FUENTE */
@import url('https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Playfair+Display:wght@700&display=swap');

/* =========================================
   SECCIÓN BASE
   ========================================= */
#c-prod-{{ section.id }} {
  --cp-bg-page: {{ section.settings.bg_color }};
  --cp-bg-gallery: {{ section.settings.gallery_bg }};
  --cp-text-dark: #002C41;
  --cp-text-light: #6b7280;
  --cp-accent: #0b5ee7;
  --cp-badge-bg: #d1e8e2;
  --cp-badge-text: #004b40;
  font-family: 'Raleway', sans-serif;
  background-color: var(--cp-bg-page);
  padding-top: {{ section.settings.pad_top_mob }}px;
  padding-bottom: {{ section.settings.pad_bot_mob }}px;
}
#c-prod-{{ section.id }} .c-prod__wrapper {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
}

/* GALERÍA */
#c-prod-{{ section.id }} .c-prod__gallery { display: flex; flex-direction: column; gap: 16px; }
#c-prod-{{ section.id }} .c-prod__main-view {
  background-color: var(--cp-bg-gallery);
  border-radius: 16px;
  aspect-ratio: 1 / 1;
  width: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  touch-action: pan-y;
}
#c-prod-{{ section.id }} .c-prod__main-img {
  width: auto; height: auto;
  border-radius: 20px;
  object-fit: contain;
  transition: opacity 0.3s ease;
}
#c-prod-{{ section.id }} .c-prod__main-video {
  width: 100%;
  height: 100%;
  border-radius: 20px;
  object-fit: contain;
}
#c-prod-{{ section.id }} .c-prod__main-video-wrap { width: 100%; height: 100%; }
#c-prod-{{ section.id }} .c-prod__main-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 4;
  width: 40px;
  height: 40px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.72);
  color: #002C41;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  transition: background-color 0.2s ease, opacity 0.2s ease;
}
#c-prod-{{ section.id }} .c-prod__main-nav:hover { background: rgba(255, 255, 255, 0.9); }
#c-prod-{{ section.id }} .c-prod__main-nav:focus-visible {
  outline: 2px solid #002C41;
  outline-offset: 2px;
}
#c-prod-{{ section.id }} .c-prod__main-nav[disabled] {
  opacity: 0.45;
  cursor: not-allowed;
}
#c-prod-{{ section.id }} .c-prod__main-nav--prev { left: 14px; }
#c-prod-{{ section.id }} .c-prod__main-nav--next { right: 14px; }
#c-prod-{{ section.id }} .c-prod__mobile-zoom-btn {
  position: absolute;
  right: 14px;
  bottom: 14px;
  z-index: 4;
  width: 38px;
  height: 38px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.78);
  color: #002C41;
  display: none;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}
#c-prod-{{ section.id }} .c-prod__mobile-zoom-btn:focus-visible {
  outline: 2px solid #002C41;
  outline-offset: 2px;
}
#c-prod-{{ section.id }} .c-prod__zoom-modal {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: none;
  background: rgba(0, 0, 0, 0.72);
  padding: 20px;
  align-items: center;
  justify-content: center;
}
#c-prod-{{ section.id }} .c-prod__zoom-modal.is-open { display: flex; }
#c-prod-{{ section.id }} .c-prod__zoom-dialog {
  position: relative;
  width: min(92vw, 640px);
  max-height: 90vh;
}
#c-prod-{{ section.id }} .c-prod__zoom-image {
  width: 100%;
  height: auto;
  max-height: 90vh;
  object-fit: contain;
  border-radius: 10px;
  background: #fff;
}
#c-prod-{{ section.id }} .c-prod__zoom-close {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 32px;
  height: 32px;
  border: 1px solid rgba(255, 255, 255, 0.92);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.82);
  color: #002C41;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
#c-prod-{{ section.id }} .c-prod__zoom-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.82);
  color: #002C41;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 2;
}
#c-prod-{{ section.id }} .c-prod__zoom-nav:focus-visible {
  outline: 2px solid #002C41;
  outline-offset: 2px;
}
#c-prod-{{ section.id }} .c-prod__zoom-nav[hidden] { display: none; }
#c-prod-{{ section.id }} .c-prod__zoom-nav--prev { left: 10px; }
#c-prod-{{ section.id }} .c-prod__zoom-nav--next { right: 10px; }
#c-prod-{{ section.id }} .c-prod__badge-left {
  position: absolute; top: 20px; left: 20px;
  background-color: #D6ECE6; color: var(--cp-text-dark);
  border: 1px solid var(--cp-text-dark);
  padding: 6px 14px; border-radius: 30px;
  font-size: 12px; font-weight: 700; z-index: 2;
}
#c-prod-{{ section.id }} .c-prod__badge-left--image { border: none; padding: 0; background: transparent; width: 50%; max-width: 110px; }
#c-prod-{{ section.id }} .c-prod__badge-left-img { display: block; width: 100%; height: auto; }
#c-prod-{{ section.id }} .c-prod__badge-right {
  position: absolute; top: 61px; right: 176px;
  background-color: var(--cp-text-dark); color: #fff;
  width: 100px; height: 100px; border-radius: 50%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center; padding: 10px; line-height: 1.1; z-index: 2;
}
#c-prod-{{ section.id }} .c-prod__badge-right--image { background: transparent; padding: 0; width: 50%; max-width: 110px; height: auto; aspect-ratio: 1/1; }
#c-prod-{{ section.id }} .c-prod__badge-right-img { width: 100%; height: 100%; object-fit: contain; }
#c-prod-{{ section.id }} .c-prod__badge-right strong { font-size: 28px; font-weight: 800; }
#c-prod-{{ section.id }} .c-prod__badge-right span { font-size: 10px; font-weight: 600; text-transform: uppercase; }
{%- if section.settings.badge_right_img_width > 0 -%}
#c-prod-{{ section.id }} .c-prod__badge-right--image {
  top: {{ section.settings.badge_right_img_top }}%;
  right: {{ section.settings.badge_right_img_right }}%;
  width: {{ section.settings.badge_right_img_width }}%;
  max-width: none;
}
{%- endif -%}

/* Caption sobre la imagen principal */
#c-prod-{{ section.id }} .c-prod__img-caption {
  position: absolute; left: 50%; bottom: 86px; transform: translateX(-50%);
  z-index: 2; display: flex; align-items: center; justify-content: center; gap: 6px;
  width: max-content; max-width: 88%; padding: 10px 24px; border-radius: 10px; background: #FFFFFF;
  font-family: 'EightiesComeback VAR', 'Raleway', sans-serif;
  font-size: 16px; line-height: 1.2; color: #3E5565; text-align: center;
}
#c-prod-{{ section.id }} .c-prod__img-caption-text { white-space: nowrap; }
@media (max-width: 899px) { #c-prod-{{ section.id }} .c-prod__img-caption--hide-mobile { display: none; } }
#c-prod-{{ section.id }} .c-prod__thumbs { display: flex; gap: 10px; overflow-x: auto; scrollbar-width: none; scroll-left: 0; }
#c-prod-{{ section.id }} .c-prod__thumbs::-webkit-scrollbar { display: none; }
#c-prod-{{ section.id }} .c-prod__thumb-item {
  width: 70px; height: 70px; flex-shrink: 0;
  border: 2px solid transparent; border-radius: 8px;
  background-color: var(--cp-bg-gallery); cursor: pointer; transition: all 0.2s; position: relative; overflow: hidden;
}
#c-prod-{{ section.id }} .c-prod__thumb-item.is-active { border-color: var(--cp-text-dark); }
#c-prod-{{ section.id }} .c-prod__thumb-item img { width: 100%; height: 100%; object-fit: cover; }
#c-prod-{{ section.id }} .c-prod__thumb-item > span { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; background: rgba(0, 44, 65, 0.45); pointer-events: none; }

/* Indicadores de navegación */
#c-prod-{{ section.id }} .c-prod__dots { display: flex; gap: 8px; justify-content: center; align-items: center; padding: 12px 0 0; }
#c-prod-{{ section.id }} .c-prod__dot { 
  width: 8px; height: 8px; border-radius: 50%; background-color: #ddd; border: none; cursor: pointer; 
  transition: all 0.3s ease; flex-shrink: 0; padding: 0;
}
#c-prod-{{ section.id }} .c-prod__dot:hover { background-color: #bbb; }
#c-prod-{{ section.id }} .c-prod__dot.is-active { background-color: var(--cp-text-dark); width: 10px; height: 10px; }

/* INFO */
#c-prod-{{ section.id }} .c-prod__info { display: flex; flex-direction: column; gap: 16px; }
#c-prod-{{ section.id }} .c-prod__form { display: flex; flex-direction: column; gap: 16px; }

/* Reviews */
#c-prod-{{ section.id }} .c-prod__reviews { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--cp-text-light); flex-wrap: nowrap; }
#c-prod-{{ section.id }} .c-prod__reviews-stars { color: var(--cp-accent); letter-spacing: 0; display: inline-flex; gap: 2px; flex-shrink: 0; }
#c-prod-{{ section.id }} .c-prod__reviews > span,
#c-prod-{{ section.id }} .c-prod__reviews > a { white-space: nowrap; }
#c-prod-{{ section.id }} .c-prod__reviews a { color: var(--cp-text-light); text-decoration: underline; }

/* Title */
#c-prod-{{ section.id }} .c-prod__title { font-size: 32px; font-weight: 600; color: var(--cp-text-dark); line-height: 1.2; margin: 0;font-family:'Raleway'; }
#c-prod-{{ section.id }} .c-prod__title-wrapper { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
#c-prod-{{ section.id }} .c-prod__title-tag { font-size: 13px; font-weight: 400; color: #888; white-space: nowrap; }
#c-prod-{{ section.id }} .c-prod__title-eyebrow { font-family: 'EightiesComeback VAR', 'Raleway', sans-serif; font-size: 16px; font-weight: 400; line-height: 1.2; color: #3E5565; margin: 0 0 6px; }
#c-prod-{{ section.id }} .c-prod__title-secondary { font-size: 32px; font-weight: 600; color: var(--cp-text-dark); line-height: 1.25; margin: 0; }
#c-prod-{{ section.id }} .c-prod__title-secondary-line2 { font-size: 25px; font-weight: 600; color: var(--cp-text-dark); line-height: 1.3; margin: 4px 0 0; }

/* Price & Stock */
#c-prod-{{ section.id }} .c-prod__price-wrap { display: flex; align-items: center; gap: 25px; }
#c-prod-{{ section.id }} .c-prod__payment-terms { font-size: 12px; color: var(--cp-text-light); margin-top: 4px; }
#c-prod-{{ section.id }} .c-prod__price { font-size: 20px; font-weight: 700; color: var(--cp-text-dark); }
#c-prod-{{ section.id }} .c-prod__stock { display: flex; align-items: center; gap: 10px; font-size: 16px; color: #000; }
@keyframes c-prod-pulse {
  0%   { box-shadow: 0 0 0 0 rgba(0,168,107,0.55); transform: scale(1); }
  60%  { box-shadow: 0 0 0 7px rgba(0,168,107,0); transform: scale(1.15); }
  100% { box-shadow: 0 0 0 0 rgba(0,168,107,0); transform: scale(1); }
}
#c-prod-{{ section.id }} .c-prod__stock-dot {
  width: 14px; height: 14px; border-radius: 50%;
  background-color: #CDFFF1; display: inline-block; flex-shrink: 0;
  animation: c-prod-pulse 1.8s ease-in-out infinite;
}

/* Highlight */
#c-prod-{{ section.id }} .c-prod__highlight {
  background-color: var(--cp-badge-bg); color: var(--cp-badge-text);
  padding: 8px 16px; border-radius: 50px;
  font-size: 12px; font-weight: 700; margin-bottom: 5px; display: inline-table;
}

/* Text Link */
#c-prod-{{ section.id }} .c-prod__link {
  font-size: 13px; font-weight: 700; color: var(--cp-text-dark);
  text-decoration: none; display: inline-flex; align-items: center; gap: 6px; text-transform: uppercase;
}

/* VARIANTES */
#c-prod-{{ section.id }} .c-prod__variant-group { display: flex; flex-direction: column; gap: 12px; }
#c-prod-{{ section.id }} .c-prod__option-name { font-weight: 700; font-size: 15px; color: var(--cp-text-dark); }
#c-prod-{{ section.id }} .c-prod__radio { display: none; }
#c-prod-{{ section.id }} .c-prod__pills { display: flex; flex-wrap: wrap; gap: 10px; }
#c-prod-{{ section.id }} .c-prod__pill-label {
  display: flex; align-items: center; gap: 10px; padding: 10px 18px;
  border: 1.5px solid #d1d5db; border-radius: 5px; font-size: 14px; font-weight: 600;
  cursor: pointer; transition: all 0.2s; color: #6b7280; background: #fff;
}
#c-prod-{{ section.id }} .c-prod__radio:checked + .c-prod__pill-label,
#c-prod-{{ section.id }} .c-prod__pill-label.is-active {
  border: 2px solid #002C41; color: #002C41; background-color: var(--pill-selected-bg, #e8f5f2);
}
#c-prod-{{ section.id }} a.c-prod__pill-label { text-decoration: none; }
#c-prod-{{ section.id }} .c-prod__pill-dot { display: flex; flex-shrink: 0; }
#c-prod-{{ section.id }} .c-prod__pill-check { display: none; flex-shrink: 0; }
#c-prod-{{ section.id }} .c-prod__radio:checked + .c-prod__pill-label .c-prod__pill-dot,
#c-prod-{{ section.id }} .c-prod__pill-label.is-active .c-prod__pill-dot { display: none; }
#c-prod-{{ section.id }} .c-prod__radio:checked + .c-prod__pill-label .c-prod__pill-check,
#c-prod-{{ section.id }} .c-prod__pill-label.is-active .c-prod__pill-check { display: flex; }
/* pills de producto: una instancia por breakpoint cuando el orden cambia en mobile */
@media (max-width: 899px) { #c-prod-{{ section.id }} .c-prod__product-pills--desktop { display: none; } }
@media (min-width: 900px) { #c-prod-{{ section.id }} .c-prod__product-pills--mobile { display: none; } }
#c-prod-{{ section.id }} .c-prod__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
#c-prod-{{ section.id }} .c-prod__variant-group--cards[data-desktop-columns="4"] .c-prod__cards { grid-template-columns: repeat(4, 1fr); }
#c-prod-{{ section.id }} .c-prod__card-label {
  display: flex; flex-direction: column; align-items: center; padding: 20px 10px 15px;
