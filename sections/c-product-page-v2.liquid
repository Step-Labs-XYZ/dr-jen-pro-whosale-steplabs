<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.popup-club-trigger').forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      
      const popupId = this.dataset.popupTarget || this.id;
      
      if (popupId) {
        // Buscar el popup por ID
        const popupElement = document.getElementById(popupId);
        if (popupElement) {
          // Abrir el popup quitando aria-hidden y agregando clase
          popupElement.setAttribute('aria-hidden', 'false');
          popupElement.classList.add('is-open');
          
          // Disparar evento personalizado si es necesario
          popupElement.dispatchEvent(new CustomEvent('popup:open'));
          
          console.log('Popup abierto:', popupId);
          return;
        }
      }
      
      console.warn('Club popup no encontrado con ID:', popupId);
    });
  });
});
</script>