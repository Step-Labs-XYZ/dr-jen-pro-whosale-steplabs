  /* en mobile el nombre va fuera de la caja, debajo (sigue dentro del label para no perder el click) */
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__card-name {
    position: absolute; top: calc(100% + 5px); left: 0; right: 0; text-align: center;
  }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__card-img { max-height: 62px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__card-imgs .c-prod__card-img { width: 53px; height: 48px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__card-imgs[data-count="2"] .c-prod__card-img + .c-prod__card-img { margin-left: -25px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__card-imgs[data-count="3"] .c-prod__card-img + .c-prod__card-img,
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__card-imgs[data-count="4"] .c-prod__card-img + .c-prod__card-img { margin-left: -29px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__card-name { font-size: 12px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__card-badge { font-size: 10px; padding: 2px 8px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__body { padding: 16px 24px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__reviews-count { font-size: 12px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__reviews-link { font-size: 10px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__dot { width: 10px; height: 10px; background-color: #707170; opacity: 0.5; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__dot.is-active { background-color: #002C41; opacity: 1; }
  /* en mobile el callout son dos lineas apiladas, sin el gap horizontal del desktop */
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__img-caption { gap: 0; width: 82.8%; max-width: none; }
  /* el sello tiene otra proporcion en el nodo mobile (79x80 sobre una card de 332) */
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__badge-right--image { width: 23.8%; right: 5.4%; top: 4.3%; }

  /* ── escala tipografica del nodo mobile (antes se servia la de desktop) ── */
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__option-name { font-size: 14px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__pill-label { font-size: 10px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__btn-submit { font-size: 12px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__terms { font-size: 10px; line-height: 1.2; }
  /* el tema lo fija en 12px !important */
  #c-prod-{{ section.id }}.c-prod--v2 #shopify-buyer-consent { font-size: 10px !important; line-height: 1.2; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-sub-box__title { font-size: 16px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-sub-box__list li { font-size: 14px; }
  #c-prod-{{ section.id }}.c-prod--v2 .pac-header { font-size: 16px; }
  #c-prod-{{ section.id }}.c-prod--v2 .pac-text { font-size: 12px; }
  #c-prod-{{ section.id }}.c-prod--v2 .htu-eye { font-size: 10px; }
  #c-prod-{{ section.id }}.c-prod--v2 .htu-title { font-size: 18px; }
  #c-prod-{{ section.id }}.c-prod--v2 .htu-sub-text { font-size: 14px; }
  #c-prod-{{ section.id }}.c-prod--v2 .htu-num { font-size: 16px; }
  #c-prod-{{ section.id }}.c-prod--v2 .htu-step:has(.htu-trigger[aria-expanded="true"]) .htu-num { font-size: 20px; }
  #c-prod-{{ section.id }}.c-prod--v2 .htu-media { height: 263px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__plan-name { font-size: 16px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__price,
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__radio-label { font-size: 14px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__compare { font-size: 12px; }
  /* wholesale: en el nodo "Buy one time" va al mismo tamano que "Subscribe & Save" */
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__card--onetime .c-subwidget__radio-label { font-size: 16px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__benefits li { font-size: 10px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__frequency label { font-size: 12px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__frequency select { font-size: 10px; height: 36px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__header { height: 40px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__header-title { font-size: 14px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-subwidget__header-badge { font-size: 10px; }
  /* el nodo pone la primera linea en bold al MISMO tamano que el resto */
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__desc-block strong,
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__desc-block b { font-size: 12px; }

  /* ritmo vertical del nodo (space-between da ~19.6 entre bloques) */
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__info,
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__form { gap: 19.6px; }

  /* ── banner Dr. Jen's Club (4498:17314): 362x136, imagen 126x112 ── */
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__club-banner {
    width: 362px; max-width: 100%; margin: 0 auto;
    grid-template-columns: 126px minmax(0, 200px);
    justify-content: center; padding: 12px; gap: 12px; align-items: center;
  }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__club-banner__media img {
    width: 126px; height: 112px; border-radius: 8px; object-fit: cover;
  }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__club-banner__content { gap: 8px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__club-banner__heading { gap: 6px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__club-banner__title { font-size: 20px; line-height: 1.2; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__club-banner__title--serif {
    font-family: 'EightiesComeback_It VAR', 'EightiesComeback VAR', Georgia, serif;
    font-size: 20px; line-height: 1.425; letter-spacing: 1.4px;
  }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__club-banner__badge {
    padding: 6px; border-radius: 8px; font-size: 10px; letter-spacing: normal; line-height: 1.2;
  }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__club-banner__desc { font-size: 10px; line-height: 1.2; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__club-banner__cta { font-size: 12px; letter-spacing: normal; gap: 10px; padding: 12px 0; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__club-banner__cta svg { width: 16px; height: 12px; stroke-width: 1.5; }
}

@media (min-width: 900px) {
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__wrapper {
    /* el diseno es de 1440: el contenido se capa ahi y se centra en pantallas mas anchas */
    max-width: min(100% - 126px, 1314px);
    grid-template-columns: minmax(0, 650fr) minmax(0, 592fr);
    gap: 32px;
  }
  /* 143/144/209 sobre 592 en el nodo, en proporcion para que escale con la columna */
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__cards {
    grid-template-columns: 24.155% 24.324% 35.304%; gap: 0; justify-content: space-between;
  }
  /* galeria del nodo: card 636x642 dentro de la columna de 650, 41 hasta las miniaturas
     y la fila repartida con space-between en vez de scroller */
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__gallery { gap: 41px; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__main-view {
    width: 97.846%; aspect-ratio: 636 / 642; margin-inline: auto;
  }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__thumbs { justify-content: flex-start; gap: 30px; overflow-x: visible; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__img-caption { width: 354px; max-width: 100%; }
  /* el club banner solo va en mobile, segun el diseno */
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__club-banner { display: none; }
  #c-prod-{{ section.id }}.c-prod--v2 .c-prod__card-label { height: 176px; }
}
{%- endif -%}

{%- endstyle -%}

<script type="module" src="https://static.rechargecdn.com/assets/subscription-widget/subscription-widget.js"></script>

<script type="application/json" id="ProductJSON-{{ section.id }}">
  {%- assign _qty_option = nil -%}
  {%- for _opt in product.options_with_values -%}
    {%- assign _opt_name_dc = _opt.name | downcase | strip -%}
    {%- if _opt_name_dc == 'quantity' -%}
      {%- assign _qty_option = _opt -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if _qty_option == nil -%}
    {%- if product.options_with_values.size > 1 -%}
      {%- assign _qty_option = product.options_with_values[1] -%}
    {%- else -%}
      {%- assign _qty_option = product.options_with_values[0] -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign _qty_opt_pos_idx = _qty_option.position | minus: 1 -%}
  [
    {% for variant in product.variants %}
      {%- assign _pack_val = nil -%}
      {%- for _v_opt_val in variant.options -%}
        {%- unless _pack_val -%}
          {%- if _v_opt_val contains 'pack' or _v_opt_val contains 'case' or _v_opt_val contains 'bundle' -%}
            {%- assign _pack_val = _v_opt_val -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- assign _pack_part = _pack_val | split: ' pack' | first | split: '(' | last | strip -%}
      {%- assign _unit_count = _pack_part | plus: 0 -%}
      {%- assign _qty_opt_index = 0 -%}
      {%- assign _variant_qty_value = variant.options[_qty_opt_pos_idx] -%}
      {%- for _qv in _qty_option.values -%}
        {%- if _qv == _variant_qty_value -%}
          {%- assign _qty_opt_index = forloop.index -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {
        "id": {{ variant.id }},
        "options": {{ variant.options | json }},
        "price_cents": {{ variant.price }},
        "compare_at_price_cents": {{ variant.compare_at_price | default: 0 }},
        "price": "{{ variant.price | money }}",
        "title": {{ variant.title | json }},
        "unit_count": {{ _unit_count }},
        "qty_option_index": {{ _qty_opt_index }},
        "available": {{ variant.available | json }},
        "image": {% if variant.image %}{{ variant.image | image_url: width: 800 | json }}{% else %}null{% endif %},
        "selling_plans": [
          {%- for allocation in variant.selling_plan_allocations -%}
            {%- assign _sp_discount = 0 -%}
            {%- for adj in allocation.selling_plan.price_adjustments -%}
              {%- if adj.value_type == 'percentage' and adj.value > _sp_discount -%}
                {%- assign _sp_discount = adj.value -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if _sp_discount == 0 and allocation.compare_at_price and allocation.compare_at_price > allocation.per_delivery_price -%}
              {%- assign _sp_discount = allocation.compare_at_price | minus: allocation.per_delivery_price | times: 100.0 | divided_by: allocation.compare_at_price | round -%}
            {%- endif -%}
            {
              "id": {{ allocation.selling_plan.id }},
              "name": {{ allocation.selling_plan.name | json }},
              "price": "{{ allocation.per_delivery_price | money }}",
              "price_cents": {{ allocation.per_delivery_price }},
              "compare_at_price": {% if allocation.compare_at_price and allocation.compare_at_price > allocation.per_delivery_price %}"{{ allocation.compare_at_price | money }}"{% else %}null{% endif %},
              "compare_at_price_cents": {{ allocation.compare_at_price | default: 0 }},
              "discount_percent": {{ _sp_discount }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
</script>

<section id="c-prod-{{ section.id }}" class="c-prod{% if section.settings.design_v2 %} c-prod--v2{% endif %}" data-product-id="{{ product.id }}" data-enable-nav-arrows="{{ section.settings.enable_main_image_navigation_arrows }}" data-enable-infinite-gallery="{{ section.settings.enable_infinite_gallery }}" data-enable-mobile-zoom="{{ section.settings.enable_mobile_zoom }}">
  <div class="c-prod__wrapper">
    
    <div class="c-prod__gallery">
      
      <div class="c-prod__main-view">
        {% if section.settings.badge_left_svg != blank %}
          <div class="c-prod__badge-left c-prod__badge-left--image">
            <img
              src="{{ section.settings.badge_left_svg | image_url: width: 320 }}"
              alt="{{ section.settings.badge_left | default: 'Badge left' | escape }}"
              class="c-prod__badge-left-img"
              loading="lazy"
            >
          </div>
        {% elsif section.settings.badge_left != blank %}
          <div class="c-prod__badge-left">{{ section.settings.badge_left }}</div>
        {% endif %}
        
        {% if section.settings.badge_right_svg != blank %}
          <div class="c-prod__badge-right c-prod__badge-right--image">
            <img
              src="{{ section.settings.badge_right_svg | image_url: width: 320 }}"
              alt="{{ section.settings.badge_right_2 | default: 'Badge right' | escape }}"
              class="c-prod__badge-right-img"
              loading="lazy"
            >
          </div>
        {% elsif section.settings.badge_right_1 != blank %}
          <div class="c-prod__badge-right">
            <strong>{{ section.settings.badge_right_1 }}</strong>
            <span>{{ section.settings.badge_right_2 }}</span>
          </div>
        {% endif %}

        <img src="{{ product.featured_image | image_url: width: 800 }}"
             id="MainImage-{{ section.id }}"
             class="c-prod__main-img"
             {% if product.featured_media and product.featured_media.media_type == 'video' %}hidden{% endif %}
             alt="{{ product.title | escape }}">
        {%- assign _gal_limit = section.settings.gallery_max_media -%}
        {%- if _gal_limit == nil or _gal_limit == 0 -%}{%- assign _gal_limit = 100 -%}{%- endif -%}
        {% for media in product.media limit: _gal_limit %}
          {% if media.media_type == 'video' %}
            <div class="c-prod__main-video-wrap" data-media-id="{{ media.id }}" hidden style="display: none;">
              {{ media | media_tag: image_size: '1024x', autoplay: false, loop: false, controls: true, playsinline: true, preload: 'metadata', class: 'c-prod__main-video' }}
            </div>
          {% endif %}
        {% endfor %}

        {% if section.settings.enable_main_image_navigation_arrows %}
          <button class="c-prod__main-nav c-prod__main-nav--prev js-main-nav-prev-{{ section.id }}" type="button" aria-label="Previous image">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M14.5 6L8.5 12L14.5 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="c-prod__main-nav c-prod__main-nav--next js-main-nav-next-{{ section.id }}" type="button" aria-label="Next image">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9.5 6L15.5 12L9.5 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}

        {% if section.settings.image_caption != blank %}
          {%- assign caption_parts = section.settings.image_caption | split: '|' -%}
          <div class="c-prod__img-caption{% if section.settings.image_caption_hide_mobile %} c-prod__img-caption--hide-mobile{% endif %}">
            {%- for part in caption_parts -%}
              <span class="c-prod__img-caption-text">{{ part | strip }}</span>
              {%- unless forloop.last -%}
                <span class="c-prod__img-caption-sep" aria-hidden="true">|</span>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        {% endif %}

        {% if section.settings.enable_mobile_zoom %}
          <button class="c-prod__mobile-zoom-btn js-mobile-zoom-{{ section.id }}" type="button" aria-label="Zoom image">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2"></circle>
              <path d="M16 16L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              <path d="M11 8.5V13.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
              <path d="M8.5 11H13.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </button>
        {% endif %}
      </div>

      <div class="c-prod__thumbs">
        {% for media in product.media limit: _gal_limit %}
          {% assign media_preview = media.preview_image | default: media %}
          <div class="c-prod__thumb-item {% if forloop.first %}is-active{% endif %} js-thumb-{{ section.id }}"
               data-image="{{ media_preview | image_url: width: 800 }}"
               data-media-type="{{ media.media_type }}"
               data-media-id="{{ media.id }}"
               data-variant-ids="{{ media.variant_ids | join: ',' }}">
            <img src="{{ media_preview | image_url: width: 150 }}" alt="Thumbnail">
            {% if media.media_type == 'video' %}
              <span aria-hidden="true">▶</span>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="c-prod__dots">
        {% for media in product.media limit: _gal_limit %}
          <button class="c-prod__dot {% if forloop.first %}is-active{% endif %} js-dot-{{ section.id }}" data-index="{{ forloop.index0 }}" aria-label="Imagen {{ forloop.index }}" type="button"></button>
        {% endfor %}
      </div>

      {% if section.settings.enable_mobile_zoom %}
        <div class="c-prod__zoom-modal" aria-hidden="true" data-mobile-zoom-modal="{{ section.id }}" role="dialog" aria-modal="true">
          <div class="c-prod__zoom-dialog">
            <button class="c-prod__zoom-close" type="button" data-mobile-zoom-close aria-label="Close zoom">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                <path d="M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
            </button>
            <img class="c-prod__zoom-image" alt="{{ product.title | escape }}" loading="lazy">
            <button class="c-prod__zoom-nav c-prod__zoom-nav--prev js-zoom-nav-prev-{{ section.id }}" type="button" aria-label="Previous image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M14.5 6L8.5 12L14.5 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button class="c-prod__zoom-nav c-prod__zoom-nav--next js-zoom-nav-next-{{ section.id }}" type="button" aria-label="Next image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9.5 6L15.5 12L9.5 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
      {% endif %}
    </div>


    <div class="c-prod__info">
      
      {%- form 'product', product, id: 'product-form', class: 'c-prod__form' -%}
        
        <input type="hidden" name="id" id="VariantInput-{{ section.id }}" value="{{ product.selected_or_first_available_variant.id }}">

        {% for block in section.blocks %}
          {% case block.type %}
            
            {% when 'reviews' %}
              <div class="c-prod__reviews" {{ block.shopify_attributes }}>
                <span class="c-prod__reviews-stars">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </span>
                <span class="c-prod__reviews-count">({{ block.settings.reviews_count | default: 29 }})</span>
                {%- if block.settings.reviews_link_text != blank -%}
                  <a class="c-prod__reviews-link" href="{{ block.settings.reviews_link_url | default: '#reviews' }}">{{ block.settings.reviews_link_text }}</a>
                {%- endif -%}
              </div>

            {% when 'title' %}
              {%- assign selected_title_source = block.settings.title_source | default: 'primary' -%}
              {%- if selected_title_source == 'secondary' and block.settings.secondary_title != blank -%}
                <div {{ block.shopify_attributes }}>
                  {%- if block.settings.eyebrow != blank -%}
                    <p class="c-prod__title-eyebrow">{{ block.settings.eyebrow }}</p>
                  {%- endif -%}
                  <h1 class="c-prod__title c-prod__title-secondary">{{ block.settings.secondary_title }}</h1>
                  {%- if block.settings.secondary_title_line2 != blank -%}
                    <p class="c-prod__title-secondary-line2">{{ block.settings.secondary_title_line2 }}</p>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div {{ block.shopify_attributes }}>
                  {%- if block.settings.eyebrow != blank -%}
                    <p class="c-prod__title-eyebrow">{{ block.settings.eyebrow }}</p>
                  {%- endif -%}
                  <div class="c-prod__title-wrapper">
                    <h1 class="c-prod__title">{{ product.title }}</h1>
                    {%- if block.settings.title_tag != blank -%}
                      <span class="c-prod__title-tag">{{ block.settings.title_tag }}</span>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

            {% when 'club_banner' %}
              <div class="c-prod__club-banner" {{ block.shopify_attributes }}>
                <div class="c-prod__club-banner__media">
                  {% if block.settings.image_1 != blank %}
                    <img src="{{ block.settings.image_1 | image_url: width: 200 }}" alt="Product 1" loading="lazy">
                  {% endif %}
                  {% if block.settings.image_2 != blank %}
                    <img src="{{ block.settings.image_2 | image_url: width: 200 }}" alt="Product 2" loading="lazy">
                  {% endif %}
                </div>
                <div class="c-prod__club-banner__content">
                  <div class="c-prod__club-banner__heading">
                    {% if block.settings.badge != blank %}
                      <div class="c-prod__club-banner__badge">{{ block.settings.badge }}</div>
                    {% endif %}
                    {% if block.settings.title != blank %}
                      <h3 class="c-prod__club-banner__title">
                        {{ block.settings.title }}
                        <span class="c-prod__club-banner__title--serif">{{ block.settings.title_serif }}</span>
                      </h3>
                    {% endif %}
                  </div>
                  {% if block.settings.description != blank %}
                    <p class="c-prod__club-banner__desc">{{ block.settings.description }}</p>
                  {% endif %}
                  {% if block.settings.cta_text != blank %}
                    {% if block.settings.cta_use_popup %}
                      <button 
                        type="button" 
                        class="c-prod__club-banner__cta popup-club-trigger" 
                        id="{{ block.settings.popup_id }}"
                        data-popup-target="{{ block.settings.popup_id }}"
                      >
                        {{ block.settings.cta_text }}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                      </button>
                    {% else %}
                      <a href="{{ block.settings.cta_url }}" class="c-prod__club-banner__cta">
                        {{ block.settings.cta_text }}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                      </a>
                    {% endif %}
                  {% endif %}
                </div>
              </div>

            {% when 'labor_day_banner' %}
              {% assign labor_day_product = block.settings.product %}
              {% assign labor_day_selected_variant = labor_day_product.selected_or_first_available_variant | default: labor_day_product.variants.first %}
              {% assign labor_day_image = block.settings.image %}
              {% if labor_day_product != blank %}
                <div class="c-prod__laborday-banner" {{ block.shopify_attributes }}>
                  <div class="c-prod__laborday-banner__inner">
                    {% if block.settings.top_label != blank %}
                      <div class="c-prod__laborday-banner__header">
                        <span class="c-prod__laborday-banner__star c-prod__laborday-banner__star--blue">★</span>
                        <span class="c-prod__laborday-banner__star c-prod__laborday-banner__star--red">★</span>
                        <span class="c-prod__laborday-banner__star c-prod__laborday-banner__star--blue">★</span>
                        <span class="c-prod__laborday-banner__star c-prod__laborday-banner__star--red">★</span>
                        <span class="c-prod__laborday-banner__star c-prod__laborday-banner__star--blue">★</span>
                        <span>{{ block.settings.top_label }}</span>
                        <span class="c-prod__laborday-banner__star c-prod__laborday-banner__star--blue">★</span>
                        <span class="c-prod__laborday-banner__star c-prod__laborday-banner__star--red">★</span>
                        <span class="c-prod__laborday-banner__star c-prod__laborday-banner__star--blue">★</span>
                        <span class="c-prod__laborday-banner__star c-prod__laborday-banner__star--red">★</span>
                        <span class="c-prod__laborday-banner__star c-prod__laborday-banner__star--blue">★</span>
                      </div>
                    {% endif %}
                    <div class="c-prod__laborday-banner__content">
                      <div class="c-prod__laborday-banner__products {% if labor_day_image != blank %}c-prod__laborday-banner__products--single{% endif %}">
                        {% if labor_day_image != blank %}
                          <img
                            class="c-prod__laborday-banner__product c-prod__laborday-banner__product--single"
                            src="{{ labor_day_image | image_url: width: 1200 }}"
                            srcset="{{ labor_day_image | image_url: width: 480 }} 480w, {{ labor_day_image | image_url: width: 720 }} 720w, {{ labor_day_image | image_url: width: 1200 }} 1200w"
                            sizes="(max-width: 899px) 42vw, 300px"
                            alt="{{ labor_day_product.title | escape }}"
                            loading="lazy"
                            width="{{ labor_day_image.width }}"
                            height="{{ labor_day_image.height }}"
                          >
                        {% endif %}
                        {% unless labor_day_image != blank %}
                          <span class="c-prod__laborday-banner__plus">+</span>
                        {% endunless %}
                      </div>
                      <div class="c-prod__laborday-banner__copy">
                        {% if block.settings.heading != blank %}
                          <h3 class="c-prod__laborday-banner__heading">{{ block.settings.heading }}</h3>
                        {% endif %}
                        {% if block.settings.description != blank %}
                          <p class="c-prod__laborday-banner__text">{{ block.settings.description }}</p>
                        {% endif %}
                        {% if labor_day_selected_variant != blank and labor_day_selected_variant.id != blank %}
                          <button type="button" class="c-prod__laborday-banner__cta js-laborday-banner-cta" data-laborday-product-id="{{ labor_day_selected_variant.id }}">
                            {{ block.settings.cta_text | default: 'ADD TO CART' }}
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                              <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                              <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </button>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              {% endif %}

            {% when 'variant_pills' %}
              {%- assign target_option = block.settings.option_name | downcase | strip -%}
              {%- assign pills_option = nil -%}
              {%- for option in product.options_with_values -%}
                {%- assign current_option = option.name | downcase | strip -%}
                {%- if current_option == target_option -%}
                  {%- assign pills_option = option -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if pills_option == nil -%}
                {%- assign pills_option = product.options_with_values[0] -%}
              {%- endif -%}
              {%- if pills_option != nil and pills_option.values.size > 0 -%}
                <div class="c-prod__variant-group c-prod__variant-group--pills" {{ block.shopify_attributes }}>
                  {%- assign seen_pills = '' -%}
                  <div class="c-prod__pills">
                    {%- for value in pills_option.values -%}
                      {%- unless seen_pills contains value -%}
                        {%- assign seen_pills = seen_pills | append: value | append: '|' -%}
                        {%- assign flavor_handle = value | handleize -%}
                        {%- assign flavor_meta = metaobjects['shopify--flavor'][flavor_handle] -%}
                        {%- assign display_name = flavor_meta.name.value | default: value -%}
                        {%- assign fallback_pill_color = '#FFC183' -%}
                        {%- assign value_downcase = value | downcase -%}
                        {%- if flavor_handle contains 'cool-mint' or value_downcase contains 'cool mint' -%}
                          {%- assign fallback_pill_color = '#CDFFF1' -%}
                        {%- elsif flavor_handle contains 'orange' or value_downcase contains 'orange' -%}
                          {%- assign fallback_pill_color = '#FFC183' -%}
                        {%- elsif flavor_handle contains 'black-cherry' or value_downcase contains 'black cherry' -%}
                          {%- assign fallback_pill_color = '#B50859' -%}
                        {%- elsif flavor_handle contains 'strawberry' or value_downcase contains 'strawberry' -%}
                          {%- assign fallback_pill_color = '#FF83BD' -%}
                        {%- elsif flavor_handle contains 'watermelon' or value_downcase contains 'watermelon' -%}
                          {%- assign fallback_pill_color = '#FF8385' -%}
                        {%- endif -%}
                        {%- assign pill_color = flavor_meta.color.value | default: fallback_pill_color -%}
                        {%- assign selected_pill_bg = fallback_pill_color -%}
                        <input type="radio" class="c-prod__radio js-variant-radio-{{ section.id }}"
                               name="option-{{ pills_option.position }}"
                               id="pill-{{ section.id }}-{{ pills_option.position }}-{{ forloop.index }}"
                               value="{{ value | escape }}" data-position="{{ pills_option.position }}"
                               {% if pills_option.selected_value == value %}checked{% endif %}>
                        <label class="c-prod__pill-label" for="pill-{{ section.id }}-{{ pills_option.position }}-{{ forloop.index }}" style="--pill-selected-bg: {{ selected_pill_bg }};">
                          <svg class="c-prod__pill-dot" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none"><rect width="16" height="16" rx="8" fill="{% if pill_color != blank %}{{ pill_color }}{% else %}#FFC183{% endif %}"/></svg>
                          <svg class="c-prod__pill-check" xmlns="http://www.w3.org/2000/svg" width="16" height="18" viewBox="0 0 16 18" fill="none"><rect y="1.75018" width="16" height="16" rx="8" fill="#002C41"/><path d="M13 0.750183L6.125 14.7502L3 8.38654" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          {{ display_name }}
                        </label>
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

            {% when 'product_pills' %}
              {%- comment -%}
                Cada sabor es un producto aparte en wholesale: las pills son links
                al producto hermano y la activa es el producto actual.
              {%- endcomment -%}
              <div class="c-prod__variant-group c-prod__variant-group--pills c-prod__product-pills--{{ block.settings.visibility }}" {{ block.shopify_attributes }}>
                <div class="c-prod__pills">
                  {%- for i in (1..4) -%}
                    {%- assign _pp_key = 'product_' | append: i -%}
                    {%- assign _pp_product = block.settings[_pp_key] -%}
                    {%- if _pp_product == blank -%}{%- continue -%}{%- endif -%}
                    {%- assign _pp_label_key = 'label_' | append: i -%}
                    {%- assign _pp_color_key = 'color_' | append: i -%}
                    {%- assign _pp_bg_key = 'selected_bg_' | append: i -%}
                    {%- assign _pp_label = block.settings[_pp_label_key] | default: _pp_product.title -%}
                    {%- assign _pp_active = false -%}
                    {%- if _pp_product.id == product.id -%}{%- assign _pp_active = true -%}{%- endif -%}
                    <a class="c-prod__pill-label{% if _pp_active %} is-active{% endif %}"
                       href="{{ _pp_product.url }}"
                       style="--pill-selected-bg: {{ block.settings[_pp_bg_key] }};"
                       {% if _pp_active %}aria-current="page"{% endif %}>
                      <svg class="c-prod__pill-dot" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect width="16" height="16" rx="8" fill="{{ block.settings[_pp_color_key] }}"/></svg>
                      <svg class="c-prod__pill-check" xmlns="http://www.w3.org/2000/svg" width="16" height="18" viewBox="0 0 16 18" fill="none" aria-hidden="true"><rect y="1.75018" width="16" height="16" rx="8" fill="#002C41"/><path d="M13 0.750183L6.125 14.7502L3 8.38654" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {{ _pp_label }}
                    </a>
                  {%- endfor -%}
                </div>
              </div>

            {% when 'price_stock' %}
              <div {{ block.shopify_attributes }}>
                {%- assign _sel = product.selected_or_first_available_variant -%}
                {%- assign _price_opt_index = 0 -%}
                {%- assign _found_price_opt = false -%}
                {%- for _opt in product.options_with_values -%}
                  {%- unless _found_price_opt -%}
                    {%- for _val in _opt.values -%}
                      {%- if _val contains 'pack' or _val contains 'case' or _val contains 'bundle' -%}
                        {%- assign _price_opt_index = forloop.parentloop.index0 -%}
                        {%- assign _found_price_opt = true -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endunless -%}
                {%- endfor -%}
                {%- if _price_opt_index == 0 -%}{%- assign _price_opt_val = _sel.option1 -%}
                {%- elsif _price_opt_index == 1 -%}{%- assign _price_opt_val = _sel.option2 -%}
                {%- else -%}{%- assign _price_opt_val = _sel.option3 -%}{%- endif -%}
                {%- assign _pp = _price_opt_val | split: ' pack' | first | split: '(' | last | strip -%}
                {%- assign _uc = _pp | plus: 0 -%}
                <div class="c-prod__price-wrap">
                  {%- comment -%} wholesale: el precio por unidad viene del metafield del producto {%- endcomment -%}
                  {%- assign _per_unit_text = product.metafields.custom.price_per_use_1.value -%}
                  <div class="c-prod__price js-price-{{ section.id }}" data-unit-label="{{ block.settings.unit_label | escape }}" data-price-opt-index="{{ _price_opt_index }}">
                    {%- unless product.has_only_default_variant -%}
                      <span class="c-prod__variant-title js-variant-title-{{ section.id }}">{{ _price_opt_val }}: </span>
                    {%- else -%}
                      {%- if block.settings.count_label != blank -%}
                        <span class="c-prod__variant-title">{{ block.settings.count_label }}: </span>
                      {%- endif -%}
                    {%- endunless -%}
                    <span class="js-price-amount-{{ section.id }}">{{ _sel.price | money }}</span>
                    {%- if _per_unit_text != blank -%}
                      <span class="c-prod__per-unit">{{ _per_unit_text }}</span>
                    {%- elsif _uc > 1 -%}
                      <span class="c-prod__per-unit js-per-unit-{{ section.id }}">{{ _sel.price | times: 1.0 | divided_by: _uc | round | money }}/{{ block.settings.unit_label }}</span>
                    {%- else -%}
                      <span class="c-prod__per-unit js-per-unit-{{ section.id }}" style="display:none;"></span>
                    {%- endif -%}
                  </div>
                  <div class="c-prod__stock js-stock-{{ section.id }}">
                    {% if product.selected_or_first_available_variant.available %}
                      <span class="c-prod__stock-dot"></span> In stock 
                    {% else %}
                      <span class="c-prod__stock-dot" style="background:#fca5a5;"></span> Out of stock
                    {% endif %}
                  </div>
                </div>
                {%- assign _retail_text = product.metafields.custom.retail_wholesale.value | default: block.settings.retail_text -%}
                {%- if _retail_text != blank -%}
                  <div class="c-prod__retail-text">{{ _retail_text }}</div>
                {%- endif -%}
                {%- if block.settings.show_payment_terms -%}
                  <div class="c-prod__payment-terms">{{ form | payment_terms }}</div>
                {%- endif -%}
              </div>

            {% when 'highlight_banner' %}
              <div {{ block.shopify_attributes }}>
                <div class="c-prod__highlight">{{ block.settings.text }}</div>
                <div class="c-prod__payment-terms">{{ form | payment_terms }}</div>
              </div>

            {% when 'description_block' %}
              <div {{ block.shopify_attributes }} class="c-prod__desc-block">
                {{ block.settings.description }}
              </div>


            {% when 'ingredients_tab' %}
              <div {{ block.shopify_attributes }}>
                {% if product.handle == 'ortho-super-paste' %}
                  <p class="c-prod__flavor-note">Refreshing &amp; light mint flavor for fresher breath</p>
                {% endif %}
                <button type="button" class="c-prod__ingredients-trigger" data-ingredients-open>
                  {{ block.settings.ingredients_trigger_label }}
                  {%- if section.settings.design_v2 -%}<svg class="c-prod__arrow-v2 c-prod__ingredients-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="12" viewBox="0 0 18 14" fill="none" aria-hidden="true"><path d="M0.75 6.75H16.75M10.75 12.75L16.75 6.75L10.75 0.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- else -%}<svg class="c-prod__ingredients-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>{%- endif -%}
                </button>
                <div class="c-prod__ingredients-modal" data-ingredients-modal aria-hidden="true">
                  <div class="c-prod__ingredients-modal-backdrop" data-ingredients-close></div>
                  <div class="c-prod__ingredients-modal-card" role="dialog" aria-modal="true" aria-label="Ingredient facts">
                    <button type="button" class="c-prod__ingredients-modal-close" data-ingredients-close aria-label="Close">&times;</button>
                    <p class="c-prod__ingredients-modal-subtitle">{{ block.settings.ingredients_modal_subtitle }}</p>
                    <h3 class="c-prod__ingredients-modal-title">{{ block.settings.ingredients_modal_title }}</h3>
                    <div class="c-prod__ingredients-modal-content">
                      {%- assign _has_f1 = false -%}{%- assign _has_f2 = false -%}{%- assign _has_f3 = false -%}
                      {%- if block.settings.ingredients_flavor_1_label != blank -%}{%- assign _has_f1 = true -%}{%- endif -%}
                      {%- if block.settings.ingredients_flavor_2_label != blank -%}{%- assign _has_f2 = true -%}{%- endif -%}
                      {%- if block.settings.ingredients_flavor_3_label != blank -%}{%- assign _has_f3 = true -%}{%- endif -%}
                      {%- if _has_f1 or _has_f2 or _has_f3 -%}
                      <div class="c-prod__ingredients-flavors">
                        {%- if _has_f1 -%}<button type="button" class="c-prod__ingredients-flavor is-active" data-flavor="cool-mint"><span class="c-prod__ingredients-flavor-dot">✓</span>{{ block.settings.ingredients_flavor_1_label }}</button>{%- endif -%}
                        {%- if _has_f2 -%}<button type="button" class="c-prod__ingredients-flavor" data-flavor="orange-mango"><span class="c-prod__ingredients-flavor-dot is-orange"></span>{{ block.settings.ingredients_flavor_2_label }}</button>{%- endif -%}
                        {%- if _has_f3 -%}<button type="button" class="c-prod__ingredients-flavor" data-flavor="watermelon"><span class="c-prod__ingredients-flavor-dot is-watermelon"></span>{{ block.settings.ingredients_flavor_3_label }}</button>{%- endif -%}
                      </div>
                      {%- endif -%}

                      <div class="c-prod__ingredients-table">
                      {%- if block.settings.ingredients_section_1_title != blank -%}<div class="c-prod__ingredients-section-title">{{ block.settings.ingredients_section_1_title }}</div>{%- endif -%}
                      {%- for i in (1..12) -%}
                        {%- assign _nk = 'ingredients_s1_item_' | append: i | append: '_name' -%}
                        {%- assign _tk = 'ingredients_s1_item_' | append: i | append: '_tag' -%}
                        {%- assign _n = block.settings[_nk] -%}{%- assign _t = block.settings[_tk] -%}
                        {%- if _n != blank or _t != blank -%}<div class="c-prod__ingredients-row"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>{{ _n }}</span><span class="c-prod__ingredients-tag">{{ _t }}</span></div>{%- endif -%}
                      {%- endfor -%}

                      {%- if block.settings.ingredients_section_2_title != blank -%}<div class="c-prod__ingredients-section-title">{{ block.settings.ingredients_section_2_title }}</div>{%- endif -%}
                      {%- for i in (1..12) -%}
                        {%- assign _nk = 'ingredients_s2_item_' | append: i | append: '_name' -%}
                        {%- assign _tk = 'ingredients_s2_item_' | append: i | append: '_tag' -%}
                        {%- assign _n = block.settings[_nk] -%}{%- assign _t = block.settings[_tk] -%}
                        {%- if _n != blank or _t != blank -%}<div class="c-prod__ingredients-row"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>{{ _n }}</span><span class="c-prod__ingredients-tag">{{ _t }}</span></div>{%- endif -%}
                      {%- endfor -%}

                      {%- if block.settings.ingredients_section_3_title != blank -%}<div class="c-prod__ingredients-section-title">{{ block.settings.ingredients_section_3_title }}</div>{%- endif -%}
                      {%- for i in (1..12) -%}
                        {%- assign _nk = 'ingredients_s3_item_' | append: i | append: '_name' -%}
                        {%- assign _tk = 'ingredients_s3_item_' | append: i | append: '_tag' -%}
                        {%- assign _n = block.settings[_nk] -%}{%- assign _t = block.settings[_tk] -%}
                        {%- if _n != blank or _t != blank -%}<div class="c-prod__ingredients-row"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>{{ _n }}</span><span class="c-prod__ingredients-tag">{{ _t }}</span></div>{%- endif -%}
                      {%- endfor -%}

                      {%- if block.settings.ingredients_section_4_title != blank -%}<div class="c-prod__ingredients-section-title">{{ block.settings.ingredients_section_4_title }}</div>{%- endif -%}
                      {%- for i in (1..12) -%}
                        {%- assign _nk = 'ingredients_s4_item_' | append: i | append: '_name' -%}
                        {%- assign _tk = 'ingredients_s4_item_' | append: i | append: '_tag' -%}
                        {%- assign _n = block.settings[_nk] -%}{%- assign _t = block.settings[_tk] -%}
                        {%- if _n != blank or _t != blank -%}<div class="c-prod__ingredients-row"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>{{ _n }}</span><span class="c-prod__ingredients-tag">{{ _t }}</span></div>{%- endif -%}
                      {%- endfor -%}

                      {%- if block.settings.ingredients_section_5_title != blank -%}<div class="c-prod__ingredients-section-title">{{ block.settings.ingredients_section_5_title }}</div>{%- endif -%}
                      {%- for i in (1..12) -%}
                        {%- assign _nk = 'ingredients_s5_item_' | append: i | append: '_name' -%}
                        {%- assign _tk = 'ingredients_s5_item_' | append: i | append: '_tag' -%}
                        {%- assign _n = block.settings[_nk] -%}{%- assign _t = block.settings[_tk] -%}
                        {%- if _n != blank or _t != blank -%}<div class="c-prod__ingredients-row"><span class="c-prod__ingredients-name"><span class="c-prod__ingredients-bullet"></span>{{ _n }}</span><span class="c-prod__ingredients-tag">{{ _t }}</span></div>{%- endif -%}
                      {%- endfor -%}

                      <div class="c-prod__ingredients-negative">
                        <p class="c-prod__ingredients-negative-title">{{ block.settings.ingredients_negative_title }}</p>
                        <div class="c-prod__ingredients-negative-grid">
                          {% if block.settings.ingredients_negative_item_1 != blank %}<span class="c-prod__ingredients-negative-item">{{ block.settings.ingredients_negative_item_1 }}</span>{% endif %}
                          {% if block.settings.ingredients_negative_item_2 != blank %}<span class="c-prod__ingredients-negative-item">{{ block.settings.ingredients_negative_item_2 }}</span>{% endif %}
