<script>
function overrideShopifyPadding() {
  const shopifyCheckout = document.querySelector('shopify-accelerated-checkout');
  
  if (shopifyCheckout && shopifyCheckout.shadowRoot) {
    const style = document.createElement('style');
    style.textContent = `
      .accelerated-checkout-button {
        --gravity-button-padding: 20px 20px !important;
      }
    `;
    shopifyCheckout.shadowRoot.appendChild(style);
  }
  
  // También en el head global
  const globalStyle = document.createElement('style');
  globalStyle.textContent = `
    .accelerated-checkout-button {
      --gravity-button-padding: 20px 20px !important;
    }
  `;
  document.head.appendChild(globalStyle);
}

// Con observer por si se reenderiza
const observer = new MutationObserver(overrideShopifyPadding);
observer.observe(document.body, { childList: true, subtree: true });

overrideShopifyPadding();
</script>

{% schema %}
{
  "name": "C - Main Product v2",
