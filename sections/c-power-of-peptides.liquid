{%- comment -%}
  Section: The Power of Peptides
  Description: Two-column layout — left: science image with title and caption;
               right: eyebrow, main heading, body text, bullet-point feature list, footnote.
  sl-id: sl-section-power-of-peptides-v1
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap');

  /* ================================================
     ROOT
     ================================================ */
  #c-pop-{{ section.id }} {
    --pop-bg:          {{ section.settings.bg_color }};
    --pop-left-bg:     {{ section.settings.left_col_bg }};
    --pop-right-bg:    {{ section.settings.right_col_bg }};
    --pop-text-dark:   {{ section.settings.text_color }};
    --pop-text-body:   {{ section.settings.body_color }};
    --pop-eyebrow:     {{ section.settings.eyebrow_color }};
    --pop-bullet-dot:       {{ section.settings.bullet_dot_color }};
    --pop-divider:          {{ section.settings.divider_color }};
    --pop-item-title-color: {{ section.settings.item_title_color }};
    --pop-item-desc-color:  {{ section.settings.item_desc_color }};
    --pop-dot-size:         {{ section.settings.dot_size }}px;

    font-family: 'Raleway', sans-serif;
    background-color: var(--pop-bg);
    width: 100%;
  }

  /* ================================================
     WRAPPER
     ================================================ */
  #c-pop-{{ section.id }} .pop__wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* ================================================
     LEFT COLUMN — image + title + caption
     ================================================ */
  #c-pop-{{ section.id }} .pop__left {
    background-color: var(--pop-left-bg);
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    order: 2;
  }

  #c-pop-{{ section.id }} .pop__image-wrap {
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }

  #c-pop-{{ section.id }} .pop__image-wrap img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: {{ section.settings.img_radius }}px;
  }

  /* ================================================
     RIGHT COLUMN — eyebrow, title, body, bullets
     ================================================ */
  #c-pop-{{ section.id }} .pop__right {
    background-color: var(--pop-right-bg);
    padding: {{ section.settings.pad_top_mob }}px 24px {{ section.settings.pad_bot_mob }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    order: 1;
  }

  #c-pop-{{ section.id }} .pop__eyebrow {
    font-size: {{ section.settings.eyebrow_size_mob }}px;
    font-weight: {{ section.settings.eyebrow_weight_mob }};
    font-family: 'Raleway', sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pop-eyebrow);
    margin: 0 0 12px 0;
  }

  #c-pop-{{ section.id }} .pop__title {
    font-size: {{ section.settings.title_size_mob }}px;
    font-weight: {{ section.settings.title_weight_mob }};
    font-family: 'Raleway', sans-serif;
    color: var(--pop-text-dark);
    line-height: 1.1;
    margin: 0 0 18px 0;
  }

  #c-pop-{{ section.id }} .pop__subtitle {
    font-size: {{ section.settings.subtitle_size_mob }}px;
    font-weight: {{ section.settings.subtitle_weight_mob }};
    font-family: 'Raleway', sans-serif;
    color: {{ section.settings.subtitle_color }};
    line-height: 1.2;
    margin: 0 0 18px 0;
  }

  #c-pop-{{ section.id }} .pop__body {
    font-size: {{ section.settings.body_size_mob }}px;
    font-weight: {{ section.settings.body_weight_mob }};
    font-family: 'Raleway', sans-serif;
    color: var(--pop-text-body);
    line-height: 1.7;
    margin: 0 0 32px 0;
  }

  #c-pop-{{ section.id }} .pop__body p {
    margin: 0 0 6px 0;
  }

  #c-pop-{{ section.id }} .pop__body p:last-child {
    margin-bottom: 0;
  }

  /* ================================================
     TIMELINE
     ================================================ */
  #c-pop-{{ section.id }} .pop__items {
    list-style: none;
    margin: 0 0 24px 0;
    padding: 0;
    position: relative;
  }

  /* Vertical connector line between first and last dot */
  #c-pop-{{ section.id }} .pop__items::before {
    content: '';
    position: absolute;
    left: calc(var(--pop-dot-size) / 2 - 1px);
    width: 2px;
    top: calc(5px + var(--pop-dot-size));
    bottom: calc(5px + var(--pop-dot-size));
    background-color: var(--pop-divider);
  }

  #c-pop-{{ section.id }} .pop__item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 0 0 28px 0;
  }

  #c-pop-{{ section.id }} .pop__item:last-child {
    padding-bottom: 0;
  }

  #c-pop-{{ section.id }} .pop__dot {
    flex-shrink: 0;
    width: var(--pop-dot-size);
    height: var(--pop-dot-size);
    border-radius: 50%;
    background-color: var(--pop-bullet-dot);
    margin-top: 5px;
    position: relative;
    z-index: 1;
  }

  #c-pop-{{ section.id }} .pop__item-content {
    flex: 1;
  }

  #c-pop-{{ section.id }} .pop__item-title {
    font-size: {{ section.settings.item_title_size_mob }}px;
    font-weight: {{ section.settings.item_title_weight_mob }};
    font-family: 'Raleway', sans-serif;
    color: var(--pop-item-title-color);
    margin: 0 0 5px 0;
    line-height: 1.25;
  }

  #c-pop-{{ section.id }} .pop__item-desc {
    font-size: {{ section.settings.item_desc_size_mob }}px;
    font-weight: {{ section.settings.item_desc_weight_mob }};
    font-family: 'Raleway', sans-serif;
    color: var(--pop-item-desc-color);
    line-height: 1.6;
    margin: 0;
  }

  /* ================================================
     FOOTNOTE
     ================================================ */
  #c-pop-{{ section.id }} .pop__footnote {
    font-size: {{ section.settings.footnote_size_mob }}px;
    font-style: italic;
    font-weight: {{ section.settings.footnote_weight_mob }};
    font-family: 'Raleway', sans-serif;
    color: var(--pop-text-body);
    line-height: 1.5;
    margin: 24px 0 0 0;
  }

  /* ================================================
     BREAKPOINT: 768px — side by side
     ================================================ */
  @media (min-width: 768px) {
    #c-pop-{{ section.id }} .pop__wrapper {
      flex-direction: {% if section.settings.image_position == 'right' %}row-reverse{% else %}row{% endif %};
      min-height: {{ section.settings.min_height_desk }}px;
    }

    #c-pop-{{ section.id }} .pop__left {
      width: {{ section.settings.left_col_width }}%;
      flex-shrink: 0;
      padding: {{ section.settings.pad_top_desk }}px 40px {{ section.settings.pad_bot_desk }}px;
      order: 0;
      align-items: flex-start;
    }

    #c-pop-{{ section.id }} .pop__image-wrap {
      max-width: 100%;
    }

    #c-pop-{{ section.id }} .pop__right {
      width: calc(100% - {{ section.settings.left_col_width }}%);
      padding: {{ section.settings.pad_top_desk }}px 52px {{ section.settings.pad_bot_desk }}px 48px;
      order: 0;
    }

    #c-pop-{{ section.id }} .pop__eyebrow {
      font-size: {{ section.settings.eyebrow_size_desk }}px;
      font-weight: {{ section.settings.eyebrow_weight_desk }};
    }

    #c-pop-{{ section.id }} .pop__title {
      font-size: {{ section.settings.title_size_desk }}px;
      font-weight: {{ section.settings.title_weight_desk }};
    }

    #c-pop-{{ section.id }} .pop__subtitle {
      font-size: {{ section.settings.subtitle_size_desk }}px;
      font-weight: {{ section.settings.subtitle_weight_desk }};
    }

    #c-pop-{{ section.id }} .pop__body {
      font-size: {{ section.settings.body_size_desk }}px;
      font-weight: {{ section.settings.body_weight_desk }};
    }

    #c-pop-{{ section.id }} .pop__item-title {
      font-size: {{ section.settings.item_title_size_desk }}px;
      font-weight: {{ section.settings.item_title_weight_desk }};
    }

    #c-pop-{{ section.id }} .pop__item-desc {
      font-size: {{ section.settings.item_desc_size_desk }}px;
      font-weight: {{ section.settings.item_desc_weight_desk }};
    }

    #c-pop-{{ section.id }} .pop__footnote {
      font-size: {{ section.settings.footnote_size_desk }}px;
      font-weight: {{ section.settings.footnote_weight_desk }};
    }

    #c-pop-{{ section.id }} .pop__image-wrap {
      max-width: 100%;
    }
  }
{%- endstyle -%}

<section id="c-pop-{{ section.id }}" aria-label="{{ section.settings.title | escape }}">
  <div class="pop__wrapper">

    {%- comment -%} ── LEFT COLUMN ── {%- endcomment -%}
    <div class="pop__left">
      {%- if section.settings.image != blank -%}
        <div class="pop__image-wrap">
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag: loading: 'lazy', alt: section.settings.image.alt
          }}
        </div>
      {%- else -%}
        <div class="pop__image-wrap">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── RIGHT COLUMN ── {%- endcomment -%}
    <div class="pop__right">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pop__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="pop__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="pop__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="pop__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="pop__items">
          {%- for block in section.blocks -%}
            {%- if block.type == 'bullet_item' -%}
              <li class="pop__item" {{ block.shopify_attributes }}>
                <span class="pop__dot" aria-hidden="true"></span>
                <div class="pop__item-content">
                  {%- if block.settings.item_title != blank -%}
                    <p class="pop__item-title">{{ block.settings.item_title }}</p>
                  {%- endif -%}
                  {%- if block.settings.item_desc != blank -%}
                    <p class="pop__item-desc">{{ block.settings.item_desc }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.footnote != blank -%}
        <p class="pop__footnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    </div>

  </div>
</section>

