{%- style -%}
  #shopify-section-{{ section.id }} .c-science-split {
    position: relative; width: 100%; background-size: cover; background-position: center;
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.p_top_mob }}px; padding-bottom: {{ section.settings.p_bot_mob }}px;
  }

  .c-science-title { margin-bottom: {{ section.settings.space_title_copy }}px; line-height: 1.2; }

  /* Ajuste específico para iconos */
  .c-badge-icon {
    width: 25px !important;
    height: 25px !important;
    flex-shrink: 0;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .c-col-badges { align-items: flex-end;padding: 0em 10px !important;}
    #shopify-section-{{ section.id }} .c-science-split {
      {%- if section.settings.bg_img_mob != blank -%}
        background-image: url('{{ section.settings.bg_img_mob | image_url: width: 800 }}');
      {%- endif -%}
    }
    .c-science-container { flex-direction: column-reverse; padding: 35rem 3em 0em !important; margin-bottom: 0; }
    .c-science-title { 
      font-size: {{ section.settings.fs_title_mob }}px !important; 
      max-width: {{ section.settings.mw_title_mob }}px; 
    }
    .c-science-body { font-size: {{ section.settings.fs_text_mob }}px !important; }
    .c-badge-item { font-size: {{ section.settings.fs_badge_mob }}px !important; }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .c-science-split {
      padding-top: {{ section.settings.p_top_desk }}px; padding-bottom: {{ section.settings.p_bot_desk }}px;
      {%- if section.settings.bg_img_desk != blank -%}
        background-image: url('{{ section.settings.bg_img_desk | image_url: width: 2000 }}');
      {%- endif -%}
    }
    .c-science-container { flex-direction: row !important; align-items: flex-start; justify-content: space-between; }
    .c-col-text, .c-col-badges { flex: 0 0 50%; width: 50%; }
    .c-col-badges { align-items: flex-end;}
    .c-science-title { 
      font-size: {{ section.settings.fs_title_desk }}px !important; 
      max-width: {{ section.settings.mw_title_desk }}px; 
    }
    .c-science-body { font-size: {{ section.settings.fs_text_desk }}px !important; }
    .c-badge-item { font-size: {{ section.settings.fs_badge_desk }}px !important; }
  }

  .c-science-container { max-width: {{ section.settings.max_width }}px; margin: 0 auto; display: flex; gap: 40px; padding: 0 20px; }
  .c-col-badges { display: flex; flex-direction: column; gap: 20px; padding: 17em 20px; }
  .c-badge-item { 
    display: flex; align-items: flex-start; gap: 15px; background: #ffffffc4; 
    padding: 15px; border-radius: 12px; 
    color: {{ section.settings.badge_text_color }}; max-width: 350px; width: 100%;
  }
{%- endstyle -%}

