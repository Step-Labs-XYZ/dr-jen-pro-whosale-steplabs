{% schema %}
{
  "name": "C - Science Study Pro",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Color Fondo", "default": "#ffffff" },
    { "type": "image_picker", "id": "bg_img_desk", "label": "Fondo Desktop" },
    { "type": "image_picker", "id": "bg_img_mob", "label": "Fondo Mobile" },
    { "type": "text", "id": "title", "label": "Título", "default": "Breakthrough Study" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "image_picker", "id": "img_table", "label": "Imagen Tabla" },
    { "type": "text", "id": "badge_text_1", "label": "Texto Badge 1" },
    { "type": "text", "id": "badge_text_2", "label": "Texto Badge 2" },
    { "type": "color", "id": "badge_bg", "label": "Fondo Badge", "default": "#ffffff" },
    { "type": "color", "id": "badge_text_color", "label": "Color Texto Badge", "default": "#000000" },
    { "type": "range", "id": "max_width", "min": 800, "max": 1600, "step": 50, "label": "Ancho Máximo Contenedor", "default": 1200 },
    { "type": "range", "id": "space_title_copy", "min": 0, "max": 100, "step": 5, "label": "Espacio Título - Copy (px)", "default": 20 },
    { "type": "range", "id": "mw_title_desk", "min": 200, "max": 1000, "step": 20, "label": "Ancho Máx Título Desktop", "default": 600 },
    { "type": "range", "id": "mw_title_mob", "min": 100, "max": 500, "step": 10, "label": "Ancho Máx Título Mobile", "default": 300 },
    { "type": "range", "id": "fs_title_desk", "min": 20, "max": 80, "step": 2, "label": "Título Desktop", "default": 42 },
    { "type": "range", "id": "fs_title_mob", "min": 16, "max": 60, "step": 2, "label": "Título Mobile", "default": 28 },
    { "type": "range", "id": "fs_text_desk", "min": 12, "max": 24, "step": 1, "label": "Texto Desktop", "default": 16 },
    { "type": "range", "id": "fs_text_mob", "min": 10, "max": 20, "step": 1, "label": "Texto Mobile", "default": 14 },
    { "type": "range", "id": "fs_badge_desk", "min": 10, "max": 24, "step": 1, "label": "Badges Desktop", "default": 16 },
    { "type": "range", "id": "fs_badge_mob", "min": 10, "max": 20, "step": 1, "label": "Badges Mobile", "default": 14 },
    { "type": "range", "id": "p_top_desk", "min": 0, "max": 200, "step": 4, "label": "Padding Top Desk", "default": 80 },
    { "type": "range", "id": "p_bot_desk", "min": 0, "max": 200, "step": 4, "label": "Padding Bottom Desk", "default": 80 },
    { "type": "range", "id": "p_top_mob", "min": 0, "max": 100, "step": 2, "label": "Padding Top Mob", "default": 40 },
    { "type": "range", "id": "p_bot_mob", "min": 0, "max": 100, "step": 2, "label": "Padding Bottom Mob", "default": 40 }
  ],
  "presets": [{ "name": "C - Science Study Pro" }]
}
{% endschema %}