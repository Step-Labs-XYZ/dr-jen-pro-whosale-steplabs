{% comment %} C nHAp Comparison Section {% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Raleway:wght@100;200;300;400;500;600;700;800;900&display=swap');

  #c-nhap-{{ section.id }} {
    padding: {{ section.settings.padding_top_mobile }}px 20px {{ section.settings.padding_bottom_mobile }}px;
    background-color: {{ section.settings.bg_color }};
    font-family: 'Raleway', sans-serif;
  }
  @media (min-width: 768px) {
    #c-nhap-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    }
  }
  #c-nhap-{{ section.id }} .c-nhap__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }
  #c-nhap-{{ section.id }} .c-nhap__heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    margin-bottom: 10px;
    line-height: 1.2;
    font-family: 'Raleway', sans-serif;
  }
  @media (min-width: 768px) {
    #c-nhap-{{ section.id }} .c-nhap__heading {
      font-size: {{ section.settings.heading_size }}px;
    }
  }
  #c-nhap-{{ section.id }} .c-nhap__subheading {
    font-size: {{ section.settings.subheading_size_mobile }}px;
    font-weight: {{ section.settings.subheading_font_weight }};
    color: {{ section.settings.subheading_color }};
    margin-bottom: {{ section.settings.subheading_margin_bottom_mobile }}px;
    line-height: 1.6;
    font-family: 'Raleway', sans-serif;
  }
  @media (min-width: 768px) {
    #c-nhap-{{ section.id }} .c-nhap__subheading {
      font-size: {{ section.settings.subheading_size }}px;
      margin-bottom: {{ section.settings.subheading_margin_bottom }}px;
    }
  }
  #c-nhap-{{ section.id }} .c-nhap__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.grid_gap_mobile }}px;
  }
  @media (min-width: 768px) {
    #c-nhap-{{ section.id }} .c-nhap__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: {{ section.settings.grid_gap }}px;
    }
  }

  /* CARD */
  #c-nhap-{{ section.id }} .c-nhap__card {
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    border: 1px solid #e8e8e8;
    display: flex;
    flex-direction: column;
    background: {{ section.settings.card_bg_color }};
  }

  /* HEADER */
  #c-nhap-{{ section.id }} .c-nhap__card-header {
    padding: {{ section.settings.card_header_padding_v }}px {{ section.settings.card_header_padding_h }}px;
    text-align: center;
  }
  #c-nhap-{{ section.id }} .c-nhap__card--low .c-nhap__card-header     { background: {{ section.settings.col1_header_bg }}; }
  #c-nhap-{{ section.id }} .c-nhap__card--mid .c-nhap__card-header     { background: {{ section.settings.col2_header_bg }}; }
  #c-nhap-{{ section.id }} .c-nhap__card--premium .c-nhap__card-header { background: {{ section.settings.col3_header_bg }}; }

  #c-nhap-{{ section.id }} .c-nhap__card-label {
    font-size: {{ section.settings.card_label_size }}px;
    font-weight: {{ section.settings.card_label_font_weight }};
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ section.settings.card_label_color }};
    margin-bottom: 0px;
    display: block;
    font-family: 'Raleway', sans-serif;
  }
  #c-nhap-{{ section.id }} .c-nhap__card-title {
    font-size: {{ section.settings.card_title_size_mobile }}px;
    font-weight: {{ section.settings.card_title_font_weight }};
    color: {{ section.settings.card_title_color }};
    line-height: 1.1;
    margin-bottom: 6px;
    display: block;
    font-family: 'Raleway', sans-serif;
  }
  @media (min-width: 768px) {
    #c-nhap-{{ section.id }} .c-nhap__card-title {
      font-size: {{ section.settings.card_title_size }}px;
    }
  }
  #c-nhap-{{ section.id }} .c-nhap__card-subtitle {
    font-size: {{ section.settings.card_subtitle_size }}px;
    font-weight: {{ section.settings.card_subtitle_font_weight }};
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ section.settings.card_subtitle_color }};
    display: block;
    font-family: 'Raleway', sans-serif;
  }

  /* IMAGE */
  #c-nhap-{{ section.id }} .c-nhap__card-image-wrap {
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    background: #111;
    overflow: hidden;
    flex-shrink: 0;
  }
  #c-nhap-{{ section.id }} .c-nhap__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* LIST — always 1 column */
  #c-nhap-{{ section.id }} .c-nhap__card-list {
    padding: {{ section.settings.list_padding_v }}px {{ section.settings.list_padding_h }}px;
    list-style: none;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.list_gap }}px;
    flex: 1;
  }
  #c-nhap-{{ section.id }} .c-nhap__card-list-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: {{ section.settings.list_item_size }}px;
    font-weight: {{ section.settings.list_item_font_weight }};
    color: {{ section.settings.list_item_color }};
    line-height: 1.4;
    font-family: 'Raleway', sans-serif;
  }
  #c-nhap-{{ section.id }} .c-nhap__card-list-item svg {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }

  /* FOOTER */
  #c-nhap-{{ section.id }} .c-nhap__card-footer {
    padding: {{ section.settings.footer_padding_v }}px {{ section.settings.footer_padding_h }}px;
    display: flex;
    align-items: center;
    gap: {{ section.settings.footer_gap }}px;
  }
  #c-nhap-{{ section.id }} .c-nhap__card--low .c-nhap__card-footer     { background: {{ section.settings.col1_footer_bg }}; }
  #c-nhap-{{ section.id }} .c-nhap__card--mid .c-nhap__card-footer     { background: {{ section.settings.col2_footer_bg }}; }
  #c-nhap-{{ section.id }} .c-nhap__card--premium .c-nhap__card-footer { background: {{ section.settings.col3_footer_bg }}; }
  #c-nhap-{{ section.id }} .c-nhap__card-footer-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #c-nhap-{{ section.id }} .c-nhap__card-footer-icon svg {
    width: 36px;
    height: 36px;
  }
  #c-nhap-{{ section.id }} .c-nhap__card-footer-title {
    font-size: {{ section.settings.footer_title_size }}px;
    font-weight: {{ section.settings.footer_title_font_weight }};
    color: {{ section.settings.footer_text_color }};
    margin-bottom: 3px;
    line-height: 1.3;
    font-family: 'Raleway', sans-serif;
  }
  #c-nhap-{{ section.id }} .c-nhap__card-footer-text {
    font-size: {{ section.settings.footer_body_size }}px;
    font-weight: {{ section.settings.footer_body_font_weight }};
    color: {{ section.settings.footer_text_color }};
    opacity: 0.9;
    line-height: 1.5;
    font-family: 'Raleway', sans-serif;
  }
</style>

<section id="c-nhap-{{ section.id }}">
  <div class="c-nhap__inner">

    {% if section.settings.heading != blank %}
      <h2 class="c-nhap__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="c-nhap__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="c-nhap__grid">

      {% comment %} ── CARD 1 – LOW GRADE ── {% endcomment %}
      <div class="c-nhap__card c-nhap__card--low">
        <div class="c-nhap__card-header">
          {% if section.settings.col1_label != blank %}
            <span class="c-nhap__card-label">{{ section.settings.col1_label }}</span>
          {% endif %}
          {% if section.settings.col1_title != blank %}
            <span class="c-nhap__card-title">{{ section.settings.col1_title }}</span>
          {% endif %}
          {% if section.settings.col1_subtitle != blank %}
            <span class="c-nhap__card-subtitle">{{ section.settings.col1_subtitle }}</span>
          {% endif %}
        </div>
        <div class="c-nhap__card-image-wrap">
          {% if section.settings.col1_image != blank %}
            {{ section.settings.col1_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'c-nhap__card-image', alt: section.settings.col1_title }}
          {% endif %}
        </div>
        <ul class="c-nhap__card-list">
          {% for i in (1..6) %}
            {% assign text_key = 'col1_item' | append: i %}
            {% if section.settings[text_key] != blank %}
              <li class="c-nhap__card-list-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 12 12" fill="none">
                  <path d="M7.5 4.5L4.5 7.5" stroke="#CD6666" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M4.5 4.5L7.5 7.5" stroke="#CD6666" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M6 10.5C8.48528 10.5 10.5 8.48528 10.5 6C10.5 3.51472 8.48528 1.5 6 1.5C3.51472 1.5 1.5 3.51472 1.5 6C1.5 8.48528 3.51472 10.5 6 10.5Z" stroke="#CD6666" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ section.settings[text_key] }}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
        <div class="c-nhap__card-footer">
          <div class="c-nhap__card-footer-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 54 54" fill="none">
              <path d="M33.75 20.25L20.25 33.75" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M20.25 20.25L33.75 33.75" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M27 47.25C38.1838 47.25 47.25 38.1838 47.25 27C47.25 15.8162 38.1838 6.75 27 6.75C15.8162 6.75 6.75 15.8162 6.75 27C6.75 38.1838 15.8162 47.25 27 47.25Z" stroke="white" stroke-width="2" stroke-miterlimit="10"/>
            </svg>
          </div>
          <div>
            {% if section.settings.col1_footer_title != blank %}
              <p class="c-nhap__card-footer-title">{{ section.settings.col1_footer_title }}</p>
            {% endif %}
            {% if section.settings.col1_footer_text != blank %}
              <p class="c-nhap__card-footer-text">{{ section.settings.col1_footer_text }}</p>
            {% endif %}
          </div>
        </div>
      </div>

      {% comment %} ── CARD 2 – MID RANGE ── {% endcomment %}
      <div class="c-nhap__card c-nhap__card--mid">
        <div class="c-nhap__card-header">
          {% if section.settings.col2_label != blank %}
            <span class="c-nhap__card-label">{{ section.settings.col2_label }}</span>
          {% endif %}
          {% if section.settings.col2_title != blank %}
            <span class="c-nhap__card-title">{{ section.settings.col2_title }}</span>
          {% endif %}
          {% if section.settings.col2_subtitle != blank %}
            <span class="c-nhap__card-subtitle">{{ section.settings.col2_subtitle }}</span>
          {% endif %}
        </div>
        <div class="c-nhap__card-image-wrap">
          {% if section.settings.col2_image != blank %}
            {{ section.settings.col2_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'c-nhap__card-image', alt: section.settings.col2_title }}
          {% endif %}
        </div>
        <ul class="c-nhap__card-list">
          {% for i in (1..6) %}
            {% assign text_key = 'col2_item' | append: i %}
            {% if section.settings[text_key] != blank %}
              <li class="c-nhap__card-list-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 12 12" fill="none">
                  <path d="M4.125 6H7.875" stroke="#343330" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M6 10.5C8.48528 10.5 10.5 8.48528 10.5 6C10.5 3.51472 8.48528 1.5 6 1.5C3.51472 1.5 1.5 3.51472 1.5 6C1.5 8.48528 3.51472 10.5 6 10.5Z" stroke="#343330" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ section.settings[text_key] }}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
        <div class="c-nhap__card-footer">
          <div class="c-nhap__card-footer-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 54 54" fill="none">
              <path d="M18.5625 27H35.4375" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M27 47.25C38.1838 47.25 47.25 38.1838 47.25 27C47.25 15.8162 38.1838 6.75 27 6.75C15.8162 6.75 6.75 15.8162 6.75 27C6.75 38.1838 15.8162 47.25 27 47.25Z" stroke="white" stroke-width="2" stroke-miterlimit="10"/>
            </svg>
          </div>
          <div>
            {% if section.settings.col2_footer_title != blank %}
              <p class="c-nhap__card-footer-title">{{ section.settings.col2_footer_title }}</p>
            {% endif %}
            {% if section.settings.col2_footer_text != blank %}
              <p class="c-nhap__card-footer-text">{{ section.settings.col2_footer_text }}</p>
            {% endif %}
          </div>
        </div>
      </div>

      {% comment %} ── CARD 3 – PREMIUM ── {% endcomment %}
      <div class="c-nhap__card c-nhap__card--premium">
        <div class="c-nhap__card-header">
          {% if section.settings.col3_label != blank %}
            <span class="c-nhap__card-label">{{ section.settings.col3_label }}</span>
          {% endif %}
          {% if section.settings.col3_title != blank %}
            <span class="c-nhap__card-title">{{ section.settings.col3_title }}</span>
          {% endif %}
          {% if section.settings.col3_subtitle != blank %}
            <span class="c-nhap__card-subtitle">{{ section.settings.col3_subtitle }}</span>
          {% endif %}
        </div>
        <div class="c-nhap__card-image-wrap">
          {% if section.settings.col3_image != blank %}
            {{ section.settings.col3_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'c-nhap__card-image', alt: section.settings.col3_title }}
          {% endif %}
        </div>
        <ul class="c-nhap__card-list">
          {% for i in (1..6) %}
            {% assign text_key = 'col3_item' | append: i %}
            {% if section.settings[text_key] != blank %}
              <li class="c-nhap__card-list-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M8.25 12.75L10.5 15L15.75 9.75" stroke="#0862DF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 16.9706 7.02944 21 12 21Z" stroke="#0862DF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ section.settings[text_key] }}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
        <div class="c-nhap__card-footer">
          <div class="c-nhap__card-footer-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 54 54" fill="none">
              <path d="M18.5625 28.6875L23.625 33.75L35.4375 21.9375" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M27 47.25C38.1838 47.25 47.25 38.1838 47.25 27C47.25 15.8162 38.1838 6.75 27 6.75C15.8162 6.75 6.75 15.8162 6.75 27C6.75 38.1838 15.8162 47.25 27 47.25Z" stroke="white" stroke-width="2" stroke-miterlimit="10"/>
            </svg>
          </div>
          <div>
            {% if section.settings.col3_footer_title != blank %}
              <p class="c-nhap__card-footer-title">{{ section.settings.col3_footer_title }}</p>
            {% endif %}
            {% if section.settings.col3_footer_text != blank %}
              <p class="c-nhap__card-footer-text">{{ section.settings.col3_footer_text }}</p>
            {% endif %}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "C nHAp Comparison",
  "tag": "section",
  "class": "section c-nhap-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not All Nano-Hydroxyapatite is Create Equal"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The quality, purity, and crystal structure of nHAp directly impact biocompatibility, safety, and remineralization."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 800,
      "max": 1600,
      "step": 20,
      "default": 1200
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap — Desktop (px)",
      "min": 8,
      "max": 60,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "label": "Grid gap — Mobile (px)",
      "min": 8,
      "max": 40,
      "step": 4,
      "default": 20
    },
    {
      "type": "header",
      "content": "Heading Typography"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size — Desktop (px)",
      "min": 20,
      "max": 60,
      "step": 1,
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size — Mobile (px)",
      "min": 16,
      "max": 48,
      "step": 1,
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "100", "label": "100 — Thin" },
        { "value": "200", "label": "200 — Extra Light" },
        { "value": "300", "label": "300 — Light" },
        { "value": "400", "label": "400 — Regular" },
        { "value": "500", "label": "500 — Medium" },
        { "value": "600", "label": "600 — Semi Bold" },
        { "value": "700", "label": "700 — Bold" },
        { "value": "800", "label": "800 — Extra Bold" },
        { "value": "900", "label": "900 — Black" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#4a4a4a"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size — Desktop (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading size — Mobile (px)",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "Subheading font weight",
      "options": [
        { "value": "100", "label": "100 — Thin" },
        { "value": "200", "label": "200 — Extra Light" },
        { "value": "300", "label": "300 — Light" },
        { "value": "400", "label": "400 — Regular" },
        { "value": "500", "label": "500 — Medium" },
        { "value": "600", "label": "600 — Semi Bold" },
        { "value": "700", "label": "700 — Bold" },
        { "value": "800", "label": "800 — Extra Bold" },
        { "value": "900", "label": "900 — Black" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "subheading_margin_bottom",
      "label": "Subheading bottom space — Desktop (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "subheading_margin_bottom_mobile",
      "label": "Subheading bottom space — Mobile (px)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 32
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — Desktop (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — Desktop (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — Mobile (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — Mobile (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 40
    },
    {
      "type": "header",
      "content": "Card Styles"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "card_header_padding_v",
      "label": "Card header padding vertical (px)",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
