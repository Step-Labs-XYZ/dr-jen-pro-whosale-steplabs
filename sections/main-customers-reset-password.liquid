{%- comment -%}
  Reset password (the link in Shopify's password reset email). Same look as the sign-in
  redesign (snippets/c-account-form-styles). Copy is editable; blank falls back to the
  theme's translations. After a reorder sign-in, snippets/c-reorder-global sends the
  customer back to the reorder page once the new password lands them on /account.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  comment
    Each text: the editor value, else the theme translation.
  endcomment
  assign title = s.title
  if title == blank
    assign title = 'customer.reset_password.title' | t
  endif
  assign text = s.text
  if text == blank
    assign text = 'customer.reset_password.instructions' | t
  endif
  assign password_label = s.password_label
  if password_label == blank
    assign password_label = 'customer.reset_password.password' | t
  endif
  assign confirm_label = s.confirm_label
  if confirm_label == blank
    assign confirm_label = 'customer.reset_password.password_confirmation' | t
  endif
  assign submit_label = s.submit_label
  if submit_label == blank
    assign submit_label = 'customer.reset_password.submit' | t
  endif
-%}

{%- render 'c-account-form-styles' -%}

<section class="c-acct">
  <div class="c-acct__inner">
    {%- if s.eyebrow != blank -%}<p class="c-acct__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h1 class="c-acct__title">{{ title }}</h1>
    {%- if text != blank -%}<p class="c-acct__text">{{ text }}</p>{%- endif -%}

    {%- form 'reset_customer_password', name: 'reset', class: 'c-acct__form', id: 'reset-customer-password' -%}
      {%- if form.errors -%}
        <div class="c-acct__error" id="reset-form-error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="c-acct__field">
        <label for="reset-password">{{ password_label }}</label>
        <input type="password" id="reset-password" name="customer[password]" required autocomplete="new-password" {% if form.errors %}aria-invalid="true" aria-describedby="reset-form-error"{% endif %}>
      </div>

      <div class="c-acct__field">
        <label for="reset-password-confirmation">{{ confirm_label }}</label>
        <input type="password" id="reset-password-confirmation" name="customer[password_confirmation]" required autocomplete="new-password">
      </div>

      <button type="submit" class="c-acct__submit">{{ submit_label }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Customer reset password",
  "class": "shopify-section--main-customers-reset-password",
  "settings": [
    { "type": "paragraph", "content": "Page opened from the password reset email. Leave a field empty to use the theme's default text." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dr. Jen · Dental professionals" },
    { "type": "text", "id": "title", "label": "Title", "default": "Reset your password" },
    { "type": "text", "id": "text", "label": "Text", "default": "Choose a new password for your account." },
    { "type": "text", "id": "password_label", "label": "Password label", "default": "New password" },
    { "type": "text", "id": "confirm_label", "label": "Confirm password label", "default": "Confirm new password" },
    { "type": "text", "id": "submit_label", "label": "Button", "default": "Reset password" }
  ]
}
{% endschema %}
