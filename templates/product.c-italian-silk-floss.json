    "c_faq_tKzPEm": {
      "type": "c-faq",
      "blocks": {
        "faq_item_QJXAEL": {
          "type": "faq_item",
          "settings": {
            "question": "Is Dr. Jen's floss safe to use?",
            "answer": "<p>Dr. Jen's floss is made from 100% Italian silk, coated in avocado oil. Unlike conventional floss, which is made of synthetic plastic, ours contains no synthetic plastic and sheds no microplastics with use.</p>"
          }
        },
        "faq_item_fzMwL6": {
          "type": "faq_item",
          "settings": {
            "question": "Are the ingredients natural?",
            "answer": "<p>Dr. Jen's floss is made with just two ingredients: Italian silk and avocado oil. No synthetic waxes, no synthetic coatings, no fillers.</p>"
          }
        },
        "faq_item_kjUmbB": {
          "type": "faq_item",
          "settings": {
            "question": "What exactly is in the coating?",
            "answer": "<p>The floss is coated in avocado oil instead of synthetic waxes or plastic-based coatings. This supports a smooth glide without introducing microplastics into your routine.</p><p><strong>How it works:</strong></p><ul><li>Silk fiber cleans between teeth through gentle friction</li><li>Avocado oil coating supports smooth glide</li><li>No synthetic material sheds into your mouth with use</li></ul>"
          }
        },
        "faq_item_DtKWNM": {
          "type": "faq_item",
          "settings": {
            "question": "Why does Dr. Jen's cost more than other floss?",
            "answer": "<p>Dr. Jen replaced synthetic plastic with 100% Italian silk, coated in avocado oil instead of synthetic waxes.</p><ul><li>No plastic in the strand.</li><li>No microplastics shed with use.</li><li>No shortcuts. Just a formula built with the same care she wanted for her own child.</li></ul><p>That's why our floss costs more. Because it was never created to be the cheapest. It was created to be the cleanest, born from a mother's refusal to settle for what was already on the shelf.<br/><br/></p>"
          }
        },
        "faq_item_JF47ti": {
          "type": "faq_item",
          "settings": {
            "question": "How do I use Dr. Jen's floss?",
            "answer": "<p>Break off about 18 inches, guide it gently between teeth using a sawing motion, then curve it around each tooth in a C-shape and slide up and down, just below the gumline.<br/><br/>As always, discuss any specific questions or concerns with your dental team, who knows your personal oral health best.</p>"
          }
        }
      },
