    "c_case_study_aPqVyY": {
      "type": "c-case-study",
      "blocks": {
        "image_group_7PhJXC": {
          "type": "image_group",
          "settings": {
            "text_above": "In Sept 2025, while she was away at college, a dental office took a full mouth series of radiographs. The dentist diagnosed 12 cavities. \nThe patients wanted to try remineralization therapy first and began to use Dr. Jen's Super Paste twice a day. ",
            "label": "",
            "image_desk": "shopify://shop_images/Group_1000007170_1.png",
            "width_desk": 80,
            "image_mob": "shopify://shop_images/Frame_1618873396.png",
            "width_mob": 100
          }
        },
        "image_group_GU88nB": {
          "type": "image_group",
          "settings": {
            "text_above": "In Dec 2025... just 3 and 1/2 months after beginning this new protocol…Visual radiographic assessment and AI-driven caries analysis confirmed that all lesions were stable or improving, with the exception of tooth #19.",
            "label": "",
            "image_desk": "shopify://shop_images/Frame_2085665977_1.png",
            "width_desk": 100,
            "image_mob": "shopify://shop_images/Frame_2085665977.png",
            "width_mob": 100
          }
        }
      },
      "block_order": [
        "image_group_7PhJXC",
        "image_group_GU88nB"
      ],
      "name": "C - Case Study",
      "settings": {
        "heading": "Case Study",
        "text_1": "After 9 years of orthodontics, this patient had multiple interproximal lesions despite good homecare, Prevident 5000, a low pH diet, and flossing daily.",
        "text_2": "She continued to use the Prevident 5000, began MI Paste, and had regular applications of silver diamine fluoride. The lesions remained stable for 5 years. However, when she went off to college, all these protective measures diminished and the carries progressed.",
        "text_3": "",
        "bg_color": "#f7f7f7",
        "heading_color": "#002c41",
        "text_color": "#000000",
        "label_bg_color": "#333333",
        "label_text_color": "#ffffff",
        "img_radius": 0,
        "heading_size_mob": 32,
